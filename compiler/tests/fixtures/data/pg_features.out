CREATE TABLE "docs" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "title" text NOT NULL,
    "meta" jsonb,
    "lines" jsonb NOT NULL,
    "extra" jsonb,
    "labels" text[],
    "review" text,
    "mood" mood,
    "ref" uuid NOT NULL,
    "alt" uuid,
    "ttl" interval NOT NULL,
    "grace" interval,
    "price" numeric NOT NULL,
    "tip" numeric
)
