// The PostgreSQL-specific features of data against a real server
// (compiler/tests/data.rs runs it when PGTEST_DSN is set, after a schema
// reset, and compares the output with pg_features.out): jsonb documents
// (paths, @>, ?, ?|, ?&, @?, @@, jsonb_set), arrays (@>, &&, ANY,
// cardinality), ILIKE, regex, full-text search with ts_rank, DISTINCT ON,
// row locks, RETURNING and ON CONFLICT, CTEs, window functions, set
// operations, subqueries, outer joins, LISTEN/NOTIFY and the GIN DDL.
namespace pgfeatures

import data
import encoding.json
import io
import os
import uuid

struct Limits {
    Seats int
    Pro   bool
}

struct Meta {
    Plan   string
    Age    int
    Limits Limits
}

struct User {
    Id   int
    Name string
    @data.jsonb @data.index(using: "gin") Meta Meta
    @data.index(using: "gin") Tags []string
    Scores []int
    Bio  string
}

struct Order {
    Id     int
    UserId int
    Total  float
}

struct Category {
    @data.key(generated: false) Id int
    Name     string
    ParentId int
}

struct Person {
    Name string
}

struct DocMeta {
    Owner   *Person
    Expires *time.Time
    Tags    []string
    Plan    string
}

struct Line {
    Sku   string
    Qty   int
    Owner *Person
}

enum Status {
    Draft,
    Active,
    Closed,
}

// nullable and compound columns
struct Doc {
    Id    int
    Title string
    @data.jsonb Meta *DocMeta
    @data.jsonb Lines []Line
    @data.jsonb Extra *[]Line
    Labels *[]string
    Review *Status
    @data.column(type: "mood") Mood *Status
    @data.uuidColumn Ref string
    @data.uuidColumn Alt *string
    Ttl   time.Duration
    Grace *time.Duration
    Price math.big.Decimal
    Tip   *math.big.Decimal
}

struct Shop {
    data.Context
    Users      data.Set<User>
    Orders     data.Set<Order>
    Categories data.Set<Category>
    Docs       data.Set<Doc>
}

async func docs(q data.Query<Doc>) string! {
    var out []string = []
    for d in await q.OrderBy((d) => d.Id).ToList()? {
        out = append(out, d.Title)
    }
    return strings.Join(out, ",")
}

func at(t time.Time) *time.Time {
    var x = t
    return &x
}

func ptr<T>(v T) *T {
    var x = v
    return &x
}

async func names(q data.Query<User>) string! {
    var out []string = []
    for u in await q.OrderBy((u) => u.Id).ToList()? {
        out = append(out, u.Name)
    }
    return strings.Join(out, ",")
}

async func main() void! {
    var ctx = data.Open<Shop>(data.Provider.Postgres, os.Getenv("PGTEST_DSN"))?
    _ = await ctx.ExecuteSql("DROP TABLE IF EXISTS users, orders, categories, docs CASCADE", [])?
    _ = await ctx.ExecuteSql("DROP TYPE IF EXISTS mood", [])?
    _ = await ctx.ExecuteSql("CREATE TYPE mood AS ENUM ('Draft', 'Active', 'Closed')", [])?
    for s in ctx.CreateScript() {
        if strings.Contains(s, "gin") && !strings.Contains(s, "\"docs\"") {
            println(s)
        }
    }
    await ctx.EnsureCreated()?
    var ann = new User{Name: "Ann", Meta: Meta{Plan: "pro", Age: 34, Limits: Limits{Seats: 5, Pro: true}}, Tags: ["admin", "dev"], Scores: [3, 9], Bio: "Writes compilers and databases"}
    var bob = new User{Name: "Bob", Meta: Meta{Plan: "free", Age: 17, Limits: Limits{Seats: 1, Pro: false}}, Tags: ["dev"], Scores: [], Bio: "Plays jazz guitar"}
    var cid = new User{Name: "cid_%", Meta: Meta{Plan: "free", Age: 51, Limits: Limits{Seats: 2, Pro: false}}, Tags: [], Scores: [1], Bio: "Database administrator"}
    ctx.Users.AddRange([ann, bob, cid])
    _ = await ctx.SaveChanges()?
    ctx.Orders.AddRange([new Order{UserId: ann.Id, Total: 120.0}, new Order{UserId: ann.Id, Total: 30.0}, new Order{UserId: bob.Id, Total: 60.0}, new Order{UserId: 99, Total: 5.0}])
    _ = await ctx.SaveChanges()?

    // jsonb
    var back = await ctx.Users.AsNoTracking().Where((u) => u.Id == ann.Id).Single()?
    println("doc", back.Meta.Plan, back.Meta.Age, back.Meta.Limits.Seats, back.Tags, back.Scores)
    println("path", await names(ctx.Users.Where((u) => u.Meta.Plan == "pro"))?)
    println("int path", await names(ctx.Users.Where((u) => u.Meta.Age >= 18))?)
    println("nested", await names(ctx.Users.Where((u) => u.Meta.Limits.Seats > 1 && !u.Meta.Limits.Pro))?)
    println(ctx.Users.Where((u) => u.Meta.Limits.Seats > 1).ToSql())
    var filter = json.Format(Limits{Seats: 5, Pro: true})
    println("@>", await names(ctx.Users.Where((u) => data.JsonContains(u.Meta, "{\"Plan\":\"pro\"}") || data.JsonContainedBy(u.Meta, "{}")))?)
    println("?", await names(ctx.Users.Where((u) => data.JsonHasKey(u.Meta, "Limits")))?, filter != "")
    println("?|", await names(ctx.Users.Where((u) => data.JsonHasAnyKey(u.Meta, ["x", "Plan"])))?)
    println("?&", await names(ctx.Users.Where((u) => data.JsonHasAllKeys(u.Meta, ["Plan", "y"])))?)
    println("@?", await names(ctx.Users.Where((u) => data.JsonPathExists(u.Meta, "$.Limits ? (@.Seats > 1)")))?)
    println("@@", await names(ctx.Users.Where((u) => data.JsonPathMatch(u.Meta, "$.Age > 40")))?)
    var n = await ctx.Users.Where((u) => u.Id == bob.Id).ExecuteUpdate((s) => s.SetWith((u) => u.Meta, (u) => data.JsonSet(u.Meta, ["Plan"], json.Format("team"))))?
    println("jsonb_set", n, await names(ctx.Users.Where((u) => u.Meta.Plan == "team"))?)

    // arrays
    println("arr @>", await names(ctx.Users.Where((u) => data.ArrayContains(u.Tags, ["dev"])))?)
    println("arr &&", await names(ctx.Users.Where((u) => data.ArrayOverlaps(u.Tags, ["admin", "ops"])))?)
    println("any", await names(ctx.Users.Where((u) => "dev" == data.AnyOf(u.Tags)))?)
    println("int any", await names(ctx.Users.Where((u) => 9 == data.AnyOf(u.Scores) || data.ArrayContainedBy(u.Scores, [1, 2])))?)
    println("cardinality", await ctx.Users.OrderBy((u) => u.Id).Select((u) => (u.Name, len(u.Tags))).ToList()?)

    // text
    println("ilike", await names(ctx.Users.Where((u) => data.ILike(u.Name, "a%")))?)
    println("like escaped", await names(ctx.Users.Where((u) => data.Like(u.Name, data.EscapeLike("cid_%"))))?)
    println("regex", await names(ctx.Users.Where((u) => data.Regex(u.Name, "^[AB]") && !data.IRegex(u.Name, "^b")))?)
    var words = "database"
    var fts = ctx.Users.Where((u) => data.Matches(data.ToTsVector("english", u.Bio), data.PlainToTsQuery("english", words))).OrderByDescending((u) => data.TsRank(data.ToTsVector("english", u.Bio), data.WebSearchToTsQuery("english", words))).Select((u) => u.Name)
    println("fts", await fts.ToList()?)

    // DISTINCT ON, locks
    var firsts = ctx.Orders.AsQuery().DistinctOn((o) => o.UserId).OrderBy((o) => (o.UserId, o.Total)).Select((o) => (o.UserId, o.Total))
    println("distinct on", len(await firsts.ToList()?))
    await ctx.Transaction(async () => {
        var locked = await ctx.Orders.Where((o) => o.Total > 50.0).ForUpdate().SkipLocked().ToList()?
        println("for update skip locked", len(locked))
        var shared = await ctx.Orders.Where((o) => o.Total > 50.0).ForShare().NoWait().Count()?
        println("for share nowait", shared)
    })?

    // RETURNING, ON CONFLICT
    var raised = await ctx.Orders.Where((o) => o.Total < 50.0).ExecuteUpdateReturning((s) => s.SetWith((o) => o.Total, (o) => o.Total * 2.0), (o) => o.Total)?
    println("update returning", raised)
    var gone = await ctx.Orders.Where((o) => o.UserId == 99).ExecuteDeleteReturning((o) => (o.Id > 0, o.Total))?
    println("delete returning", gone)
    var dup = new Category{Id: 1, Name: "root", ParentId: 0}
    ctx.Categories.Add(dup)
    _ = await ctx.SaveChanges()?
    ctx.Categories.InsertOrIgnore(new Category{Id: 1, Name: "ignored", ParentId: 0}, (c) => c.Id)
    ctx.Categories.UpsertWith(new Category{Id: 2, Name: "books", ParentId: 1}, (c) => c.Id, (c) => c.Name)
    _ = await ctx.SaveChanges()?
    ctx.Categories.UpsertWith(new Category{Id: 2, Name: "Books", ParentId: 7}, (c) => c.Id, (c) => c.Name)
    ctx.Categories.AddRange([new Category{Id: 3, Name: "novels", ParentId: 2}, new Category{Id: 4, Name: "jazz", ParentId: 9}])
    _ = await ctx.SaveChanges()?
    println("upsert", await ctx.Categories.AsNoTracking().OrderBy((c) => c.Id).Select((c) => (c.Name, c.ParentId)).ToList()?)

    // CTE, window, set operations, subqueries, joins
    var tree = ctx.Categories.Where((c) => c.Id == 1).Recursive((child, parent) => child.ParentId == parent.Id).OrderBy((c) => c.Id).Select((c) => c.Name)
    println("recursive", await tree.ToList()?)
    println("cte", await ctx.Categories.Where((c) => c.ParentId == 0).AsCte("roots").Count()?)
    var ranks = ctx.Orders.OrderBy((o) => o.Id).Select((o) => (o.UserId, data.RowNumber(data.Over().PartitionBy(o.UserId).OrderByDescending(o.Total)), data.SumOver(o.Total, data.Over().OrderBy(o.Id)), data.Lag(o.Total, data.Over().OrderBy(o.Id)) == nil))
    println("window", await ranks.ToList()?)
    var adults = ctx.Users.Where((u) => u.Meta.Age >= 18)
    println("union", await names(adults.Union(ctx.Users.Where((u) => u.Name == "Bob")))?, "intersect", await names(adults.Intersect(ctx.Users.Where((u) => u.Name == "Ann")))?, "except", await names(adults.Except(ctx.Users.Where((u) => u.Name == "Ann")))?)
    var orders = ctx.Orders.AsQuery()
    println("exists", await names(ctx.Users.Where((u) => data.Exists(data.Where(orders, (o) => o.UserId == u.Id && o.Total > 100.0))))?)
    println("in", await names(ctx.Users.Where((u) => data.In(u.Id, ctx.Orders.Select((o) => o.UserId))))?)
    println("scalar", await ctx.Users.OrderBy((u) => u.Id).Select((u) => (u.Name, data.CountOf(data.Where(orders, (o) => o.UserId == u.Id)), data.SumOf(data.Where(orders, (o) => o.UserId == u.Id), (o) => o.Total))).ToList()?)
    var full = ctx.Users.FullJoin(ctx.Orders, (u) => u.Id, (o) => o.UserId, (u, o) => (data.Nullable(u.Name), data.Nullable(o.Total)))
    println("full join", len(await full.ToList()?))
    var right = ctx.Users.RightJoin(ctx.Orders, (u) => u.Id, (o) => o.UserId, (u, o) => u == nil)
    println("right join", await right.ToList()?)
    println("raw", await ctx.Users.Where((u) => data.Sql2<bool>("? ~* ?", u.Name, "^ann$")).Select((u) => data.Sql1<string>("upper(?)", u.Name)).ToList()?)

    // LISTEN/NOTIFY
    var sub = await ctx.Listen("events")?
    await ctx.Notify("events", "hello")?
    await ctx.Notify("events", "world")?
    println("notify", await sub.C.Recv()?, await sub.C.Recv()?)
    sub.Close()

    // nullable and compound columns
    for s in ctx.CreateScript() {
        if strings.Contains(s, "\"docs\"") {
            println(s)
        }
    }
    var exp = time.Date(2027, 1, 2, 3, 4, 5, 0, time.UTC())
    var root = "6f1c0b52-3c1e-4a6e-9a43-2d4f0c7e5b10"
    var da = new Doc{Title: "a", Meta: new DocMeta{Owner: new Person{Name: "Ann"}, Expires: at(exp), Tags: ["x"], Plan: "pro"}, Lines: [Line{Sku: "pen", Qty: 3, Owner: new Person{Name: "Ann"}}, Line{Sku: "ink", Qty: 1, Owner: nil}], Extra: ptr<[]Line>([]), Labels: ptr<[]string>(["x", "y"]), Review: ptr(Status.Closed), Mood: ptr(Status.Active), Ref: root, Alt: nil, Ttl: time.Seconds(90), Grace: ptr(time.Milliseconds(1500)), Price: math.big.NewDecimal(1250, 2), Tip: nil}
    var db = new Doc{Title: "b", Meta: new DocMeta{Owner: nil, Expires: nil, Tags: nil, Plan: "free"}, Lines: [Line{Sku: "cup", Qty: 2, Owner: nil}], Extra: nil, Labels: ptr<[]string>([]), Review: nil, Mood: nil, Ref: "0b6e2a64-9d55-4c3a-8f0e-7a1b2c3d4e5f", Alt: ptr(root), Ttl: time.Hours(26) + time.Seconds(1), Grace: nil, Price: math.big.NewDecimal(1, 2), Tip: ptr(math.big.NewDecimal(25075, 2))}
    var dc = new Doc{Title: "c", Meta: nil, Lines: nil, Extra: ptr<[]Line>([Line{Sku: "mug", Qty: 5, Owner: nil}]), Labels: nil, Review: ptr(Status.Active), Mood: ptr(Status.Draft), Ref: uuid.New(), Alt: ptr(root), Ttl: time.Seconds(0) - time.Milliseconds(250), Grace: ptr(time.Seconds(0)), Price: math.big.NewDecimal(100, 0), Tip: nil}
    ctx.Docs.AddRange([da, db, dc])
    _ = await ctx.SaveChanges()?
    println("doc null", await ctx.Docs.OrderBy((d) => d.Id).Select((d) => (d.Title, data.Sql1<string>("coalesce(?::text, 'SQL NULL')", d.Meta))).ToList()?)
    var back2 = await ctx.Docs.AsNoTracking().OrderBy((d) => d.Id).ToList()?
    println("doc back", back2[0].Meta.Owner.Name, back2[0].Meta.Expires.Equal(exp), back2[1].Meta.Owner == nil, back2[1].Meta.Expires == nil, back2[2].Meta == nil)
    println("doc == nil", await docs(ctx.Docs.Where((d) => d.Meta == nil))?, "owner == nil", await docs(ctx.Docs.Where((d) => d.Meta != nil && d.Meta.Owner == nil))?)
    println("owner.name", await docs(ctx.Docs.Where((d) => d.Meta.Owner.Name == "Ann"))?, "plan != pro", await docs(ctx.Docs.Where((d) => d.Meta.Plan != "pro"))?)
    println("expires", await docs(ctx.Docs.Where((d) => d.Meta.Expires != nil && *d.Meta.Expires > exp.AddDate(0, 0, -1)))?)
    dc.Meta = new DocMeta{Owner: new Person{Name: "Cid"}, Expires: nil, Tags: [], Plan: "team"}
    db.Meta = nil
    _ = await ctx.SaveChanges()?
    println("doc swap", await docs(ctx.Docs.Where((d) => d.Meta == nil))?, await docs(ctx.Docs.Where((d) => d.Meta.Owner != nil))?)

    // arrays of documents
    println("lines raw", await ctx.Docs.OrderBy((d) => d.Id).Select((d) => (d.Title, data.Sql1<string>("?::text", d.Lines), data.Sql1<string>("coalesce(?::text, 'SQL NULL')", d.Extra))).ToList()?)
    println("lines any", await docs(ctx.Docs.Where((d) => data.Any(d.Lines, (l) => l.Qty > 2)))?, "all", await docs(ctx.Docs.Where((d) => data.All(d.Lines, (l) => l.Qty >= 2)))?, "owner", await docs(ctx.Docs.Where((d) => data.Any(d.Lines, (l) => l.Owner != nil && l.Owner.Name == "Ann")))?)
    for r in await ctx.Docs.OrderBy((d) => d.Id).Select((d) => (d.Title, len(d.Lines), data.Count(d.Lines, (l) => l.Qty > 0), data.Sum(d.Lines, (l) => l.Qty), data.Nullable(len(*d.Extra)))).ToList()? {
        var n = "NULL"
        if r.4 != nil {
            n = fmt.Format("{0}", *r.4)
        }
        println("lines len", r.0, r.1, r.2, r.3, n)
    }
    println("nested len", await docs(ctx.Docs.Where((d) => len(d.Meta.Tags) > 0))?, "extra all", await docs(ctx.Docs.Where((d) => data.All(*d.Extra, (l) => l.Qty > 4)))?)
    // nullable arrays, enums, uuid, interval, numeric
    println("labels", await docs(ctx.Docs.Where((d) => d.Labels == nil))?, await docs(ctx.Docs.Where((d) => d.Labels != nil && len(*d.Labels) == 0))?, await docs(ctx.Docs.Where((d) => data.ArrayContains(*d.Labels, ["y"])))?)
    println("enum", await docs(ctx.Docs.Where((d) => d.Review == nil))?, await docs(ctx.Docs.Where((d) => *d.Review == Status.Active))?, "pg enum", await docs(ctx.Docs.Where((d) => *d.Mood == Status.Draft || d.Mood == nil))?)
    println("uuid", await docs(ctx.Docs.Where((d) => d.Ref == root || *d.Alt == root))?, await docs(ctx.Docs.Where((d) => d.Alt == nil))?, len(await ctx.Docs.Where((d) => d.Ref == "0b6e2a64-9d55-4c3a-8f0e-7a1b2c3d4e5f").ToList()?))
    var limit = time.Minutes(1)
    println("interval", await docs(ctx.Docs.Where((d) => d.Ttl > limit))?, await docs(ctx.Docs.Where((d) => d.Grace == nil))?, await docs(ctx.Docs.Where((d) => *d.Grace < limit))?)
    println("numeric", await docs(ctx.Docs.Where((d) => d.Tip == nil))?, await ctx.Docs.Where((d) => d.Price > math.big.NewDecimal(1, 0)).Count()?)
    for d in await ctx.Docs.AsNoTracking().OrderBy((d) => d.Id).ToList()? {
        var e = "nil"
        if d.Extra != nil {
            e = fmt.Format("{0}", len(*d.Extra))
        }
        var lb = "nil"
        if d.Labels != nil {
            lb = fmt.Format("{0}", *d.Labels)
        }
        var rv = "nil"
        if d.Review != nil {
            rv = fmt.Format("{0}", *d.Review)
        }
        var md = "nil"
        if d.Mood != nil {
            md = fmt.Format("{0}", *d.Mood)
        }
        var gr = "nil"
        if d.Grace != nil {
            gr = fmt.Format("{0}", *d.Grace)
        }
        var tp = "nil"
        if d.Tip != nil {
            tp = d.Tip.String()
        }
        println("row", d.Title, len(d.Lines), e, lb, rv, md, uuid.IsValid(d.Ref), d.Alt == nil, d.Ttl, gr, d.Price.String(), tp)
    }
    da.Extra = nil
    da.Labels = nil
    da.Review = nil
    da.Grace = nil
    db.Lines[0].Qty = 8
    db.Tip = nil
    dc.Mood = ptr(Status.Closed)
    dc.Ttl = time.Seconds(3)
    println("changed", ctx.Entry(da).ChangedColumns(), ctx.Entry(db).ChangedColumns(), ctx.Entry(dc).ChangedColumns())
    _ = await ctx.SaveChanges()?
    println("after", await docs(ctx.Docs.Where((d) => d.Extra == nil && d.Labels == nil && d.Review == nil && d.Grace == nil))?, await docs(ctx.Docs.Where((d) => data.Any(d.Lines, (l) => l.Qty == 8)))?, await docs(ctx.Docs.Where((d) => *d.Mood == Status.Closed && d.Ttl == time.Seconds(3)))?)
}
