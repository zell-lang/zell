// web: the web framework of docs/FRAMEWORK.md section 2 (zell.web;
// a stdlib namespace until the package registry exists). Files:
//
//   web_app.zl      attributes, App, Context, pipeline, routing, results,
//                   Problem Details, the in-memory test client
//   web_di.zl       the DI container (Services, Scope, lifetimes)
//   web_bind.zl     parameter binding, conversions, @validate
//   web_mw.zl       built-in middleware (logging, CORS, rate limit, auth...)
//   web_openapi.zl  the OpenAPI 3.1 document and the /swagger page
//   web_jwt.zl      web.auth.jwt (HS256, RS256, ES256)
//   web_config.zl   web.config (Bind<T>, Options<T> with reload)
//   web_schema.zl   encoding.json.Schema<T>
//
// The route table of controllers and minimal-API handlers is generated by
// the compiler (sema/web.rs): `app.MapController<C>()`, `app.MapGet(path,
// handler)` and `app.Services.AddSingleton<T>()` are expanded at compile
// time into calls of the helpers below (addEndpoint, bindPath, bindQuery,
// bindBody, resolve, writeValue, ...), with every type known.
namespace web

// ---- attributes ---------------------------------------------------------------

// @route("/api/users") on a controller struct: the prefix of its routes.
@attribute(targets: [reflect.Target.Struct])
struct route {
    path string
}

// @get("{id}"), @post(""), ...: an action method and its route (relative
// to the controller's @route; a leading "/" makes it absolute).
@attribute(targets: [reflect.Target.Func])
struct get {
    path string = ""
}

@attribute(targets: [reflect.Target.Func])
struct post {
    path string = ""
}

@attribute(targets: [reflect.Target.Func])
struct put {
    path string = ""
}

@attribute(targets: [reflect.Target.Func])
struct delete {
    path string = ""
}

@attribute(targets: [reflect.Target.Func])
struct patch {
    path string = ""
}

// @authorize on a controller or action: an authenticated user is required
// (401 otherwise); with roles, one of them (403 otherwise).
@attribute(targets: [reflect.Target.Struct, reflect.Target.Func])
struct authorize {
    roles []string = []
}

// @allowAnonymous on an action of an @authorize controller.
@attribute(targets: [reflect.Target.Func])
struct allowAnonymous {
}

// Parameter sources: @query, @header, @form (optionally renamed), @body
// (JSON), @fromServices (DI). Without one, a parameter named like a route
// segment {name} comes from the path, *web.Context is the request
// context, pointers and interfaces are services, structs are the body and
// scalars come from the query string.
@attribute(targets: [reflect.Target.Param])
struct query {
    name string = ""
}

@attribute(targets: [reflect.Target.Param])
struct header {
    name string = ""
}

@attribute(targets: [reflect.Target.Param])
struct form {
    name string = ""
}

@attribute(targets: [reflect.Target.Param])
struct body {
}

@attribute(targets: [reflect.Target.Param])
struct fromServices {
}

// @summary("...") on an action: the OpenAPI summary.
@attribute(targets: [reflect.Target.Func])
struct summary {
    text string
}

// @inject on a service field: resolved from the container when the
// service has no static New. Controllers inject every pointer and
// interface field; @inject(skip: true) leaves one alone.
@attribute(targets: [reflect.Target.Field])
struct inject {
    skip bool = false
}

// ---- the application ------------------------------------------------------------

// Options of NewAppWith.
struct AppOptions {
    // "development", "staging", "production" ("" = $ZELL_ENV, else
    // "production").
    Environment string
    // OpenAPI info.
    Title string
    Version string
    // Logger of the framework (nil: log.Global()).
    Logger log.Logger
}

// A middleware: does something around `await next.Run(c)?`.
// Write it as `async func(c *web.Context, next *web.Next) void! { ... }`.
struct Next {
    app *App
    i int

    // Runs the rest of the pipeline (the next middleware, finally the
    // endpoint).
    func Run(c *Context) Task<void!> {
        return runPipeline(this.app, this.i, c)
    }
}

// App is a web application: services, middleware and endpoints. It is an
// http.Handler, so it can be served by any net.http.Server.
struct App {
    Services *Services
    Environment string
    Title string
    Version string
    Logger log.Logger
    endpoints []*Endpoint
    mws []func(*Context, *Next) Task<void!>
    httpMws []func(net.http.Handler) net.http.Handler
    // (owner, service key) pairs checked by Build
    requires []string
    owners []string
    built bool
    buildErr string
    handler net.http.Handler
    hasHandler bool
    server *net.http.Server
    listening bool
    checks []healthCheck

    // IsDevelopment reports whether Environment is "development".
    func IsDevelopment() bool {
        return this.Environment == "development"
    }

    func logger() log.Logger {
        if this.Logger != nil {
            return this.Logger
        }
        return log.Global()
    }

    // Adds a middleware (outermost first).
    func Use(mw func(*Context, *Next) Task<void!>) *App {
        this.mws = append(this.mws, mw)
        return this
    }

    // Adds a net.http middleware (`http.Gzip(6)`, `http.Recover()`)
    // around the whole application (outermost first).
    func UseHttp(mw func(net.http.Handler) net.http.Handler) *App {
        this.httpMws = append(this.httpMws, mw)
        this.hasHandler = false
        return this
    }

    // ---- built-in middleware (web_mw.zl) ----

    // One log event per request through the app's logger (log):
    // "HTTP {RequestMethod} {RequestPath} responded {StatusCode} in
    // {Elapsed} ms" (Information; Error for 5xx), with property Route.
    func UseLogging() *App {
        var l = this.logger()
        return this.Use(func(c *Context, n *Next) Task<void!> {
            return logRequest(l, c, n)
        })
    }

    // Turns errors of later middleware into 500 Problem Details (endpoint
    // errors already are).
    func UseRecover() *App {
        return this.Use(recoverRequest)
    }

    // CORS (preflights and Access-Control-* headers) via net.http.CORS.
    func UseCors(o net.http.CORSOptions) *App {
        return this.UseHttp(net.http.CORS(o))
    }

    // gzip for compressible responses of 1 KB or more (net.http.Gzip).
    func UseGzip() *App {
        return this.UseHttp(net.http.Gzip(0))
    }

    // Serves the files of dir under the URL prefix ("/static"), with
    // ranges and ETags (http.ServeFile); other paths go on.
    func UseStaticFiles(prefix string, dir string) *App {
        var p = strings.TrimSuffix(prefix, "/")
        if p == "" {
            p = "/"
        }
        var d = strings.TrimSuffix(dir, "/")
        return this.Use(func(c *Context, n *Next) Task<void!> {
            return staticFiles(p, d, c, n)
        })
    }

    // A token bucket per client IP: 429 Problem Details with Retry-After
    // when it is empty.
    func UseRateLimit(o RateLimitOptions) *App {
        var l = new limiter{o: o, buckets: map[string]*bucket{}}
        return this.Use(func(c *Context, n *Next) Task<void!> {
            return rateLimit(l, c, n)
        })
    }

    // The request id: the incoming header (X-Request-Id) or a new one, on
    // the response, in Context.RequestId and as the log property
    // RequestId.
    func UseRequestId(o RequestIdOptions) *App {
        return this.Use(func(c *Context, n *Next) Task<void!> {
            return requestId(o, c, n)
        })
    }

    // A diag server span per request ("HTTP GET /api/users/{id}")
    // with method, route and status attributes.
    func UseTracing() *App {
        return this.Use(traceRequest)
    }

    // JWT bearer authentication: a valid token sets Context.User, an
    // invalid one is answered with 401; requests without a token go on
    // anonymously (@authorize endpoints then answer 401).
    func UseAuth(o AuthOptions) *App {
        return this.Use(func(c *Context, n *Next) Task<void!> {
            return authenticate(o, c, n)
        })
    }

    // 413 Problem Details for request bodies over n bytes.
    func UseBodyLimit(n int) *App {
        return this.Use(func(c *Context, next *Next) Task<void!> {
            return bodyLimit(n, c, next)
        })
    }

    // Cancels requests that take longer than ms and answers 503
    // (net.http.TimeoutHandler around the application).
    func UseTimeout(ms int) *App {
        return this.UseHttp(func(h net.http.Handler) net.http.Handler {
            return net.http.TimeoutHandler(h, ms, "503 Service Unavailable: the request timed out\n")
        })
    }

    // A health check for MapHealthChecks (an error means unhealthy).
    func AddHealthCheck(name string, check func() Task<void!>) *App {
        this.checks = append(this.checks, healthCheck{name: name, check: check})
        return this
    }

    // GET path runs the health checks: 200 {"status":"Healthy",...} or
    // 503 "Unhealthy" with each failure's description.
    func MapHealthChecks(path string) *Endpoint {
        return this.addEndpoint("GET", path, "health", "Health", func(c *Context) Task<void!> {
            return runHealth(c.App.checks, c)
        })
    }

    // GET path serves the OpenAPI 3.1 document of the endpoints.
    func MapOpenApi(path string) *Endpoint {
        var e = this.addEndpoint("GET", path, "openapi", "", func(c *Context) Task<void!> {
            return serveText(c, 200, "application/json", OpenApiDocument(c.App))
        })
        e.hidden = true
        return e
    }

    // GET path serves the swagger-ui page for the document at specPath.
    func MapSwagger(path string, specPath string) *Endpoint {
        var e = this.addEndpoint("GET", path, "swagger", "", func(c *Context) Task<void!> {
            return serveText(c, 200, "text/html; charset=utf-8", SwaggerPage(c.App.Title, specPath))
        })
        e.hidden = true
        return e
    }

    // Every endpoint in registration order.
    func Endpoints() []*Endpoint {
        return this.endpoints
    }

    // Maps a handler that gets the context (no binding): the building
    // block of MapGet & co, also usable directly.
    func Map(method string, pattern string, h func(*Context) Task<void!>) *Endpoint {
        return this.addEndpoint(method, pattern, "", "", h)
    }

    func addEndpoint(method string, pattern string, name string, tag string, h func(*Context) Task<void!>) *Endpoint {
        var parts = net.http.splitPath(pattern)
        var isStatic = true
        for p in parts {
            if p == "*" || strings.HasPrefix(p, "{") {
                isStatic = false
            }
        }
        var e = new Endpoint{Method: method, Pattern: "/" + strings.Join(parts, "/"), Name: name, Tag: tag, parts: parts, isStatic: isStatic, handler: h}
        this.endpoints = append(this.endpoints, e)
        return e
    }

    // A dependency of a controller or a service, checked by Build.
    func require(owner string, key string) {
        this.owners = append(this.owners, owner)
        this.requires = append(this.requires, key)
    }

    // Checks the service registrations (every dependency of a mapped
    // controller or registered service must be registered) and creates
    // the singletons. Run, TestServer and the first request call it.
    func Build() void! {
        if this.built {
            if this.buildErr != "" {
                return error(this.buildErr)
            }
            return
        }
        this.built = true
        var missing []string = []
        for i, key in this.requires {
            if !this.Services.canResolve(key) {
                missing = append(missing, key + " (needed by " + this.owners[i] + ")")
            }
        }
        for key in this.Services.order {
            var reg = this.Services.regs[key]
            for d in reg.deps {
                if !this.Services.canResolve(d) {
                    missing = append(missing, d + " (needed by " + key + ")")
                }
            }
        }
        if len(missing) > 0 {
            this.buildErr = "web: missing service registrations: " + strings.Join(missing, ", ")
            return error(this.buildErr)
        }
        this.Services.app = this
        try this.Services.createSingletons() catch err {
            this.buildErr = err.Message()
            return error(this.buildErr)
        }
    }

    // http.Handler: serves one request through the http middleware, the
    // pipeline and the endpoint.
    func Serve(req *net.http.Request, res *net.http.Response) Task<void!> {
        if len(this.httpMws) == 0 {
            return serveApp(this, req, res)
        }
        if !this.hasHandler {
            this.handler = net.http.Chain(appCore{app: this}, this.httpMws)
            this.hasHandler = true
        }
        return this.handler.Serve(req, res)
    }

    // Starts listening on addr ("host:port", ":0" for a free port) after
    // Build; Port and URL tell where. Serve the requests with Run.
    func Listen(addr string) void! {
        this.Build()?
        var a = addr
        if strings.HasPrefix(a, ":") {
            a = "127.0.0.1" + a
        }
        this.server = new net.http.Server{Addr: a, Handler: this}
        this.server.Listen()?
        this.listening = true
    }

    // Port returns the port the app listens on after Listen (0 before).
    func Port() int {
        if this.server == nil {
            return 0
        }
        return this.server.Port()
    }

    // URL returns "http://host:port" of the listening app ("" before Listen).
    func URL() string {
        if this.server == nil {
            return ""
        }
        return this.server.URL()
    }

    // Builds, listens on addr (unless Listen was called) and serves until
    // Shutdown.
    func Run(addr string) Task<void!> {
        return runApp(this, addr)
    }

    // Stops a running server (graceful: requests in flight finish).
    func Shutdown() Task<void> {
        return shutdownApp(this)
    }
}

async func serveText(c *Context, status int, contentType string, body string) void! {
    c.Response.Status = status
    c.Response.SetHeader("Content-Type", contentType)
    c.Response.Body = body
}

async func runApp(a *App, addr string) void! {
    if !a.listening {
        a.Listen(addr)?
    }
    a.logger().Information("web: listening on {Url} ({Environment})", a.URL(), a.Environment)
    await a.server.Serve()?
}

async func shutdownApp(a *App) {
    if a.server != nil {
        await a.server.Shutdown()
    }
}

// NewApp makes an application (environment from $ZELL_ENV).
func NewApp() *App {
    return NewAppWith(AppOptions{})
}

// NewAppWith makes an application with explicit options (environment, configuration).
func NewAppWith(o AppOptions) *App {
    var env = o.Environment
    if env == "" {
        env = os.Getenv("ZELL_ENV")
    }
    if env == "" {
        env = "production"
    }
    var title = o.Title
    if title == "" {
        title = "Zell Web API"
    }
    var version = o.Version
    if version == "" {
        version = "1.0.0"
    }
    var s = newServices()
    return new App{Services: s, Environment: env, Title: title, Version: version, Logger: o.Logger}
}

// The innermost handler of the http middleware chain.
struct appCore {
    app weak *App

    func Serve(req *net.http.Request, res *net.http.Response) Task<void!> {
        var a = this.app
        if a == nil {
            return net.http.plainStatus(res, 503)
        }
        return serveApp(a, req, res)
    }
}

async func serveApp(a *App, req *net.http.Request, res *net.http.Response) void! {
    var c = new Context{Request: req, Response: res, App: a, Items: map[string]any{}}
    try a.Build() catch err {
        writeError(c, err)
        return
    }
    c.Scope = a.Services.newScope()
    await withContext(c, func() Task<void!> {
        return runPipeline(a, 0, c)
    })?
}

// Runs f with c as the current request context (web.Current, Resolve).
func withContext(c *Context, f func() Task<void!>) Task<void!> {
    var tc = task.CurrentContext()
    var fr = new task.ctxFrame{key: -103, val: c, next: tc.top()}
    var m = map[string]any{}
    m[""] = fr
    tc.slot = m
    return task.RunWith(tc, f)
}

// The context of the request being handled by the current task (nil
// outside a request).
func Current() *Context {
    var tc = task.CurrentContext()
    var f = tc.top()
    for f != nil {
        if f.key == -103 {
            switch f.val {
                case *Context c:
                    return c
            }
            return nil
        }
        f = f.next
    }
    return nil
}

// Resolves a service in the scope of the current request (or the root
// scope outside one).
func Resolve<T>() T! {
    var c = Current()
    if c == nil || c.Scope == nil {
        return error("web.Resolve: no current request")
    }
    return resolve<T>(c.Scope)?
}

func runPipeline(a *App, i int, c *Context) Task<void!> {
    if i < len(a.mws) {
        var n = new Next{app: a, i: i + 1}
        return a.mws[i](c, n)
    }
    return routeRequest(a, c)
}

async func routeRequest(a *App, c *Context) void! {
    var req = c.Request
    var parts []string
    var split = false
    var allowed = ""
    for e in a.endpoints {
        var params map[string]string
        if e.isStatic {
            if e.Pattern != req.Path && e.Pattern != strings.TrimSuffix(req.Path, "/") {
                continue
            }
        } else {
            if !split {
                parts = net.http.splitPath(req.Path)
                split = true
            }
            params = net.http.matchRoute(e.parts, parts)
            if params == nil {
                continue
            }
        }
        if e.Method != req.Method && e.Method != "*" && !(e.Method == "GET" && req.Method == "HEAD") {
            if !net.http.rtHasToken(allowed, e.Method) {
                if allowed != "" {
                    allowed += ", "
                }
                allowed += e.Method
            }
            continue
        }
        if params != nil {
            req.Params = params
        }
        c.Endpoint = e
        if !authorized(c, e) {
            return
        }
        try await e.handler(c) catch err {
            writeError(c, err)
        }
        return
    }
    if allowed != "" {
        c.Response.SetHeader("Allow", allowed)
        writeProblem(c, problemFor(405, ""))
        return
    }
    writeProblem(c, problemFor(404, ""))
}

// Checks the endpoint's authorization (401 / 403 Problem when it fails).
func authorized(c *Context, e *Endpoint) bool {
    if !e.RequireAuth || e.Anonymous {
        return true
    }
    if c.User == nil {
        c.Response.SetHeader("WWW-Authenticate", "Bearer")
        writeProblem(c, problemFor(401, ""))
        return false
    }
    if len(e.Roles) == 0 {
        return true
    }
    for r in e.Roles {
        if c.User.IsInRole(r) {
            return true
        }
    }
    writeProblem(c, problemFor(403, "requires one of the roles: " + strings.Join(e.Roles, ", ")))
    return false
}

// ---- endpoints ------------------------------------------------------------------

// A parameter of an endpoint (OpenAPI): In is "path", "query", "header"
// or "form"; Schema is a JSON Schema.
struct ParamDoc {
    Name string
    In string
    Required bool
    Schema string
}

// A documented response of an endpoint.
struct ResponseDoc {
    Status int
    ContentType string
    Schema string
}

// Endpoint is one route: method, pattern ("/api/users/{id}"), handler and
// the metadata of the OpenAPI document and authorization.
struct Endpoint {
    Method string
    Pattern string
    Name string
    Tag string
    Summary string
    Roles []string
    RequireAuth bool
    Anonymous bool
    Params []ParamDoc
    RequestSchema string
    RequestContentType string
    Responses []ResponseDoc
    parts []string
    isStatic bool
    // not in the OpenAPI document (/openapi.json, /swagger)
    hidden bool
    handler func(*Context) Task<void!>

    // Requires an authenticated user with one of roles (none: any user).
    func RequireAuthorization(roles []string) *Endpoint {
        this.RequireAuth = true
        this.Roles = roles
        return this
    }

    // AllowAnonymous lets unauthenticated requests reach the endpoint.
    func AllowAnonymous() *Endpoint {
        this.Anonymous = true
        return this
    }

    // WithName names the endpoint (OpenAPI operationId, link generation).
    func WithName(name string) *Endpoint {
        this.Name = name
        return this
    }

    // WithSummary sets the OpenAPI summary of the endpoint.
    func WithSummary(text string) *Endpoint {
        this.Summary = text
        return this
    }

    // WithTag groups the endpoint under tag in the OpenAPI document.
    func WithTag(tag string) *Endpoint {
        this.Tag = tag
        return this
    }

    func param(name string, loc string, required bool, schema string) {
        this.Params = append(this.Params, ParamDoc{Name: name, In: loc, Required: required, Schema: schema})
    }

    func request(contentType string, schema string) {
        this.RequestContentType = contentType
        this.RequestSchema = schema
    }

    func response(status int, contentType string, schema string) {
        this.Responses = append(this.Responses, ResponseDoc{Status: status, ContentType: contentType, Schema: schema})
    }
}

// ---- the request context --------------------------------------------------------

// The authenticated user (Context.User, set by UseAuth).
struct Principal {
    Id string
    Name string
    Roles []string
    Claims web.auth.jwt.Claims

    // IsInRole reports whether the user has role.
    func IsInRole(role string) bool {
        for r in this.Roles {
            if r == role {
                return true
            }
        }
        return false
    }
}

// A validation or binding error of one field ("email", "items[2].qty").
struct FieldError {
    Field string
    Message string
}

// Context is one request: the http request and response, the DI scope,
// the user, the matched endpoint and per-request items.
struct Context {
    Request *net.http.Request
    Response *net.http.Response
    App *App
    Scope *Scope
    User *Principal
    RequestId string
    Endpoint *Endpoint
    Items map[string]any
    errs []FieldError

    // Method returns the request method.
    func Method() string {
        return this.Request.Method
    }

    // Path returns the request path (without the query).
    func Path() string {
        return this.Request.Path
    }

    // A route parameter ({id}).
    func Param(name string) string {
        return this.Request.Param(name)
    }

    // A query parameter (the last one if repeated, "" if absent).
    func Query(name string) string {
        var vs = queryValues(this.Request.Query, name)
        if len(vs) == 0 {
            return ""
        }
        return vs[len(vs) - 1]
    }

    // Header returns request header name ("" if absent).
    func Header(name string) string {
        return this.Request.Header(name)
    }

    // SetHeader sets response header name.
    func SetHeader(name string, value string) {
        this.Response.SetHeader(name, value)
    }

    // Status sets the response status code.
    func Status(code int) {
        this.Response.Status = code
    }

    // Text writes a text/plain response.
    func Text(status int, text string) {
        this.Response.Text(status, text)
    }

    // Html writes a text/html response.
    func Html(status int, text string) {
        this.Response.Html(status, text)
    }

    // Writes v as JSON with status.
    func JSON<T>(status int, v T) {
        this.Response.Json(status, encoding.json.Format<T>(v))
    }

    // Writes Problem Details (application/problem+json).
    func Problem(p ProblemDetails) {
        writeProblem(this, p)
    }

    // Records a binding / validation error (answered with 400 before the
    // handler runs).
    func AddError(field string, message string) {
        this.errs = append(this.errs, FieldError{Field: field, Message: message})
    }

    // Errors returns the binding and validation errors collected so far.
    func Errors() []FieldError {
        return this.errs
    }

    // A service of the request scope.
    func Resolve<T>() T! {
        return resolve<T>(this.Scope)?
    }

    // Answers 400 with the recorded errors if there are any.
    func failed() bool {
        if len(this.errs) == 0 {
            return false
        }
        writeProblem(this, ValidationProblemDetails(this.errs))
        return true
    }
}

// ---- results ----------------------------------------------------------------------

// Result<T> is what an action returns: a status, an optional value
// (written with content negotiation: JSON by default, XML or YAML when
// Accept asks for them, text/plain for strings), headers or a Problem.
struct Result<T> {
    Status int
    Value T
    HasValue bool
    Headers map[string]string
    Problem *ProblemDetails

    // WithHeader returns a copy of the result that also sets a response header.
    func WithHeader(name string, value string) Result<T> {
        var r = *this
        if r.Headers == nil {
            r.Headers = map[string]string{}
        }
        r.Headers[name] = value
        return r
    }

    func writeTo(c *Context) {
        for k, v in this.Headers {
            c.Response.SetHeader(k, v)
        }
        if this.Problem != nil {
            writeProblem(c, *this.Problem)
            return
        }
        if this.HasValue {
            writeValue<T>(c, this.Status, this.Value)
            return
        }
        c.Response.Status = this.Status
    }
}

// Ok returns 200 with v.
func Ok<T>(v T) Result<T> {
    return Result<T>{Status: 200, Value: v, HasValue: true}
}

// Created returns 201 with v.
func Created<T>(v T) Result<T> {
    return Result<T>{Status: 201, Value: v, HasValue: true}
}

// 201 with a Location header.
func CreatedAt<T>(location string, v T) Result<T> {
    var r = Result<T>{Status: 201, Value: v, HasValue: true, Headers: map[string]string{}}
    r.Headers["Location"] = location
    return r
}

// Accepted returns 202 with v.
func Accepted<T>(v T) Result<T> {
    return Result<T>{Status: 202, Value: v, HasValue: true}
}

// NoContent returns 204 without a body.
func NoContent<T>() Result<T> {
    return Result<T>{Status: 204}
}

// StatusCode returns a result with status and no body.
func StatusCode<T>(status int) Result<T> {
    return Result<T>{Status: status}
}

// NotFound returns 404 Problem Details.
func NotFound<T>() Result<T> {
    var p = problemFor(404, "")
    return Result<T>{Status: 404, Problem: &p}
}

// BadRequest returns 400 Problem Details with detail.
func BadRequest<T>(detail string) Result<T> {
    var p = problemFor(400, detail)
    return Result<T>{Status: 400, Problem: &p}
}

// Unauthorized returns 401 Problem Details.
func Unauthorized<T>() Result<T> {
    var p = problemFor(401, "")
    return Result<T>{Status: 401, Problem: &p}
}

// Forbidden returns 403 Problem Details.
func Forbidden<T>() Result<T> {
    var p = problemFor(403, "")
    return Result<T>{Status: 403, Problem: &p}
}

// Conflict returns 409 Problem Details with detail.
func Conflict<T>(detail string) Result<T> {
    var p = problemFor(409, detail)
    return Result<T>{Status: 409, Problem: &p}
}

// Problem returns Problem Details with status, title ("" for the status text) and detail.
func Problem<T>(status int, title string, detail string) Result<T> {
    var p = problemFor(status, detail)
    if title != "" {
        p.Title = title
    }
    return Result<T>{Status: status, Problem: &p}
}

// ValidationProblem returns 400 Problem Details listing the field errors.
func ValidationProblem<T>(errors []FieldError) Result<T> {
    var p = ValidationProblemDetails(errors)
    return Result<T>{Status: 400, Problem: &p}
}

// Writes v with status: strings as text/plain, other values as JSON, XML
// (Accept: application/xml) or YAML (Accept: application/yaml).
func writeValue<T>(c *Context, status int, v T) {
    if reflect.TypeOf<T>().Kind == reflect.Kind.String {
        c.Response.Text(status, v)
    } else {
        var accept = c.Request.Header("Accept")
        if strings.Contains(accept, "application/xml") || strings.Contains(accept, "text/xml") {
            c.Response.Status = status
            c.Response.SetHeader("Content-Type", "application/xml")
            c.Response.Body = encoding.xml.Format<T>(v)
        } else if strings.Contains(accept, "yaml") {
            c.Response.Status = status
            c.Response.SetHeader("Content-Type", "application/yaml")
            c.Response.Body = encoding.yaml.Format<T>(v)
        } else {
            c.Response.Json(status, encoding.json.Format<T>(v))
        }
    }
}

// The result of a void action: 204 unless the action wrote a response.
func writeVoid(c *Context) {
    if c.Response.Status == 200 && c.Response.Body == "" && len(c.Response.Headers) == 0 {
        c.Response.Status = 204
    }
}

// ---- Problem Details (RFC 9457) -----------------------------------------------------

// ProblemDetails is an RFC 9457 error body (application/problem+json).
struct ProblemDetails {
    Type string
    Title string
    Status int
    Detail string
    Instance string
    // validation errors ("errors": {"field": ["message", ...]})
    Errors []FieldError
    // development mode: errors.Trace of the failure
    Trace string

    // The application/problem+json text (members in a fixed order).
    func Json() string {
        var b = strings.Builder{}
        b.Write("{\"type\":")
        b.Write(encoding.json.Quote(this.Type))
        b.Write(",\"title\":")
        b.Write(encoding.json.Quote(this.Title))
        b.Write(",\"status\":")
        b.Write(fmt.Format("{0}", this.Status))
        if this.Detail != "" {
            b.Write(",\"detail\":")
            b.Write(encoding.json.Quote(this.Detail))
        }
        if this.Instance != "" {
            b.Write(",\"instance\":")
            b.Write(encoding.json.Quote(this.Instance))
        }
        if len(this.Errors) > 0 {
            b.Write(",\"errors\":{")
            var fields []string = []
            for e in this.Errors {
                var seen = false
                for f in fields {
                    if f == e.Field {
                        seen = true
                    }
                }
                if !seen {
                    fields = append(fields, e.Field)
                }
            }
            for i, f in fields {
                if i > 0 {
                    b.Write(",")
                }
                b.Write(encoding.json.Quote(f))
                b.Write(":[")
                var n = 0
                for e in this.Errors {
                    if e.Field == f {
                        if n > 0 {
                            b.Write(",")
                        }
                        b.Write(encoding.json.Quote(e.Message))
                        n += 1
                    }
                }
                b.Write("]")
            }
            b.Write("}")
        }
        if this.Trace != "" {
            b.Write(",\"trace\":")
            b.Write(encoding.json.Quote(this.Trace))
        }
        b.Write("}")
        return b.String()
    }
}

// The Problem Details of a status ("about:blank", the status text as the
// title).
func problemFor(status int, detail string) ProblemDetails {
    return ProblemDetails{Type: "about:blank", Title: net.http.StatusText(status), Status: status, Detail: detail}
}

// ValidationProblemDetails returns the 400 Problem Details of field errors.
func ValidationProblemDetails(errors []FieldError) ProblemDetails {
    return ProblemDetails{Type: "https://tools.ietf.org/html/rfc9110#section-15.5.1", Title: "One or more validation errors occurred.", Status: 400, Errors: errors}
}

func writeProblem(c *Context, p ProblemDetails) {
    if p.Instance == "" && c.Request != nil {
        p.Instance = c.Request.Path
    }
    c.Response.Status = p.Status
    c.Response.SetHeader("Content-Type", "application/problem+json")
    c.Response.Body = p.Json()
}

// HttpError is an error with an HTTP status: returned from a handler, it
// becomes Problem Details with that status.
struct HttpError {
    Status int
    Detail string

    // Message returns Detail (HttpError is an error).
    func Message() string {
        return this.Detail
    }
}

// An error answered with status (web.Error(404, "no user 7")).
func Error(status int, detail string) HttpError {
    return HttpError{Status: status, Detail: detail}
}

// Answers a handler error: Problem Details with its status (HttpError) or
// 500 and the message; in development mode with errors.Trace.
func writeError(c *Context, err error) {
    var status = 500
    var known = false
    switch err {
        case HttpError h:
            status = h.Status
            known = true
    }
    var dev = c.App != nil && c.App.IsDevelopment()
    // An error that is not a web.Error may carry internals (SQL, paths,
    // hosts): outside development the client gets a generic detail and
    // the message goes only to the log below.
    var detail = "internal error"
    if known || dev {
        detail = err.Message()
    }
    var p = problemFor(status, detail)
    if dev {
        p.Trace = errors.Trace(err)
    }
    c.Response.Headers = nil
    c.Response.Body = ""
    writeProblem(c, p)
    if status >= 500 {
        var l = log.Global()
        if c.App != nil {
            l = c.App.logger()
        }
        l.Error(err, "web: {RequestMethod} {RequestPath} failed: {ErrorMessage}", c.Request.Method, c.Request.Path, err.Message())
    }
}

// ---- in-memory testing --------------------------------------------------------------

// TestClient sends requests straight to an App (no sockets): see
// TestServer.
struct TestClient {
    app *App
    // Headers sent with every request.
    Headers map[string]string

    // A copy that also sends header name: value.
    func WithHeader(name string, value string) *TestClient {
        var h = map[string]string{}
        for k, v in this.Headers {
            h[k] = v
        }
        h[name] = value
        return new TestClient{app: this.app, Headers: h}
    }

    // A copy that sends "Authorization: Bearer <token>".
    func WithBearer(token string) *TestClient {
        return this.WithHeader("Authorization", "Bearer " + token)
    }

    // Send sends a request with method, path, body and headers to the app.
    func Send(method string, path string, body string, headers map[string]string) Task<*net.http.Response> {
        return sendTest(this, method, path, body, headers)
    }

    // Get sends a GET request.
    func Get(path string) Task<*net.http.Response> {
        return sendTest(this, "GET", path, "", nil)
    }

    // Delete sends a DELETE request.
    func Delete(path string) Task<*net.http.Response> {
        return sendTest(this, "DELETE", path, "", nil)
    }

    // POST/PUT/PATCH with a JSON body (Content-Type application/json).
    func Post(path string, json string) Task<*net.http.Response> {
        return sendTest(this, "POST", path, json, jsonHeaders())
    }

    // Put sends a PUT request with a JSON body.
    func Put(path string, json string) Task<*net.http.Response> {
        return sendTest(this, "PUT", path, json, jsonHeaders())
    }

    // Patch sends a PATCH request with a JSON body.
    func Patch(path string, json string) Task<*net.http.Response> {
        return sendTest(this, "PATCH", path, json, jsonHeaders())
    }

    // GET path and parse the JSON body as T (an error for a non-2xx
    // status: "GET /x: 404 Not Found").
    func GetJSON<T>(path string) Task<T!> {
        return getJSON<T>(this, path)
    }

    // POST v as JSON and parse the response as R.
    func PostJSON<T, R>(path string, v T) Task<R!> {
        return postJSON<T, R>(this, path, encoding.json.Format<T>(v))
    }
}

func jsonHeaders() map[string]string {
    var h = map[string]string{}
    h["Content-Type"] = "application/json"
    return h
}

// An in-memory test server for app (Build is called first): requests go
// straight to app.Serve through a recorder.
func TestServer(app *App) *TestClient! {
    app.Build()?
    return new TestClient{app: app, Headers: map[string]string{}}
}

async func sendTest(t *TestClient, method string, path string, body string, headers map[string]string) *net.http.Response {
    var req = net.http.test.NewRequest(method, path, body)
    for k, v in t.Headers {
        req.Headers[net.http.CanonicalHeader(k)] = v
    }
    for k, v in headers {
        req.Headers[net.http.CanonicalHeader(k)] = v
    }
    var res = await net.http.test.Serve(t.app, req)
    if res.file != "" {
        // a SendFile body: read it like the server would send it
        var text = try io.ReadFile(res.file) else ""
        var end = res.fileOff + res.fileLen
        if end > len(text) {
            end = len(text)
        }
        if res.fileOff <= end {
            res.Body = text[res.fileOff..end]
        }
        res.file = ""
    }
    return res
}

async func getJSON<T>(t *TestClient, path string) T! {
    var res = await sendTest(t, "GET", path, "", nil)
    if res.Status < 200 || res.Status > 299 {
        return error("GET " + path + ": " + fmt.Format("{0}", res.Status) + " " + net.http.StatusText(res.Status))
    }
    return encoding.json.Parse<T>(res.Body)?
}

async func postJSON<T, R>(t *TestClient, path string, body string) R! {
    var res = await sendTest(t, "POST", path, body, jsonHeaders())
    if res.Status < 200 || res.Status > 299 {
        return error("POST " + path + ": " + fmt.Format("{0}", res.Status) + " " + net.http.StatusText(res.Status))
    }
    return encoding.json.Parse<R>(res.Body)?
}
