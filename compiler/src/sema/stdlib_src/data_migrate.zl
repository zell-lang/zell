namespace data

// Migrations as code: `zell data migration add Name` writes a struct
// with @migration("<timestamp>_Name") and Up/Down methods that call the
// Migrator below; ctx.Migrate() (or `zell data update`) applies the
// pending ones in id order, each in a transaction, and records them in the
// __migrations table. The Migrator renders provider-specific DDL.

// A column of CreateTable/AddColumn/AlterColumn. Type is provider
// independent (int64, int32, int16, float, float32, bool, string, bytes,
// time, decimal, json, enum); SqlType replaces it verbatim.
struct Column {
    Name      string
    Type      string
    SqlType   string
    Nullable  bool
    Key       bool
    Auto      bool
    MaxLength int
    Default   string
}

// A foreign key of CreateTable/AddForeignKey.
struct ForeignKey {
    Name       string
    Columns    []string
    RefTable   string
    RefColumns []string
    OnDelete   string
}

// One migration of the program.
struct MigrationEntry {
    Id   string
    Up   func(*Migrator)
    Down func(*Migrator)
}

// A migration struct: Up, and optionally Down.
interface upper {
    func Up(m *Migrator)
}

interface downer {
    func Down(m *Migrator)
}

// Collects the statements of a migration for a provider.
struct Migrator {
    provider Provider
    stmts    []string

    func Provider() Provider {
        return this.provider
    }

    func pg() bool {
        return this.provider == Provider.Postgres
    }

    // The statements so far.
    func Statements() []string {
        var out []string = []
        for s in this.stmts {
            out = append(out, s)
        }
        return out
    }

    // A raw statement.
    func Sql(q string) {
        this.stmts = append(this.stmts, q)
    }

    // A statement for one provider only.
    func SqlFor(p Provider, q string) {
        if p == this.provider {
            this.stmts = append(this.stmts, q)
        }
    }

    func colType(c Column) string {
        if c.SqlType != "" {
            return c.SqlType
        }
        var t = c.Type
        if this.pg() {
            if t == "int64" {
                return "bigint"
            }
            if t == "int32" {
                return "integer"
            }
            if t == "int16" {
                return "smallint"
            }
            if t == "float" {
                return "double precision"
            }
            if t == "float32" {
                return "real"
            }
            if t == "bool" {
                return "boolean"
            }
            if t == "bytes" {
                return "bytea"
            }
            if t == "time" {
                return "timestamptz"
            }
            if t == "decimal" {
                return "numeric"
            }
            if t == "json" {
                return "jsonb"
            }
            if t == "string" && c.MaxLength > 0 {
                return "varchar(" + fmt.Format("{0}", c.MaxLength) + ")"
            }
            return "text"
        }
        if t == "int64" || t == "int32" || t == "int16" {
            return "INTEGER"
        }
        if t == "float" || t == "float32" {
            return "REAL"
        }
        if t == "bool" {
            return "BOOLEAN"
        }
        if t == "bytes" {
            return "BLOB"
        }
        if t == "time" {
            return "TIMESTAMP"
        }
        if t == "string" && c.MaxLength > 0 {
            return "VARCHAR(" + fmt.Format("{0}", c.MaxLength) + ")"
        }
        return "TEXT"
    }

    func defaultSql(d string) string {
        if this.pg() {
            return d
        }
        var l = strings.ToLower(d)
        if l == "now()" || l == "current_timestamp" || l == "localtimestamp" || l == "now() at time zone 'utc'" {
            return "(CURRENT_TIMESTAMP)"
        }
        if l == "true" {
            return "1"
        }
        if l == "false" {
            return "0"
        }
        return "(" + d + ")"
    }

    // The definition of c; inlinePk: the column is the table's only key.
    func columnDef(c Column, inlinePk bool) string {
        var b = quoteIdent(c.Name) + " "
        if c.Auto && inlinePk && !this.pg() {
            return b + "INTEGER PRIMARY KEY AUTOINCREMENT"
        }
        b = b + this.colType(c)
        if c.Auto && this.pg() {
            b = b + " GENERATED BY DEFAULT AS IDENTITY"
        }
        if inlinePk {
            b = b + " PRIMARY KEY"
        } else if !c.Nullable {
            b = b + " NOT NULL"
        }
        if c.Default != "" && !c.Auto {
            b = b + " DEFAULT " + this.defaultSql(c.Default)
        }
        return b
    }

    func fkName(table string, fk ForeignKey) string {
        if fk.Name != "" {
            return fk.Name
        }
        return "fk_" + table + "_" + fk.RefTable + "_" + strings.Join(fk.Columns, "_")
    }

    func fkDef(table string, fk ForeignKey) string {
        var cols []string = []
        for c in fk.Columns {
            cols = append(cols, quoteIdent(c))
        }
        var refs []string = []
        for c in fk.RefColumns {
            refs = append(refs, quoteIdent(c))
        }
        var s = "CONSTRAINT " + quoteIdent(this.fkName(table, fk)) + " FOREIGN KEY (" + strings.Join(cols, ", ") + ") REFERENCES " + quoteIdent(fk.RefTable) + " (" + strings.Join(refs, ", ") + ")"
        if fk.OnDelete != "" {
            s = s + " ON DELETE " + fk.OnDelete
        }
        return s
    }

    // CREATE TABLE with its columns, primary key and foreign keys.
    func CreateTable(name string, cols []Column, fks []ForeignKey) {
        var keys []string = []
        for c in cols {
            if c.Key {
                keys = append(keys, quoteIdent(c.Name))
            }
        }
        var parts []string = []
        for c in cols {
            parts = append(parts, "    " + this.columnDef(c, c.Key && len(keys) == 1))
        }
        if len(keys) > 1 {
            parts = append(parts, "    PRIMARY KEY (" + strings.Join(keys, ", ") + ")")
        }
        for fk in fks {
            parts = append(parts, "    " + this.fkDef(name, fk))
        }
        this.Sql("CREATE TABLE " + quoteIdent(name) + " (\n" + strings.Join(parts, ",\n") + "\n)")
    }

    func DropTable(name string) {
        this.Sql("DROP TABLE " + quoteIdent(name))
    }

    func RenameTable(name string, to string) {
        this.Sql("ALTER TABLE " + quoteIdent(name) + " RENAME TO " + quoteIdent(to))
    }

    func AddColumn(table string, c Column) {
        var def = this.columnDef(c, false)
        if !c.Nullable && c.Default == "" && !c.Auto {
            // existing rows get the zero value
            def = def + " DEFAULT " + zeroLiteral(c.Type, this.pg())
        }
        this.Sql("ALTER TABLE " + quoteIdent(table) + " ADD COLUMN " + def)
    }

    func DropColumn(table string, name string) {
        this.Sql("ALTER TABLE " + quoteIdent(table) + " DROP COLUMN " + quoteIdent(name))
    }

    func RenameColumn(table string, name string, to string) {
        this.Sql("ALTER TABLE " + quoteIdent(table) + " RENAME COLUMN " + quoteIdent(name) + " TO " + quoteIdent(to))
    }

    // Changes a column's type, nullability and default (PostgreSQL; SQLite
    // cannot alter columns: rebuild the table with Sql).
    func AlterColumn(table string, c Column) {
        if !this.pg() {
            this.Sql("-- SQLite cannot alter column " + table + "." + c.Name + " (rebuild the table)")
            return
        }
        var t = "ALTER TABLE " + quoteIdent(table) + " ALTER COLUMN " + quoteIdent(c.Name)
        this.Sql(t + " TYPE " + this.colType(c))
        if c.Nullable {
            this.Sql(t + " DROP NOT NULL")
        } else {
            this.Sql(t + " SET NOT NULL")
        }
        if c.Default == "" {
            this.Sql(t + " DROP DEFAULT")
        } else {
            this.Sql(t + " SET DEFAULT " + c.Default)
        }
    }

    func CreateIndex(table string, name string, cols []string, unique bool) {
        var qs []string = []
        for c in cols {
            qs = append(qs, quoteIdent(c))
        }
        var u = ""
        if unique {
            u = "UNIQUE "
        }
        this.Sql("CREATE " + u + "INDEX " + quoteIdent(name) + " ON " + quoteIdent(table) + " (" + strings.Join(qs, ", ") + ")")
    }

    func DropIndex(table string, name string) {
        this.Sql("DROP INDEX " + quoteIdent(name))
    }

    // Adds a foreign key to an existing table (PostgreSQL; SQLite declares
    // foreign keys in CREATE TABLE only).
    func AddForeignKey(table string, fk ForeignKey) {
        if !this.pg() {
            this.Sql("-- SQLite cannot add foreign key " + this.fkName(table, fk) + " to an existing table")
            return
        }
        this.Sql("ALTER TABLE " + quoteIdent(table) + " ADD " + this.fkDef(table, fk))
    }

    func DropForeignKey(table string, name string) {
        if !this.pg() {
            this.Sql("-- SQLite cannot drop foreign key " + name)
            return
        }
        this.Sql("ALTER TABLE " + quoteIdent(table) + " DROP CONSTRAINT " + quoteIdent(name))
    }

    func createTableMeta(t *EntityMeta) {
        var cols []Column = []
        for c in t.Columns {
            cols = append(cols, Column{Name: c.Name, Type: c.Type, SqlType: c.SqlType, Nullable: c.Nullable, Key: c.Key, Auto: c.Auto, MaxLength: c.MaxLength, Default: c.Default})
        }
        var fks []ForeignKey = []
        for f in t.ForeignKeys {
            fks = append(fks, ForeignKey{Name: f.Name, Columns: f.Columns, RefTable: f.RefTable, RefColumns: f.RefColumns, OnDelete: f.OnDelete})
        }
        this.CreateTable(t.Table, cols, fks)
    }
}

func zeroLiteral(t string, pg bool) string {
    if t == "bool" {
        if pg {
            return "false"
        }
        return "0"
    }
    if t == "int64" || t == "int32" || t == "int16" || t == "float" || t == "float32" || t == "decimal" {
        return "0"
    }
    if t == "time" {
        return "'0001-01-01 00:00:00+00'"
    }
    if t == "json" {
        if pg {
            return "'null'"
        }
        return "'null'"
    }
    if t == "bytes" {
        if pg {
            return "''::bytea"
        }
        return "X''"
    }
    return "''"
}

// The migrations of the program (every struct with @migration), in id
// order; the compiler supplies the list.
func Migrations() []MigrationEntry {
    return migrationsOf()
}

func NewMigrator(p Provider) Migrator {
    return Migrator{provider: p, stmts: []}
}

func historyTable() string {
    return "__migrations"
}

async func ensureHistory(st *ctxState) void! {
    var t = "CREATE TABLE IF NOT EXISTS " + quoteIdent(historyTable()) + " (" + quoteIdent("id") + " text PRIMARY KEY, " + quoteIdent("applied_at") + " text NOT NULL)"
    _ = await st.exec(t, [])?
}

async func appliedIds(st *ctxState) []string! {
    await ensureHistory(st)?
    var rows = await st.all("SELECT " + quoteIdent("id") + " FROM " + quoteIdent(historyTable()) + " ORDER BY " + quoteIdent("id"), [])?
    var out []string = []
    for r in rows {
        var s = ""
        database.sql.convertInto(&s, r[0], "id")?
        out = append(out, s)
    }
    return out
}

func contains(xs []string, s string) bool {
    for x in xs {
        if x == s {
            return true
        }
    }
    return false
}

// Runs the statements of one migration step in a transaction and records
// (up) or removes (down) its id.
async func runStep(st *ctxState, id string, stmts []string, up bool) void! {
    var tx = await st.db.Begin()?
    defer tx.Rollback()
    st.tx = tx
    st.inTx = true
    for s in stmts {
        if strings.HasPrefix(s, "--") {
            continue
        }
        _ = try await st.exec(s, []) catch err {
            st.inTx = false
            return errors.Wrap(err, "migration " + id)
        }
    }
    var p1 = placeholder(st, 1)
    var p2 = placeholder(st, 2)
    if up {
        _ = try await st.exec("INSERT INTO " + quoteIdent(historyTable()) + " (" + quoteIdent("id") + ", " + quoteIdent("applied_at") + ") VALUES (" + p1 + ", " + p2 + ")", [id, time.UnixMilli(time.Now()).UTC().Format("2006-01-02T15:04:05Z07:00")]) catch err {
            st.inTx = false
            return err
        }
    } else {
        _ = try await st.exec("DELETE FROM " + quoteIdent(historyTable()) + " WHERE " + quoteIdent("id") + " = " + p1, [id]) catch err {
            st.inTx = false
            return err
        }
    }
    st.inTx = false
    await tx.Commit()?
}

func sortEntries(list []MigrationEntry) []MigrationEntry {
    var out []MigrationEntry = []
    for x in list {
        out = append(out, x)
    }
    var n = len(out)
    for i in 0..n {
        for j in 0..n - 1 - i {
            if out[j].Id > out[j + 1].Id {
                var t = out[j]
                out[j] = out[j + 1]
                out[j + 1] = t
            }
        }
    }
    return out
}

// Applies the pending migrations up to target ("" = all); a target older
// than the newest applied migration reverts the later ones (Down). Returns
// the ids applied (or reverted, prefixed with "-").
async func applyMigrations(st *ctxState, list []MigrationEntry, target string) []string! {
    var done = await appliedIds(st)?
    var sorted = sortEntries(list)
    for i, e in sorted {
        if e.Id == "" {
            return error("data: a migration has an empty id")
        }
        if i > 0 && sorted[i - 1].Id == e.Id {
            return error("data: duplicate migration id \"" + e.Id + "\"")
        }
    }
    var out []string = []
    if target != "" && target != "0" {
        var known = false
        for e in sorted {
            if e.Id == target || strings.HasSuffix(e.Id, "_" + target) {
                known = true
            }
        }
        if !known {
            return error("data: unknown migration " + target)
        }
    }
    // revert the applied migrations after the target (newest first)
    if target != "" {
        var n = len(sorted)
        var passed = false
        for i in 0..n {
            var e = sorted[n - 1 - i]
            if target != "0" && (e.Id == target || strings.HasSuffix(e.Id, "_" + target)) {
                passed = true
            }
            if !passed && contains(done, e.Id) {
                var m = NewMigrator(st.provider)
                e.Down(&m)
                await runStep(st, e.Id, m.Statements(), false)?
                out = append(out, "-" + e.Id)
            }
        }
    }
    for e in sorted {
        if target == "0" {
            break
        }
        if !contains(done, e.Id) && !contains(out, "-" + e.Id) {
            var m = NewMigrator(st.provider)
            e.Up(&m)
            await runStep(st, e.Id, m.Statements(), true)?
            out = append(out, e.Id)
        }
        if target != "" && target != "0" && (e.Id == target || strings.HasSuffix(e.Id, "_" + target)) {
            break
        }
    }
    return out
}

// The SQL of the migrations (from an empty database) for provider p.
func MigrationScript(p Provider, list []MigrationEntry) string {
    var b = strings.Builder{}
    for e in sortEntries(list) {
        var m = NewMigrator(p)
        e.Up(&m)
        b.Write("-- " + e.Id + "\n")
        for s in m.Statements() {
            if strings.HasPrefix(s, "--") {
                b.Write(s + "\n")
            } else {
                b.Write(s + ";\n")
            }
        }
        b.Write("\n")
    }
    return b.String()
}

// Entry point of `zell data update|script|list` (the generated program
// passes the migrations of the project): update applies pending
// migrations (or migrates to arg), script prints their SQL, list shows
// their state.
async func RunMigrations(p Provider, dsn string, list []MigrationEntry, command string, arg string) void! {
    if command == "script" {
        io.print(MigrationScript(p, list))
        return
    }
    var db = openDB(p, dsn)?
    defer db.Close()
    var st = newState(p, db)
    if command == "list" {
        var done = await appliedIds(st)?
        for e in sortEntries(list) {
            var s = "pending"
            if contains(done, e.Id) {
                s = "applied"
            }
            io.println(e.Id, s)
        }
        return
    }
    var ids = await applyMigrations(st, list, arg)?
    if len(ids) == 0 {
        io.println("database is up to date")
    }
    for id in ids {
        if strings.HasPrefix(id, "-") {
            io.println("reverted", id[1..len(id)])
        } else {
            io.println("applied", id)
        }
    }
}
