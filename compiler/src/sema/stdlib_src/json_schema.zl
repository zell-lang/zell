// json.Schema<T>(): the JSON Schema (draft 2020-12, as used by OpenAPI
// 3.1) of T, generated by compile-time reflection like Format<T>: structs
// by their fields (@json names, skip), slices and arrays as "array", maps with string keys as
// "object" with additionalProperties, pointers as their element, plain
// enums as string enums, time.Time as "date-time". Recursive types stop
// at the first repetition ({"type":"object"}).
namespace encoding.json

func Schema<T>() string {
    var b = strings.Builder{}
    var seen []string = []
    schemaOf<T>(&b, seen)
    return b.String()
}

func schemaOf<T>(b *strings.Builder, seen []string) {
    if len(seen) > 32 {
        b.Write("{}")
        return
    }
    if reflect.TypeOf<T>() == reflect.TypeOf<Value>() || reflect.TypeOf<T>().Kind == reflect.Kind.Any {
        b.Write("{}")
    } else if reflect.TypeOf<T>() == reflect.TypeOf<time.Time>() {
        b.Write("{\"type\":\"string\",\"format\":\"date-time\"}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Struct {
        var name = reflect.TypeOf<T>().FullName
        for x in seen {
            if x == name {
                b.Write("{\"type\":\"object\"}")
                return
            }
        }
        var inner []string = []
        for x in seen {
            inner = append(inner, x)
        }
        inner = append(inner, name)
        b.Write("{\"type\":\"object\",\"properties\":{")
        var zero T
        var first = true
        for f in reflect.Fields<T>() {
            var tag = f.Attribute<reflect.json>()
            if tag != nil && tag.skip {
                continue
            }
            var name = f.Name
            if tag != nil && tag.name != "" {
                name = tag.name
            }
            if !first {
                b.Write(",")
            }
            first = false
            b.Write(Quote(name))
            b.Write(":")
            schemaVal(b, f.Get(zero), inner)
        }
        b.Write("}")
        b.Write("}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.String {
        b.Write("{\"type\":\"string\"}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Bool {
        b.Write("{\"type\":\"boolean\"}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int || reflect.TypeOf<T>().Kind == reflect.Kind.Uint {
        b.Write("{\"type\":\"integer\",\"format\":\"int64\"}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int8 || reflect.TypeOf<T>().Kind == reflect.Kind.Int16 || reflect.TypeOf<T>().Kind == reflect.Kind.Int32 || reflect.TypeOf<T>().Kind == reflect.Kind.Uint8 || reflect.TypeOf<T>().Kind == reflect.Kind.Uint16 || reflect.TypeOf<T>().Kind == reflect.Kind.Uint32 {
        b.Write("{\"type\":\"integer\",\"format\":\"int32\"}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Float {
        b.Write("{\"type\":\"number\",\"format\":\"double\"}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Float32 {
        b.Write("{\"type\":\"number\",\"format\":\"float\"}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Char {
        b.Write("{\"type\":\"string\",\"minLength\":1,\"maxLength\":1}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Enum {
        b.Write("{\"type\":\"string\",\"enum\":[")
        for i, v in reflect.TypeOf<T>().Variants {
            if i > 0 {
                b.Write(",")
            }
            b.Write(Quote(v.Name))
        }
        b.Write("]}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Slice {
        var zero T
        b.Write("{\"type\":\"array\",\"items\":")
        schemaSlice(b, zero, seen)
        b.Write("}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Array {
        var zero T
        b.Write("{\"type\":\"array\",\"items\":")
        var done = false
        for x in zero {
            if !done {
                schemaVal(b, x, seen)
                done = true
            }
        }
        if !done {
            b.Write("{}")
        }
        b.Write("}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Map {
        var zero T
        b.Write("{\"type\":\"object\",\"additionalProperties\":")
        schemaMap(b, zero, seen)
        b.Write("}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Pointer {
        var zero T
        schemaPtr(b, zero, seen)
    } else {
        b.Write("{}")
    }
}

func schemaVal<F>(b *strings.Builder, x F, seen []string) {
    schemaOf<F>(b, seen)
}

func schemaSlice<E>(b *strings.Builder, xs []E, seen []string) {
    schemaOf<E>(b, seen)
}

func schemaMap<K, V>(b *strings.Builder, m map[K]V, seen []string) {
    schemaOf<V>(b, seen)
}

func schemaPtr<E>(b *strings.Builder, p *E, seen []string) {
    schemaOf<E>(b, seen)
}
