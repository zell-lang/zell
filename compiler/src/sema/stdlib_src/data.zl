    }

    func Max<N>(f expr<func(*T) N>) Task<N!> {
        return this.AsQuery().Max<N>(f)
    }

    func Average<N>(f expr<func(*T) N>) Task<float!> {
        return this.AsQuery().Average<N>(f)
    }

    func ExecuteUpdate(f func(Setters<T>) Setters<T>) Task<int!> {
        return this.AsQuery().ExecuteUpdate(f)
    }

    func ExecuteDelete() Task<int!> {
        return this.AsQuery().ExecuteDelete()
    }

    func ToSql() string {
        return this.AsQuery().ToSql()
    }

    func Args() []any {
        return this.AsQuery().Args()
    }

    // Starts tracking e as new: SaveChanges inserts it (and sets its
    // generated key and defaults).
    func Add(e *T) {
        var x = entryOf(this.st, e)
        if x != nil && x.state != 4 {
            if x.state == 3 {
                x.state = 2
            }
            return
        }
        _ = attachEntity(this.st, this.ent, e, 1)
    }

    // Adds every entity of es.
    func AddRange(es []*T) {
        for e in es {
            this.Add(e)
        }
    }

    // Starts tracking e as existing and unchanged (later changes are
    // detected against its current values).
    func Attach(e *T) {
        var x = entryOf(this.st, e)
        if x == nil || x.state == 4 {
            _ = attachEntity(this.st, this.ent, e, 0)
        }
    }

    // SaveChanges inserts e, or updates the existing row with the same key
    // (INSERT ... ON CONFLICT (key) DO UPDATE); the key must be set.
    func Upsert(e *T) {
        var cols []string = []
        if this.ent.Meta.Key >= 0 {
            cols = append(cols, this.ent.Meta.Columns[this.ent.Meta.Key].Name)
        }
        this.upsertBy_(e, cols)
    }

    // UpsertBy(e, (u) => u.Email) or UpsertBy(e, (u) => (u.A, u.B)): like
    // Upsert, with a unique column (or columns) as the conflict target
    // instead of the key.
    func UpsertBy(e *T, cols expr<func(*T) any>) {
        var names []string = []
        for f in selectedFields(cols.Root()) {
            var ci = this.ent.em.colOf(f)
            if ci < 0 {
                panic("data: UpsertBy: " + this.ent.Meta.Entity + " has no column " + f)
            }
            names = append(names, this.ent.Meta.Columns[ci].Name)
        }
        if len(names) == 0 {
            panic("data: UpsertBy takes the entity and a lambda selecting the conflict columns: UpsertBy(u, (x) => x.Email) or (x) => (x.A, x.B)")
        }
        this.upsertBy_(e, names)
    }

    func upsertBy_(e *T, cols []string) {
        _ = this.upsertEntry_(e, cols)
    }

    func upsertEntry_(e *T, cols []string) *entry {
        var x = entryOf(this.st, e)
        if x != nil && x.state != 4 {
            this.st.forget(x)
        }
        var n = attachEntity(this.st, this.ent, e, 5)
        n.conflict = cols
        return n
    }

    // The column names a selector lambda picks ((u) => u.Email, (u) =>
    // (u.A, u.B)).
    func columnsOf_(what string, sel expr<func(*T) any>) []string {
        var names []string = []
        for f in selectedFields(sel.Root()) {
            var ci = this.ent.em.colOf(f)
            if ci < 0 {
                panic("data: " + what + ": " + this.ent.Meta.Entity + " has no column " + f)
            }
            names = append(names, this.ent.Meta.Columns[ci].Name)
        }
        if len(names) == 0 {
            panic("data: " + what + " takes lambdas selecting columns: (x) => x.Email or (x) => (x.A, x.B)")
        }
        return names
    }

    // SaveChanges inserts e, or on a conflict over the conflict columns
    // updates only the update columns (INSERT ... ON CONFLICT (c) DO UPDATE
    // SET u = excluded.u): UpsertWith(u, (x) => x.Email, (x) => x.Name).
    func UpsertWith(e *T, conflict expr<func(*T) any>, update expr<func(*T) any>) {
        var n = this.upsertEntry_(e, this.columnsOf_("UpsertWith", conflict))
        n.updCols = this.columnsOf_("UpsertWith", update)
    }

    // SaveChanges inserts e unless a row conflicts over the columns
    // (INSERT ... ON CONFLICT (c) DO NOTHING); e then keeps a zero key.
    func InsertOrIgnore(e *T, conflict expr<func(*T) any>) {
        var n = this.upsertEntry_(e, this.columnsOf_("InsertOrIgnore", conflict))
        n.ignore = true
    }

    // Marks e as modified: SaveChanges updates all of its columns (e need
    // not have been loaded by this context).
    func Update(e *T) {
        var x = entryOf(this.st, e)
        if x == nil || x.state == 4 {
            x = attachEntity(this.st, this.ent, e, 2)
        }
        if x.state == 0 {
            x.state = 2
        }
    }

    // Marks e as deleted (an added entity is just forgotten).
    func Remove(e *T) {
        var x = entryOf(this.st, e)
        if x == nil || x.state == 4 {
            x = attachEntity(this.st, this.ent, e, 0)
        }
        if x.state == 1 {
            this.st.forget(x)
            return
        }
        x.state = 3
    }

    // The entity with key k: the tracked instance if there is one, else
    // loaded (and tracked); nil if there is no such row.
    func Find(k any) Task<*T!> {
        return setFind(*this, k)
    }

    // The tracked entities of this set (not deleted).
    func Local() []*T {
        var out []*T = []
        for e in this.st.entries {
            if e.state != 3 && e.state != 4 {
                switch e.obj {
                    case *T p:
                        out = append(out, p)
                }
            }
        }
        return out
    }

    // The table name.
    func TableName() string {
        return this.ent.Meta.Table
    }

    // The model of the entity.
    func Model() *EntityMeta {
        return this.ent.Meta
    }
}

// The tracking entry of an entity (ctx.Entry(u)).
struct Entry<T> {
    st  *ctxState
    p   *T
    ent *Entity<T>

    // The entity's state.
    func State() EntityState {
        var e = entryOf(this.st, this.p)
        if e == nil {
            return EntityState.Detached
        }
        if e.state == 0 {
            var cur = e.values()
            for i, v in cur {
                if !sameValue(v, e.snap[i]) {
                    return EntityState.Modified
                }
            }
        }
        return stateOf(e.state)
    }

    // The names of the columns whose value differs from the snapshot
    // (all columns of a modified entity).
    func ChangedColumns() []string {
        var out []string = []
        var e = entryOf(this.st, this.p)
        if e == nil || e.state == 1 || e.state == 4 {
            return out
        }
        var cur = e.values()
        for i, c in e.meta.Columns {
            if e.state == 2 || !sameValue(cur[i], e.snap[i]) {
                out = append(out, c.Name)
            }
        }
        return out
    }

    // Stops tracking the entity.
    func Detach() {
        var e = entryOf(this.st, this.p)
        if e != nil {
            this.st.forget(e)
        }
    }

    // Reloads the column values from the database (discarding changes).
    func Reload() Task<void!> {
        return reload(*this)
    }

    // A collection navigation to load explicitly: Collection((u) => u.Orders).Load().
    func Collection(nav expr<func(*T) any>) NavLoader {
        return this.navLoader(paramField(nav.Root()), true)
    }

    // A reference navigation to load explicitly: Reference((o) => o.User).Load().
    func Reference(nav expr<func(*T) any>) NavLoader {
        return this.navLoader(paramField(nav.Root()), false)
    }

    func navLoader(f string, many bool) NavLoader {
        var m = this.ent.Meta
        for inc in this.ent.incs {
            if inc.name == f {
                if inc.err != "" {
                    return NavLoader{load: nil, err: inc.err}
                }
                if inc.many != many {
                    var other = "Reference"
                    var what = "a reference"
                    if inc.many {
                        other = "Collection"
                        what = "a collection"
                    }
                    return NavLoader{load: nil, err: "data: " + m.Entity + "." + f + " is " + what + ": use " + other + "((x) => x." + f + ")"}
                }
                var st = this.st
                var p = this.p
                var load = inc.load
                return NavLoader{load: async func() void! {
                    await load(st, [p], true)?
                }, err: ""}
            }
        }
        return NavLoader{load: nil, err: "data: " + m.Entity + " has no navigation " + f}
    }

    func entity() *T {
        return this.p
    }

    func state() *ctxState {
        return this.st
    }
}

// A navigation of an entry (Entry.Collection((u) => u.Orders) /
// Reference((o) => o.User)).
struct NavLoader {
    load func() Task<void!>
    err  string

    // Loads the navigation from the database into the entity.
    func Load() Task<void!> {
        if this.err != "" {
            return failed(this.err)
        }
        return this.load()
    }
}

async func failed(msg string) void! {
    return error(msg)
}

async func setFind<T>(s Set<T>, k any) *T! {
    var m = s.ent.Meta
    if m.Key < 0 {
        return error("data: " + m.Entity + " has no key")
    }
    var kv = database.sql.driverValue(k)
    var e = s.st.find(idKey(m, kv))
    if e != nil && e.state != 3 {
        switch e.obj {
            case *T p:
                return p
        }
    }
    var q = s.AsQuery()
    var col = "t0." + quoteIdent(m.Columns[m.Key].Name) + " = {?0}"
    var q2 = q.where_(col, [kv])
    return await q2.FirstOrDefault()?
}

async func reload<T>(en Entry<T>) void! {
    var m = en.ent.Meta
    var vals = en.ent.values(en.p)
    var q = "SELECT " + columnList(m, "t0") + " FROM " + quoteIdent(m.Table) + " AS t0 WHERE t0." + quoteIdent(m.Columns[m.Key].Name) + " = " + placeholder(en.st, 1)
    var rows = await en.st.all(q, [vals[m.Key]])?
    if len(rows) == 0 {
        return NoElementsError{What: "Reload " + m.Entity}
    }
    en.ent.scan(rows[0], 0, en.p)?
    var e = entryOf(en.st, en.p)
    if e != nil {
        e.snap = e.values()
        e.state = 0
    }
}

// The placeholder of argument n of the context's dialect.
func placeholder(st *ctxState, n int) string {
    return st.d.Placeholder(n)
}

// A list argument ({*i}): the driver values of xs.
func listArg<E>(xs []E) any {
    var out []any = []
    for x in xs {
        out = append(out, database.sql.argOf(x))
    }
    return out
}
