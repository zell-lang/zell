namespace data

// data: an ORM on database.sql (docs/FRAMEWORK.md section 3).
//
// A context is a user struct that embeds Context and has one Set<T> field
// per entity type; data.Open<C>(provider, dsn) creates it. The package is
// plain library code: the model of every entity (table, columns, keys,
// relations, indexes) is built from reflection, attributes, conventions
// and the context's Configure method (data_model.zl), and its typed
// accessors (row scanning, column values) are unrolled over
// reflect.Fields<T>(). Query lambdas (Where, OrderBy, Select, ...) are
// expression trees translated to SQL by data_sql.zl, once per lambda
// site; data_query.zl assembles the fragments, runs them and maps rows.
// Change tracking keeps a snapshot of the column values of every tracked
// entity; SaveChanges writes the differences in one transaction
// (data_save.zl). Migrations and DDL are in data_migrate.zl.

// ---- attributes -------------------------------------------------------------

// @table("users"): the table of an entity (default: snake_case plural of
// the struct name, User -> users).
@attribute(targets: [reflect.Target.Struct])
struct table {
    name string
}

// @key: the primary key (default: the field named Id or <Type>Id). An
// integer key is generated by the database unless @key(generated: false).
@attribute(targets: [reflect.Target.Field])
struct key {
    generated bool = true
}

// @autoincrement: the column is generated by the database on insert.
@attribute(targets: [reflect.Target.Field])
struct autoincrement {}

// @column("email"): the column name (default: snake_case of the field);
// type: a provider type for migrations ("varchar(20)", "jsonb").
@attribute(targets: [reflect.Target.Field])
struct column {
    name string = ""
    type string = ""
}

// @index / @index(unique: true): a single-column index (composite indexes:
// ModelBuilder.HasIndex((u) => (u.A, u.B))); using: an index method
// ("gin" for jsonb and arrays on PostgreSQL; SQLite makes a plain index).
@attribute(targets: [reflect.Target.Field])
struct index {
    unique bool = false
    name   string = ""
    using  string = ""
}

// @maxLength(100): varchar(n) in migrations.
@attribute(targets: [reflect.Target.Field])
struct maxLength {
    length int
}

// @required: NOT NULL for a pointer field.
@attribute(targets: [reflect.Target.Field])
struct required {}

// @default("now()"): the column's SQL default; a zero value on insert is
// left out so that the database fills it in (and reads it back).
@attribute(targets: [reflect.Target.Field])
struct default {
    sql string
}

// @hasMany(foreignKey: "UserId") on a []Order or []*Order field: the
// dependents whose foreign key field references this entity's key
// (default foreign key: <Type>Id).
@attribute(targets: [reflect.Target.Field])
struct hasMany {
    foreignKey string = ""
}

// @hasOne(foreignKey: "UserId") on a *Profile field: the one dependent.
@attribute(targets: [reflect.Target.Field])
struct hasOne {
    foreignKey string = ""
}

// @belongsTo(foreignKey: "UserId") on a *User field: the principal
// referenced by this entity's foreign key field (default: <Field>Id).
@attribute(targets: [reflect.Target.Field])
struct belongsTo {
    foreignKey string = ""
}

// @manyToMany(through: "user_roles") on a []Role field: a join table
// with <owner>_id and <target>_id columns.
@attribute(targets: [reflect.Target.Field])
struct manyToMany {
    through string = ""
}

// @concurrencyToken: checked by UPDATE and DELETE (optimistic
// concurrency); an integer token is incremented by every update.
@attribute(targets: [reflect.Target.Field])
struct concurrencyToken {}

// @jsonb on a struct or map field: stored as a JSON document (jsonb on
// PostgreSQL, TEXT on SQLite; encoding.json names its keys); query lambdas
// read paths into it (u.Meta.Plan == "pro": meta ->> 'plan' on
// PostgreSQL, json_extract on SQLite). A []T field of scalars needs no
// attribute: it is an array column (text[], bigint[] on PostgreSQL, a
// JSON array on SQLite).
@attribute(targets: [reflect.Target.Field])
struct jsonb {}

// @uuidColumn on a string (or *string) field: a uuid column on PostgreSQL
// (TEXT on SQLite); values are the text form (uuid.New()); compare them
// with == and data.In (string functions need text on PostgreSQL).
@attribute(targets: [reflect.Target.Field])
struct uuidColumn {}

// @ignore: not mapped.
@attribute(targets: [reflect.Target.Field])
struct ignore {}

// @migration("20261021120000_AddUsers") on a struct with Up/Down methods
// (written by `zell data migration add`).
@attribute(targets: [reflect.Target.Struct])
struct migration {
    id string
}

// ---- model ------------------------------------------------------------------

// The database provider (dialect and driver).
enum Provider { Postgres, Sqlite }

// A mapped column. Type is provider independent: int64, int32, int16,
// float, float32, bool, string, bytes, time, decimal, json, enum (the
// variant name as text); SqlType overrides it in DDL.
struct ColumnMeta {
    Name      string
    Field     string
    Type      string
    SqlType   string
    Nullable  bool
    Key       bool
    Auto      bool
    MaxLength int
    Default   string
    Token     bool
}

struct IndexMeta {
    Name    string
    Columns []string
    Unique  bool
    Using   string
}

struct ForeignKeyMeta {
    Name       string
    Columns    []string
    RefTable   string
    RefColumns []string
    OnDelete   string
}

// The model of an entity (or of a many-to-many join table, Entity "").
struct EntityMeta {
    Entity      string
    Table       string
    Columns     []ColumnMeta
    // index of the key column (-1: none, join tables)
    Key         int
    // index of the concurrency token column (-1: none)
    Token       int
    Indexes     []IndexMeta
    ForeignKeys []ForeignKeyMeta

    func Column(name string) int {
        var found = -1
        for i, c in this.Columns {
            if found < 0 && (c.Name == name || c.Field == name) {
                found = i
            }
        }
        return found
    }
}

// The model and typed accessors of entity type T in a context model
// (entityFor<T>, data_model.zl).
@acyclic
struct Entity<T> {
    Meta   *EntityMeta
    em     *entModel
    // the loaders of the navigations
    incs   []Include<T>
    // reads the columns at vals[off..] into the entity
    scan   func([]any, int, *T) void!
    // the column values (driver values: int, float, bool, string, []byte, time, nil)
    values func(*T) []any
    // sets column i from a driver value (generated keys, defaults, tokens)
    set    func(*T, int, any) void!
    // resets the reference and many-to-many navigations (see ctxState.Drop)
    unlink func(*T)
}

// ---- errors -----------------------------------------------------------------

// SaveChanges found a row changed or deleted by someone else since it was
// read (its concurrency token differs): nothing was saved.
struct ConcurrencyError {
    Entity string
    Key    string

    func Message() string {
        return "data: concurrency conflict: " + this.Entity + " " + this.Key + " was changed or deleted by another transaction"
    }
}

// Reports whether err is a ConcurrencyError.
func IsConcurrencyError(err error) bool {
    switch err {
        case ConcurrencyError c:
            return true
    }
    return false
}

// A query that needs at least one row (First, Single, Min, ...) had none.
struct NoElementsError {
    What string

    func Message() string {
        return "data: " + this.What + ": the sequence contains no elements"
    }
}

// ---- tracking state ---------------------------------------------------------

// Entry states.
enum EntityState { Unchanged, Added, Modified, Deleted, Detached }

func stateOf(i int) EntityState {
    if i == 1 {
        return EntityState.Added
    }
    if i == 2 {
        return EntityState.Modified
    }
    if i == 3 {
        return EntityState.Deleted
    }
    if i == 4 {
        return EntityState.Detached
    }
    return EntityState.Unchanged
}

// A tracked entity: 0 unchanged, 1 added, 2 modified, 3 deleted, 4
// detached, 5 upserted (inserted or updated on conflict with `conflict`).
struct entry {
    meta     *EntityMeta
    obj      any
    state    int
    conflict []string
    // ON CONFLICT ... DO UPDATE SET only these columns (empty: all), or
    // DO NOTHING
    updCols  []string
    ignore   bool
    snap   []any
    key    string
    values func() []any
    set    func(int, any) void!
    unlink func()
}

struct ctxState {
    model    *ctxModel
    db       *database.sql.DB
    provider Provider
    inTx     bool
    tx       database.sql.Tx
    entries  []*entry
    ids      map[string]*entry
    // the tracked entries by the address of their entity (entryOf)
    byPtr    map[int]*entry
    // columnList(m, "t0") per table (the text is constant)
    colsOf   map[string]string
    tables   []*EntityMeta
    // unlinkers of entities no longer tracked (run by Drop as well)
    orphans  []func()
    hasLog   bool
    log      func(string)
    // the SQL dialect of the provider (data_dialect.zl) and its key
    d        Dialect
    dk       int
    qmark    bool


    // Tracked entities loaded with navigations in both directions
    // (u.Orders[i].User == u) keep each other alive (no tracing GC): when
    // the context goes away, the reference and many-to-many navigations of
    // its tracked entities are reset, which breaks such cycles.
    func Drop() {
        for e in this.entries {
            e.unlink()
        }
        for f in this.orphans {
            f()
        }
    }

    func trace(q string, args []any) {
        if this.hasLog {
            if len(args) == 0 {
                this.log(q)
            } else {
                this.log(q + " -- " + formatArgs(args))
            }
        }
    }

    async func exec(q string, args []any) database.sql.Result! {
        this.trace(q, args)
        if this.inTx {
            var t = this.tx
            return await t.Exec(q, args)?
        }
        return await this.db.Exec(q, args)?
    }

    async func rows(q string, args []any) database.sql.Rows! {
        this.trace(q, args)
        if this.inTx {
            var t = this.tx
            return await t.QueryRows(q, args)?
        }
        return await this.db.QueryRows(q, args)?
    }

    // Runs a query and returns all rows as driver values.
    async func all(q string, args []any) [][]any! {
        var rs = await this.rows(q, args)?
        defer rs.Close()
        var out [][]any = []
        for await rs.Next()? {
            // the driver reuses its row buffer
            var vs = rs.Values()
            var row []any = []
            for v in vs {
                row = append(row, v)
            }
            out = append(out, row)
        }
        return out
    }

    func addTable(m *EntityMeta) {
        for t in this.tables {
            if t.Table == m.Table {
                return
            }
        }
        this.tables = append(this.tables, m)
    }

    func find(k string) *entry {
        var e = this.ids[k]
        if e != nil && e.state != 4 {
            return e
        }
        return nil
    }

    func forget(e *entry) {
        if e.key != "" && this.ids[e.key] == e {
            delete(this.ids, e.key)
        }
        this.untrack(e)
        var keep []*entry = []
        for x in this.entries {
            if x != e {
                keep = append(keep, x)
            }
        }
        this.entries = keep
        e.state = 4
        this.orphans = append(this.orphans, e.unlink)
    }

    // Removes e from the address index (not from entries).
    func untrack(e *entry) {
        var a = ptrKey(e.obj)
        if this.byPtr[a] == e {
            delete(this.byPtr, a)
        }
    }

    // The t0-qualified column list of m, built once per context.
    func cols(m *EntityMeta) string {
        var s = this.colsOf[m.Table]
        if s == "" {
            s = columnList(m, "t0")
            this.colsOf[m.Table] = s
        }
        return s
    }
}

func formatArgs(args []any) string {
    var b = strings.Builder{}
    b.Write("[")
    for i, a in args {
        if i > 0 {
            b.Write(", ")
        }
        switch a {
            case nil:
                b.Write("NULL")
            case string s:
                b.Write(strconv.Quote(s))
            case time.Time t:
                b.Write(t.Format("2006-01-02T15:04:05Z07:00"))
            case []byte bs:
                b.Write(fmt.Format("<{0} bytes>", len(bs)))
            case int n:
                b.Write(fmt.Format("{0}", n))
            case float f:
                b.Write(fmt.Format("{0}", f))
            case bool x:
                b.Write(fmt.Format("{0}", x))
            default:
                b.Write("?")
        }
    }
    b.Write("]")
    return b.String()
}

// The identity-map key of a row of m with key value v.
func idKey(m *EntityMeta, v any) string {
    return m.Table + "|" + keyText(v)
}

func keyText(v any) string {
    switch v {
        case nil:
            return "NULL"
        case string s:
            return s
        case int n:
            return fmt.Format("{0}", n)
        case time.Time t:
            return t.Format("2006-01-02T15:04:05.999999999Z07:00")
        case []byte b:
            return strings.FromBytes(b)
        case float f:
            return fmt.Format("{0}", f)
        case bool b:
            return fmt.Format("{0}", b)
    }
    return "?"
}

// Whether two driver values are equal (change detection).
func sameValue(a any, b any) bool {
    switch a {
        case nil:
            return b == nil
        case int x:
            switch b {
                case int y:
                    return x == y
            }
        case float x:
            switch b {
                case float y:
                    return x == y
            }
        case bool x:
            switch b {
                case bool y:
                    return x == y
            }
        case string x:
            switch b {
                case string y:
                    return x == y
            }
        case time.Time x:
            switch b {
                case time.Time y:
                    return x.Equal(y)
            }
        case time.Duration x:
            switch b {
                case time.Duration y:
                    return x.Nanoseconds() == y.Nanoseconds()
            }
        case []byte x:
            switch b {
                case []byte y:
                    return bytes.Equal(x, y)
            }
        case []any x:
            switch b {
                case []any y:
                    if len(x) != len(y) {
                        return false
                    }
                    for i, e in x {
                        if !sameValue(e, y[i]) {
                            return false
                        }
                    }
                    return true
            }
    }
    return false
}

// Whether a driver value is the zero value of its type (defaults).
func isZero(v any) bool {
    switch v {
        case nil:
            return true
        case int n:
            return n == 0
        case float f:
            return f == 0
        case bool b:
            return !b
        case string s:
            return s == ""
        case time.Time t:
            return t.IsZero()
        case []byte b:
            return len(b) == 0
    }
    return false
}

// Tracks p (state as in entry).
func attachEntity<T>(st *ctxState, ent *Entity<T>, p *T, state int) *entry {
    var e = new entry{meta: ent.Meta, obj: p, state: state}
    e.values = func() []any {
        return ent.values(p)
    }
    e.set = func(i int, v any) void! {
        ent.set(p, i, v)?
    }
    e.unlink = func() {
        ent.unlink(p)
    }
    if state != 1 && state != 5 {
        e.snap = e.values()
        if ent.Meta.Key >= 0 {
            e.key = idKey(ent.Meta, e.snap[ent.Meta.Key])
            st.ids[e.key] = e
        }
    }
    st.entries = append(st.entries, e)
    st.byPtr[ptrKey(e.obj)] = e
    return e
}

// The address of the entity pointer boxed in a: an `any` holding a
// pointer is a heap box whose payload is the pointer (ABI.md 3.7), so the
// first word at the box's data address is the entity's address.
func ptrKey(a any) int {
    return unsafe.ReadInt(unsafe.AddrOf(a), 8)
}

// The entry tracking p, if any (by the address of p: a tracked entity is
// kept alive by its entry, so the address identifies it).
func entryOf<T>(st *ctxState, p *T) *entry {
    var a any = p
    var e = st.byPtr[ptrKey(a)]
    if e == nil {
        return nil
    }
    switch e.obj {
        case *T q:
            if q == p {
                return e
            }
    }
    return nil
}

// Maps the row at vals[off..] to an entity: the tracked instance if its
// key is already tracked (tracking queries), else a new one (tracked if
// tracking).
func materialize<T>(st *ctxState, ent *Entity<T>, vals []any, off int, tracking bool) *T! {
    if tracking && ent.Meta.Key >= 0 {
        var e = st.find(idKey(ent.Meta, vals[off + ent.Meta.Key]))
        if e != nil {
            switch e.obj {
                case *T p:
                    return p
            }
        }
    }
    var x T
    ent.scan(vals, off, &x)?
    var p = &x
    if tracking {
        _ = attachEntity(st, ent, p, 0)
    }
    return p
}

// The column list "t0"."a", "t0"."b" of m with alias a.
func columnList(m *EntityMeta, a string) string {
    var b = strings.Builder{}
    for i, c in m.Columns {
        if i > 0 {
            b.Write(", ")
        }
        b.Write(a + "." + quoteIdent(c.Name))
    }
    return b.String()
}

func quoteIdent(s string) string {
    return "\"" + strings.Replace(s, "\"", "\"\"") + "\""
}

// ---- context ------------------------------------------------------------------

// A struct embedding Context.
interface contextLike {
    func contextState_() *ctxState
}

// A Set<T> field.
interface setLike {
    func entityType_() *reflect.TypeInfo
}


// Embedded in a user context struct (see data.Open).
struct Context {
    st *ctxState

    func contextState_() *ctxState {
        return this.st
    }

    // NOTIFY channel, 'payload' (PostgreSQL; in a transaction it is sent
    // at commit).
    func Notify(channel string, payload string) Task<void!> {
        return notifyPg(this.st, channel, payload)
    }

    // LISTEN channel on a dedicated connection (PostgreSQL): the payloads
    // arrive on the subscription's channel C until Close.
    func Listen(channel string) Task<*Subscription!> {
        return listenPg(this.st, channel)
    }

    // The provider of the context.
    func Provider() Provider {
        return this.st.provider
    }

    // The connection pool.
    func DB() *database.sql.DB {
        return this.st.db
    }

    // Logs every statement (with its arguments) through f.
    func LogTo(f func(string)) {
        this.st.log = f
        this.st.hasLog = true
    }

    // Writes the tracked changes (inserts, updates of the changed columns
    // only, deletes) in one transaction and returns the number of entities
    // written. A concurrency token mismatch fails with ConcurrencyError and
    // nothing is saved.
    func SaveChanges() Task<int!> {
        return saveChanges(this.st)
    }

    // Runs f in a transaction: everything it does through the context
    // (queries, SaveChanges, ExecuteUpdate) commits together, or nothing
    // if it fails. Nested calls join the outer transaction.
    func Transaction(f func() Task<void!>) Task<void!> {
        return transaction(this.st, f)
    }

    // Typed raw SQL (Dapper style, not tracked): columns map to the fields
    // of T by @column / @sql.column, name or snake_case, or to a scalar.
    // Placeholders are $1.. on PostgreSQL and ? on SQLite (or :name with
    // sql.Named everywhere).
    func Raw<T>(query string, args []any) Task<[]T!> {
        return rawQuery<T>(this.st, query, args)
    }

    // Runs a raw statement; returns the number of rows affected.
    func ExecuteSql(query string, args []any) Task<int!> {
        return executeSql(this.st, query, args)
    }

    // The tracking entry of e (Collection/Reference loading, state).
    func Entry<T>(e *T) Entry<T> {
        return Entry<T>{st: this.st, p: e, ent: entityFor<T>(this.st.model)}
    }

    // Stops tracking every entity.
    func ClearTracker() {
        for e in this.st.entries {
            this.st.orphans = append(this.st.orphans, e.unlink)
        }
        this.st.entries = []
        this.st.ids = map[string]*entry{}
        this.st.byPtr = map[int]*entry{}
    }

    // Number of tracked entities.
    func Tracked() int {
        return len(this.st.entries)
    }

    // Creates the tables, indexes and foreign keys of the model (without
    // migrations; for tests and prototypes).
    func EnsureCreated() Task<void!> {
        return ensureCreated(this.st)
    }

    // The DDL of the model (EnsureCreated's statements).
    func CreateScript() []string {
        var m = Migrator{provider: this.st.provider, stmts: [], d: this.st.d}
        for t in this.st.tables {
            m.createTableMeta(t)
        }
        for t in this.st.tables {
            for ix in t.Indexes {
                m.CreateIndexUsing(t.Table, ix.Name, ix.Columns, ix.Unique, ix.Using)
            }
        }
        return m.Statements()
    }

    // Applies the pending migrations of the program (every struct with
    // @migration, in id order: reflect.TypesWith<migration>()).
    func Migrate() Task<void!> {
        return migrate(this.st, migrationsOf())
    }
}

async func migrate(st *ctxState, list []MigrationEntry) void! {
    _ = await applyMigrations(st, list, "")?
}

async func transaction(st *ctxState, f func() Task<void!>) void! {
    if st.inTx {
        await f()?
        return
    }
    var tx = await st.db.Begin()?
    defer tx.Rollback()
    st.tx = tx
    st.inTx = true
    st.trace("BEGIN", [])
    try await f() catch err {
        st.inTx = false
        st.trace("ROLLBACK", [])
        return err
    }
    st.inTx = false
    st.trace("COMMIT", [])
    await tx.Commit()?
}

async func rawQuery<T>(st *ctxState, query string, args []any) []T! {
    st.trace(query, args)
    if st.inTx {
        var t = st.tx
        return await t.Query<T>(query, args)?
    }
    return await st.db.Query<T>(query, args)?
}

async func executeSql(st *ctxState, query string, args []any) int! {
    var r = await st.exec(query, args)?
    return r.RowsAffected
}

async func ensureCreated(st *ctxState) void! {
    var m = Migrator{provider: st.provider, stmts: [], d: st.d}
    for t in st.tables {
        m.createTableMeta(t)
    }
    for t in st.tables {
        for ix in t.Indexes {
            m.CreateIndexUsing(t.Table, ix.Name, ix.Columns, ix.Unique, ix.Using)
        }
    }
    for s in m.Statements() {
        _ = await st.exec(s, [])?
    }
}

// Creates the context state over db.
func newState(p Provider, db *database.sql.DB) *ctxState {
    var d = dialectOf(p)
    return new ctxState{model: nil, db: db, provider: p, d: d, dk: dialectKey(d), qmark: d.Placeholder(1) == "?", ids: map[string]*entry{}, byPtr: map[int]*entry{}, colsOf: map[string]string{}, entries: []}
}

// Opens the pool of provider p (SQLite ":memory:" databases get one
// connection, so that every statement sees the same database).
func openDB(p Provider, dsn string) *database.sql.DB! {
    var d = dialectOf(p)
    switch d {
    case Opener o:
        return o.Open(dsn)?
    }
    return error("data: the " + d.Name() + " dialect cannot open connections (use data.OpenDB)")
}

// Parses "postgres"/"postgresql"/"pg" or "sqlite"/"sqlite3".
func ParseProvider(name string) Provider! {
    var n = strings.ToLower(name)
    if n == "postgres" || n == "postgresql" || n == "pg" {
        return Provider.Postgres
    }
    if n == "sqlite" || n == "sqlite3" {
        return Provider.Sqlite
    }
    return error("data: unknown provider \"" + name + "\" (postgres or sqlite)")
}

// ---- sets ---------------------------------------------------------------------

// The entities of type T of a context (a table). The query operators are
// those of Query<T> (ctx.Users.Where(...) is ctx.Users.AsQuery().Where(...)).
struct Set<T> {
    st  *ctxState
    ent *Entity<T>

    func entityType_() *reflect.TypeInfo {
        return reflect.TypeOf<T>()
    }

    // The set of a new context state (data.Open).
    func bind_(st *ctxState) Set<T> {
        return Set<T>{st: st, ent: entityFor<T>(st.model)}
    }

    // A query over the whole table.
    func AsQuery() Query<T> {
        return Query<T>{c: newCore(this.st, this.ent.Meta), ent: this.ent, tracking: true}
    }

    func AsNoTracking() Query<T> {
        return Query<T>{c: newCore(this.st, this.ent.Meta), ent: this.ent, tracking: false}
    }

    func AsTracking() Query<T> {
        return this.AsQuery()
    }

    func AsSplitQuery() Query<T> {
        return this.AsQuery().AsSplitQuery()
    }

    func AsEnumerable() Enumerable<T> {
        return this.AsQuery().AsEnumerable()
    }

    func Where(p expr<func(*T) bool>) Query<T> {
        return this.AsQuery().Where(p)
    }

    func OrderBy(key expr<func(*T) any>) Query<T> {
        return this.AsQuery().OrderBy(key)
    }

    func OrderByDescending(key expr<func(*T) any>) Query<T> {
        return this.AsQuery().OrderByDescending(key)
    }

    func Include(nav expr<func(*T) any>) Query<T> {
        return this.AsQuery().Include(nav)
    }

    func Select<R>(f expr<func(*T) R>) Projection<R> {
        return this.AsQuery().Select<R>(f)
    }

    func GroupBy<K>(key expr<func(*T) K>) Grouped<T, K> {
        return this.AsQuery().GroupBy<K>(key)
    }

    func Join<I, K, R>(inner Set<I>, outerKey expr<func(*T) K>, innerKey expr<func(*I) K>, result expr<func(*T, *I) R>) Projection<R> {
        return this.AsQuery().Join<I, K, R>(inner, outerKey, innerKey, result)
    }

    func LeftJoin<I, K, R>(inner Set<I>, outerKey expr<func(*T) K>, innerKey expr<func(*I) K>, result expr<func(*T, *I) R>) Projection<R> {
        return this.AsQuery().LeftJoin<I, K, R>(inner, outerKey, innerKey, result)
    }

    func RightJoin<I, K, R>(inner Set<I>, outerKey expr<func(*T) K>, innerKey expr<func(*I) K>, result expr<func(*T, *I) R>) Projection<R> {
        return this.AsQuery().RightJoin<I, K, R>(inner, outerKey, innerKey, result)
    }

    func FullJoin<I, K, R>(inner Set<I>, outerKey expr<func(*T) K>, innerKey expr<func(*I) K>, result expr<func(*T, *I) R>) Projection<R> {
        return this.AsQuery().FullJoin<I, K, R>(inner, outerKey, innerKey, result)
    }

    func CrossJoin<I, R>(inner Set<I>, result expr<func(*T, *I) R>) Projection<R> {
        return this.AsQuery().CrossJoin<I, R>(inner, result)
    }

    func Skip(n int) Query<T> {
        return this.AsQuery().Skip(n)
    }

    func Take(n int) Query<T> {
        return this.AsQuery().Take(n)
    }

    func Distinct() Query<T> {
        return this.AsQuery().Distinct()
    }

    func ToList() Task<[]*T!> {
        return this.AsQuery().ToList()
    }

    func First(p ...expr<func(*T) bool>) Task<*T!> {
        return this.AsQuery().First(p...)
    }

    func FirstOrDefault(p ...expr<func(*T) bool>) Task<*T!> {
        return this.AsQuery().FirstOrDefault(p...)
    }

    func Single(p ...expr<func(*T) bool>) Task<*T!> {
        return this.AsQuery().Single(p...)
    }

    func SingleOrDefault(p ...expr<func(*T) bool>) Task<*T!> {
        return this.AsQuery().SingleOrDefault(p...)
    }

    func Count(p ...expr<func(*T) bool>) Task<int!> {
        return this.AsQuery().Count(p...)
    }

    func Any(p ...expr<func(*T) bool>) Task<bool!> {
        return this.AsQuery().Any(p...)
    }

    func All(p expr<func(*T) bool>) Task<bool!> {
        return this.AsQuery().All(p)
    }

    func Sum<N>(f expr<func(*T) N>) Task<N!> {
        return this.AsQuery().Sum<N>(f)
    }

    func Min<N>(f expr<func(*T) N>) Task<N!> {
