namespace data

// Queries: the operators take their lambdas as expression trees, which
// data_sql.zl translates to SQL fragments for both dialects (cached per
// lambda site); a fragment's text references its arguments as {?i} (one
// value) and {*i} (a list, expanded to one placeholder per element). This
// file assembles SELECT/UPDATE/DELETE statements from them, numbers the
// placeholders for the provider, runs them and maps the rows. A lambda
// that cannot be translated makes the query fail when it runs.

// A SQL fragment for both dialects and its arguments.
struct Frag {
    s    string
    args []any
}

func addFrag(xs []Frag, f Frag) []Frag {
    var out []Frag = []
    for x in xs {
        out = append(out, x)
    }
    out = append(out, f)
    return out
}

// A statement being written: text and arguments with numbered placeholders.
struct sqlw {
    d      Dialect
    b      strings.Builder
    args   []any
    // GROUP BY keys, referenced as {#i} by the projection of a group
    groups []Frag
    // a subquery rendered into a lambda's fragment: placeholders become
    // the markers {?mbase + i} of the enclosing plan (data_sub.zl)
    mark   bool
    mbase  int
    // the dialect's placeholders are all ? (no call per argument)
    qmark  bool

    func raw(s string) {
        this.b.Write(s)
    }

    func ph(v any) {
        switch v {
        case []any xs:
            this.args = append(this.args, this.d.BindArray(xs))
        default:
            this.args = append(this.args, v)
        }
        if this.mark {
            this.b.Write("{?" + strconv.Itoa(this.mbase + len(this.args) - 1) + "}")
        } else if this.qmark {
            this.b.Write("?")
        } else {
            this.b.Write(this.d.Placeholder(len(this.args)))
        }
    }

    // Appends fragment f with its markers replaced by placeholders.
    func frag(f Frag) {
        var s = f.s
        var n = len(s)
        var i = 0
        var start = 0
        for i < n {
            var c = int(s[i])
            if c == 123 && i + 1 < n && (int(s[i + 1]) == 63 || int(s[i + 1]) == 42 || int(s[i + 1]) == 35) {
                var j = i + 2
                var idx = 0
                for j < n && int(s[j]) >= 48 && int(s[j]) <= 57 {
                    idx = idx * 10 + int(s[j]) - 48
                    j += 1
                }
                if j < n && int(s[j]) == 125 {
                    this.b.Write(s[start..i])
                    var a any = nil
                    if idx < len(f.args) {
                        a = f.args[idx]
                    }
                    if int(s[i + 1]) == 63 {
                        this.ph(a)
                    } else if int(s[i + 1]) == 42 {
                        this.list(a)
                    } else if idx < len(this.groups) {
                        this.frag(this.groups[idx])
                    }
                    i = j + 1
                    start = i
                    continue
                }
            }
            i += 1
        }
        this.b.Write(s[start..n])
    }

    // A list argument: one placeholder per element (NULL for an empty list).
    func list(a any) {
        var xs []any = []
        switch a {
            case []any vs:
                xs = vs
        }
        if len(xs) == 0 {
            this.b.Write("NULL")
            return
        }
        for i, x in xs {
            if i > 0 {
                this.b.Write(", ")
            }
            this.ph(x)
        }
    }

    func text() string {
        return this.b.String()
    }
}

// The rarely used parts of a core.
struct coreExt {
    // a feature the dialect may lack (Dialect.Require, when it runs)
    needs      string
    // the FROM source instead of the table: a derived table (set
    // operations, CTEs; data_set.zl), written as FROM <src> AS t0
    src        Frag
    hasSrc     bool
    // DISTINCT ON (keys) (with distinct set), and the row lock clause
    distinctOn string
    lockMode   string
    lockWait   string
    lockSql    string
}

// The SQL parts of a query over a root table aliased t0.
struct core {
    st       *ctxState
    meta     *EntityMeta
    joins    []Frag
    wheres   []Frag
    orders   []Frag
    groups   []Frag
    havings  []Frag
    skip     int
    take     int
    distinct bool
    // a translation error: running the query fails with it
    err      string
    // the rarely used parts (nil: none), shared by copies: replaced, not
    // changed (ext)
    x        *coreExt

    // A copy of the extension to change and store in x.
    func ext() *coreExt {
        if this.x == nil {
            return new coreExt{src: Frag{s: "", args: []}, hasSrc: false, distinctOn: "", lockMode: "", lockWait: "", lockSql: "", needs: ""}
        }
        var e = *this.x
        return new coreExt{src: e.src, hasSrc: e.hasSrc, distinctOn: e.distinctOn, lockMode: e.lockMode, lockWait: e.lockWait, lockSql: e.lockSql, needs: e.needs}
    }

    func hasSrc() bool {
        return this.x != nil && this.x.hasSrc
    }

    func needs() string {
        if this.x == nil {
            return ""
        }
        return this.x.needs
    }

    func writer() sqlw {
        return sqlw{d: this.st.d, b: strings.Builder{}, args: [], groups: this.groups, qmark: this.st.qmark}
    }

    func paged() bool {
        return this.skip > 0 || this.take >= 0
    }

    // FROM ... WHERE ... GROUP BY ... HAVING ...
    func from(w *sqlw) {
        if this.hasSrc() {
            w.raw(" FROM ")
            w.frag(this.x.src)
            w.raw(" AS t0")
        } else {
            w.raw(" FROM " + quoteIdent(this.meta.Table) + " AS t0")
        }
        for j in this.joins {
            w.frag(j)
        }
        this.whereGroup(w)
    }

    func whereGroup(w *sqlw) {
        for i, f in this.wheres {
            if i == 0 {
                w.raw(" WHERE ")
            } else {
                w.raw(" AND ")
            }
            if len(this.wheres) > 1 {
                w.raw("(")
                w.frag(f)
                w.raw(")")
            } else {
                w.frag(f)
            }
        }
        for i, f in this.groups {
            if i == 0 {
                w.raw(" GROUP BY ")
            } else {
                w.raw(", ")
            }
            w.frag(f)
        }
        for i, f in this.havings {
            if i == 0 {
                w.raw(" HAVING ")
            } else {
                w.raw(" AND ")
            }
            w.raw("(")
            w.frag(f)
            w.raw(")")
        }
    }

    func orderBy(w *sqlw, extra string) {
        var n = 0
        for f in this.orders {
            if n == 0 {
                w.raw(" ORDER BY ")
            } else {
                w.raw(", ")
            }
            w.frag(f)
            n += 1
        }
        if extra != "" {
            if n == 0 {
                w.raw(" ORDER BY ")
            } else {
                w.raw(", ")
            }
            w.raw(extra)
        }
    }

    func paging(w *sqlw) {
        if this.take >= 0 || this.skip > 0 {
            w.raw(w.d.Paging(this.take, this.skip))
        }
    }

    // SELECT [DISTINCT] sel FROM ... ORDER BY ... LIMIT ...
    func selectSql(w *sqlw, sel Frag) {
        w.raw("SELECT ")
        if this.x != nil && this.x.distinctOn != "" {
            w.raw("DISTINCT ON (" + this.x.distinctOn + ") ")
        } else if this.distinct {
            w.raw("DISTINCT ")
        }
        w.frag(sel)
        this.from(w)
        this.orderBy(w, "")
        this.paging(w)
        if this.x != nil && this.x.lockSql != "" {
            w.raw(this.x.lockSql)
        }
    }

    // SELECT COUNT(*) ...
    func countSql(w *sqlw, sel Frag) {
        if this.distinct || this.paged() || len(this.groups) > 0 {
            w.raw("SELECT COUNT(*) FROM (")
            this.selectSql(w, sel)
            w.raw(") AS c")
            return
        }
        w.raw("SELECT COUNT(*)")
        this.from(w)
    }

    func existsSql(w *sqlw, sel Frag) {
        w.raw("SELECT EXISTS (")
        if this.distinct || this.paged() || len(this.groups) > 0 {
            this.selectSql(w, sel)
        } else {
            w.raw("SELECT 1")
            this.from(w)
        }
        w.raw(")")
    }

    // The FROM source of an aggregate or a joined include: the table, or
    // the paged/distinct query as a subquery aliased t0.
    func source(w *sqlw) {
        if this.paged() || this.distinct {
            w.raw(" FROM (")
            this.selectSql(w, entityCols(this.st, this.meta))
            w.raw(") AS t0")
        } else {
            this.from(w)
        }
    }

    func count(sel Frag) Task<int!> {
        return core_count(*this, sel)
    }

    func exists(sel Frag) Task<bool!> {
        return core_exists(*this, sel)
    }
}

async func core_count(q core, sel Frag) int! {
    var w = q.writer()
    q.countSql(&w, sel)
    var rows = await q.st.all(w.text(), w.args)?
    var n = 0
    if len(rows) > 0 && len(rows[0]) > 0 {
        database.sql.convertInto(&n, rows[0][0], "count")?
    }
    return n
}

async func core_exists(q core, sel Frag) bool! {
    var w = q.writer()
    q.existsSql(&w, sel)
    var rows = await q.st.all(w.text(), w.args)?
    var b = false
    if len(rows) > 0 && len(rows[0]) > 0 {
        database.sql.convertInto(&b, rows[0][0], "exists")?
    }
    return b
}

func newCore(st *ctxState, m *EntityMeta) core {
    return core{st: st, meta: m, joins: [], wheres: [], orders: [], groups: [], havings: [], skip: 0, take: -1, distinct: false, err: ""}
}

func entityCols(st *ctxState, m *EntityMeta) Frag {
    var cols = st.cols(m)
    return Frag{s: cols, args: []}
}

// A navigation loaded with the query (Include): joined into the query or
// loaded by a second query (AsSplitQuery). Made for every navigation of an
// entity with its accessors (data_model.zl, includeOf).
@acyclic
struct Include<T> {
    name     string
    many     bool
    // why the navigation cannot be loaded ("": it can)
    err      string
    load     func(*ctxState, []*T, bool) Task<void!>
    join     Frag
    cols     string
    ncols    int
    childKey int
    attach   func(*ctxState, *T, []any, int, bool) void!
    reset    func(*T)
}

// A query of entities T (ctx.Users.Where(...)). Values are immutable: every
// operator returns a new query.
struct Query<T> {
    c        core
    ent      *Entity<T>
    tracking bool
    split    bool
    includes []Include<T>

    // The query without change tracking: entities are neither tracked nor
    // taken from the identity map.
    func AsNoTracking() Query<T> {
        var q = *this
        q.tracking = false
        return q
    }

    func AsTracking() Query<T> {
        var q = *this
        q.tracking = true
        return q
    }

    // Includes are loaded by one query per navigation instead of joins.
    func AsSplitQuery() Query<T> {
        var q = *this
        q.split = true
        return q
    }

    func AsSingleQuery() Query<T> {
        var q = *this
        q.split = false
        return q
    }

    // Skips n rows (OFFSET).
    func Skip(n int) Query<T> {
        var q = *this
        q.c.skip = n
        return q
    }

    // At most n rows (LIMIT).
    func Take(n int) Query<T> {
        var q = *this
        q.c.take = n
        return q
    }

    func Distinct() Query<T> {
        var q = *this
        q.c.distinct = true
        return q
    }

    // Client-side evaluation: the query runs as it is and the following
    // operators (with ordinary function values) run in memory.
    func AsEnumerable() Enumerable<T> {
        return Enumerable<T>{q: *this, filters: []}
    }

    func fail(msg string) Query<T> {
        var q = *this
        if q.c.err == "" {
            q.c.err = msg
        }
        return q
    }

    // Filters the rows: Where((u) => u.Age >= min && strings.HasPrefix(u.Name, "A")).
    // The lambda is an expression tree, translated to SQL once per lambda
    // site; constants and captured values are statement arguments.
    func Where(p expr<func(*T) bool>) Query<T> {
        var st = this.c.st
        var pl = lookupPlan(st.model, st.dk, p.SiteId(), 0)
        if pl == nil {
            pl = predPlan(st, this.ent.em, p)
        }
        if pl.err != "" {
            return this.fail(pl.err)
        }
        return this.where_(pl.s, planArgs(pl, &p))
    }

    // Orders by a value or a tuple of values: OrderBy((u) => (u.Last, u.First)).
    func OrderBy(key expr<func(*T) any>) Query<T> {
        return this.ordered(key, false, false)
    }

    func OrderByDescending(key expr<func(*T) any>) Query<T> {
        return this.ordered(key, true, false)
    }

    // A further ordering key.
    func ThenBy(key expr<func(*T) any>) Query<T> {
        return this.ordered(key, false, true)
    }

    func ThenByDescending(key expr<func(*T) any>) Query<T> {
        return this.ordered(key, true, true)
    }

    func ordered(key expr<func(*T) any>, desc bool, then bool) Query<T> {
        var st = this.c.st
        var role = 1
        if desc {
            role = 2
        }
        var pl = lookupPlan(st.model, st.dk, key.SiteId(), role)
        if pl == nil {
            pl = orderPlan(st, this.ent.em, key, desc)
        }
        if pl.err != "" {
            return this.fail(pl.err)
        }
        return this.order_(pl.s, planArgs(pl, &key), then)
    }

    // Loads a navigation with the query: Include((u) => u.Orders).
    func Include(nav expr<func(*T) any>) Query<T> {
        var f = paramField(nav.Root())
        for inc in this.ent.incs {
            if inc.name == f {
                if inc.err != "" {
                    return this.fail(inc.err)
                }
                return this.include_(inc)
            }
        }
        return this.fail("data: Include needs a navigation of " + this.c.meta.Entity + ": Include((u) => u.Orders)")
    }

    // A projection: Select((u) => (u.Name, len(u.Orders))), Select((u) =>
    // UserDto{Name: u.Name}) or Select((u) => u.Email).
    func Select<R>(f expr<func(*T) R>) Projection<R> {
        selectCheck<R>()
        var st = this.c.st
        var pl = lookupPlan(st.model, st.dk, f.SiteId(), 3)
        if pl == nil {
            pl = selectPlan(st, this.ent.em, f)
        }
        var c = this.c
        if pl.err != "" && c.err == "" {
            c.err = pl.err
        }
        return Projection<R>{c: c, sel: Frag{s: pl.s, args: planArgs(pl, &f)}, m: rowMapper<R>(pl.shape)}
    }

    // Groups the rows: GroupBy((o) => o.Product) or GroupBy((o) => (o.A, o.B)),
    // then Where (HAVING), OrderBy and Select over the groups.
    func GroupBy<K>(key expr<func(*T) K>) Grouped<T, K> {
        var st = this.c.st
        var pl = lookupPlan(st.model, st.dk, key.SiteId(), 8)
        if pl == nil {
            pl = groupKeyPlan(st, this.ent.em, key)
        }
        var g = this.group_<K>(pl.ss, planArgs(pl, &key))
        if pl.err != "" && g.c.err == "" {
            g.c.err = pl.err
        }
        return g
    }

    // An inner join with another set: Join(ctx.Orders, (u) => u.Id, (o) =>
    // o.UserId, (u, o) => (u.Name, o.Total)).
    func Join<I, K, R>(inner Set<I>, outerKey expr<func(*T) K>, innerKey expr<func(*I) K>, result expr<func(*T, *I) R>) Projection<R> {
        return this.join_<I, K, R>(" JOIN ", inner, outerKey, innerKey, result)
    }

    // A left outer join: the inner row may be missing (its columns are
    // NULL; select them with data.Nullable(o.Total), test it with o == nil).
    func LeftJoin<I, K, R>(inner Set<I>, outerKey expr<func(*T) K>, innerKey expr<func(*I) K>, result expr<func(*T, *I) R>) Projection<R> {
        return this.join_<I, K, R>(" LEFT JOIN ", inner, outerKey, innerKey, result)
    }

    // A right outer join (PostgreSQL; SQLite 3.39 or later): the outer row
    // may be missing.
    func RightJoin<I, K, R>(inner Set<I>, outerKey expr<func(*T) K>, innerKey expr<func(*I) K>, result expr<func(*T, *I) R>) Projection<R> {
        return this.join_<I, K, R>(" RIGHT JOIN ", inner, outerKey, innerKey, result)
    }

    // A full outer join (PostgreSQL; SQLite 3.39 or later): either row may
    // be missing.
    func FullJoin<I, K, R>(inner Set<I>, outerKey expr<func(*T) K>, innerKey expr<func(*I) K>, result expr<func(*T, *I) R>) Projection<R> {
        return this.join_<I, K, R>(" FULL JOIN ", inner, outerKey, innerKey, result)
    }

    // Every pair of rows: CrossJoin(ctx.Colors, (u, c) => (u.Name, c.Name)).
    func CrossJoin<I, R>(inner Set<I>, result expr<func(*T, *I) R>) Projection<R> {
        selectCheck<R>()
        var c = this.c
        var p = newPlan()
        try crossInto(c.st, this.ent.em, inner.ent.em, result.Root(), p) catch err {
            if c.err == "" {
                c.err = err.Message()
            }
        }
        var j = " CROSS JOIN " + quoteIdent(inner.ent.Meta.Table) + " AS t1"
        c.joins = addFrag(c.joins, Frag{s: j, args: []})
        return Projection<R>{c: c, sel: Frag{s: p.s, args: p.vals}, m: rowMapper<R>(p.shape)}
    }

    func join_<I, K, R>(kw string, inner Set<I>, outerKey expr<func(*T) K>, innerKey expr<func(*I) K>, result expr<func(*T, *I) R>) Projection<R> {
        selectCheck<R>()
        var c = this.c
        var p = newPlan()
        var j = newPlan()
        if kw != " JOIN " && kw != " LEFT JOIN " {
            var e = c.ext()
            e.needs = "right-join"
            c.x = e
        }
        try joinInto(kw, c.st, this.ent.em, inner.ent.em, outerKey.Root(), innerKey.Root(), result.Root(), j, p) catch err {
            if c.err == "" {
                c.err = err.Message()
            }
        }
        c.joins = addFrag(c.joins, Frag{s: j.s, args: j.vals})
        return Projection<R>{c: c, sel: Frag{s: p.s, args: p.vals}, m: rowMapper<R>(p.shape)}
    }

    // Updates the matching rows (set-based, without loading or tracking):
    // ExecuteUpdate((s) => s.Set((u) => u.Done, true).SetWith((u) => u.N,
    // (u) => u.N + 1)); returns the number of rows updated.
    func ExecuteUpdate(f func(Setters<T>) Setters<T>) Task<int!> {
        var s = f(Setters<T>{items: []})
        var q = *this
        var u = updateParts(q.c.st, q.ent.em, s.items)
        if u.err != "" && q.c.err == "" {
            q.c.err = u.err
        }
        return query_update(q, u.s, u.args)
    }

    // The query with each predicate added (First(p), Count(p), ...).
    func filtered(ps []expr<func(*T) bool>) Query<T> {
        var q = *this
        for p in ps {
            q = q.Where(p)
        }
        return q
    }

    // Whether every row satisfies the predicate.
    func All(p expr<func(*T) bool>) Task<bool!> {
        var st = this.c.st
        var pl = lookupPlan(st.model, st.dk, p.SiteId(), 0)
        if pl == nil {
            pl = predPlan(st, this.ent.em, p)
        }
        var q = *this
        if pl.err != "" && q.c.err == "" {
            q.c.err = pl.err
        }
        return query_all(q, pl.s, planArgs(pl, &p))
    }

    // SUM of a value (0 for no rows).
    func Sum<N>(f expr<func(*T) N>) Task<N!> {
        numberCheck<N>("Sum")
        return this.aggregate<N, N>(f, "Sum", 4, 0)
    }

    // MIN of a value (NoElementsError for no rows).
    func Min<N>(f expr<func(*T) N>) Task<N!> {
        return this.aggregate<N, N>(f, "Min", 5, 1)
    }

    func Max<N>(f expr<func(*T) N>) Task<N!> {
        return this.aggregate<N, N>(f, "Max", 6, 1)
    }

    // AVG of a value, as a float (NoElementsError for no rows).
    func Average<N>(f expr<func(*T) N>) Task<float!> {
        numberCheck<N>("Average")
        return this.aggregate<N, float>(f, "Average", 7, 1)
    }

    func aggregate<N, R>(f expr<func(*T) N>, what string, role int, empty int) Task<R!> {
        var st = this.c.st
        var pl = lookupPlan(st.model, st.dk, f.SiteId(), role)
        if pl == nil {
            pl = aggPlan(st, this.ent.em, f, what, role)
        }
        var q = *this
        if pl.err != "" && q.c.err == "" {
            q.c.err = pl.err
        }
        return q.scalar_<R>(pl.s, planArgs(pl, &f), empty, what + " " + this.c.meta.Entity)
    }

    func where_(s string, args []any) Query<T> {
        var q = *this
        q.c.wheres = addFrag(q.c.wheres, Frag{s: s, args: args})
        return q
    }

    func order_(s string, args []any, then bool) Query<T> {
        var q = *this
        if !then {
            q.c.orders = []
        }
        q.c.orders = addFrag(q.c.orders, Frag{s: s, args: args})
        return q
    }

    func include_(inc Include<T>) Query<T> {
        var q = *this
        var xs []Include<T> = []
        for x in q.includes {
            xs = append(xs, x)
        }
        xs = append(xs, inc)
        q.includes = xs
        return q
    }

    func group_<K>(ss []string, args []any) Grouped<T, K> {
        var c = this.c
        c.groups = []
        for g in ss {
            c.groups = addFrag(c.groups, Frag{s: g, args: args})
        }
        return Grouped<T, K>{c: c, ent: this.ent}
    }

    // An aggregate (SUM, MIN, ...): empty 0 gives the zero value for an
    // empty set, 1 fails with NoElementsError.
    func scalar_<R>(s string, args []any, empty int, what string) Task<R!> {
        return query_scalar<T, R>(*this, s, args, empty, what)
    }

    // All(pred): NOT EXISTS (... WHERE NOT pred).
    func all_(s string, args []any) Task<bool!> {
        return query_all(*this, s, args)
    }

    // ExecuteUpdate: UPDATE ... SET (generated) WHERE ...
    func update_(s string, args []any) Task<int!> {
        return query_update(*this, s, args)
    }

    // The WHERE of a set-based statement (a key subquery for paged or
    // joined queries).
    func setScope(w *sqlw) {
        var m = this.c.meta
        if this.c.paged() || len(this.c.joins) > 0 || this.c.hasSrc() {
            if m.Key < 0 {
                return
            }
            var k = quoteIdent(m.Columns[m.Key].Name)
            w.raw(" WHERE t0." + k + " IN (SELECT t0." + k)
            this.c.from(w)
            this.c.orderBy(w, "")
            this.c.paging(w)
            w.raw(")")
            return
        }
        this.c.whereGroup(w)
    }

    // ExecuteUpdate returning a value of every updated row (UPDATE ...
    // RETURNING; PostgreSQL, SQLite 3.35+).
    func ExecuteUpdateReturning<R>(f func(Setters<T>) Setters<T>, sel expr<func(*T) R>) Task<[]R!> {
        selectCheck<R>()
        var s = f(Setters<T>{items: []})
        var q = *this
        var u = updateParts(q.c.st, q.ent.em, s.items)
        if u.err != "" && q.c.err == "" {
            q.c.err = u.err
        }
        var pl = selectPlan(q.c.st, q.ent.em, sel)
        if pl.err != "" && q.c.err == "" {
            q.c.err = pl.err
        }
        return query_returning<T, R>(q, "UPDATE", Frag{s: u.s, args: u.args}, Frag{s: pl.s, args: planArgs(pl, &sel)}, rowMapper<R>(pl.shape))
    }

    // ExecuteDelete returning a value of every deleted row (DELETE ...
    // RETURNING; PostgreSQL, SQLite 3.35+).
    func ExecuteDeleteReturning<R>(sel expr<func(*T) R>) Task<[]R!> {
        selectCheck<R>()
        var q = *this
        var pl = selectPlan(q.c.st, q.ent.em, sel)
        if pl.err != "" && q.c.err == "" {
            q.c.err = pl.err
        }
        return query_returning<T, R>(q, "DELETE", Frag{s: "", args: []}, Frag{s: pl.s, args: planArgs(pl, &sel)}, rowMapper<R>(pl.shape))
    }

    // Deletes the matching rows (set-based, without loading or tracking);
    // returns the number of rows deleted.
    func ExecuteDelete() Task<int!> {
        return query_ExecuteDelete(*this)
    }

    // The SELECT statement of the query (with $n or ? placeholders).
    func ToSql() string {
        if this.c.err != "" {
            return "-- " + this.c.err
        }
        var w = this.c.writer()
        this.writeSelect(&w)
        return w.text()
    }

    // The arguments of ToSql's statement.
    func Args() []any {
        var w = this.c.writer()
        this.writeSelect(&w)
        return w.args
    }

    func subquery_() subq {
        return subq{c: this.c, em: this.ent.em, sel: entityCols(this.c.st, this.c.meta)}
    }

    // One row per distinct key, the first in the query's order
    // (PostgreSQL DISTINCT ON; order by the key first): DistinctOn((o) =>
    // o.UserId).OrderBy((o) => (o.UserId, o.Date)).
    func DistinctOn(key expr<func(*T) any>) Query<T> {
        var d = this.c.st.d
        if !d.DistinctOn() {
            return this.fail("data: DistinctOn (DISTINCT ON) is not supported by " + d.Name())
        }
        var root = key.Root()
        var cx = newTcx(this.c.st, root, 0)
        cx.bindEntity(0, this.ent.em, "t0")
        var q = *this
        try {
            var keys = keyValues(cx, root)?
            if len(cx.args) > 0 {
                return this.fail("data: DistinctOn keys must be columns or expressions of the row without values")
            }
            var ks []string = []
            for k in keys {
                ks = append(ks, k.s)
            }
            var e = q.c.ext()
            e.distinctOn = strings.Join(ks, ", ")
            q.c.x = e
            q.c.distinct = true
        } catch err {
            return this.fail(err.Message())
        }
        return q
    }

    // Locks the selected rows for update (SELECT ... FOR UPDATE).
    func ForUpdate() Query<T> {
        return this.locked("update", this.c.ext().lockWait)
    }

    // Locks the selected rows against updates (FOR SHARE).
    func ForShare() Query<T> {
        return this.locked("share", this.c.ext().lockWait)
    }

    // With ForUpdate/ForShare: rows locked by others are skipped.
    func SkipLocked() Query<T> {
        return this.locked(this.c.ext().lockMode, "skip locked")
    }

    // With ForUpdate/ForShare: fail instead of waiting for a lock.
    func NoWait() Query<T> {
        return this.locked(this.c.ext().lockMode, "nowait")
    }

    func locked(mode string, wait string) Query<T> {
        var q = *this
        var e = q.c.ext()
        e.lockMode = mode
        e.lockWait = wait
        if mode == "" {
            mode = "update"
        }
        try {
            e.lockSql = this.c.st.d.Lock(mode, wait)?
        } catch err {
            return this.fail(err.Message())
        }
        q.c.x = e
        return q
    }

    // The rows of both queries without duplicates (UNION).
    func Union(other Query<T>) Query<T> {
        return setQuery(*this, "UNION", other)
    }

    // The rows of both queries (UNION ALL).
    func UnionAll(other Query<T>) Query<T> {
        return setQuery(*this, "UNION ALL", other)
    }

    // The rows in both queries (INTERSECT).
    func Intersect(other Query<T>) Query<T> {
        return setQuery(*this, "INTERSECT", other)
    }

    // The rows not in other (EXCEPT).
    func Except(other Query<T>) Query<T> {
        return setQuery(*this, "EXCEPT", other)
    }

    // The query as a named common table expression: FROM (WITH "name" AS
    // (...) SELECT * FROM "name") AS t0.
    func AsCte(name string) Query<T> {
        var w = markWriter(this.c.st)
        this.c.selectSql(&w, entityCols(this.c.st, this.c.meta))
        var q = *this
        q.c = cteCore(this.c, name, Frag{s: w.text(), args: w.args}, false)
        q.includes = []
        return q
    }

    // A recursive query (WITH RECURSIVE): the rows of this query and,
    // repeatedly, the rows of the table related by step to a row found so
    // far, without duplicates (so cycles end): the subtree of a category is
    // ctx.Categories.Where((c) => c.Id == root).Recursive((child, parent) =>
    // child.ParentId == parent.Id).
    func Recursive(step expr<func(*T, *T) bool>) Query<T> {
        var cte = this.c.meta.Table + "_tree"
        var q = *this
        q.includes = []
        try {
            var body = recursiveBody(this.c, this.ent.em, step.Root(), cte)?
            q.c = cteCore(this.c, cte, body, true)
        } catch err {
            q.c.err = err.Message()
        }
        return q
    }

    func joined() bool {
        return len(this.includes) > 0 && !this.split
    }

    func writeSelect(w *sqlw) {
        if !this.joined() {
            this.c.selectSql(w, entityCols(this.c.st, this.c.meta))
            return
        }
        var m = this.c.meta
        w.raw("SELECT ")
        w.raw(this.c.st.cols(m))
        for inc in this.includes {
            w.raw(", " + inc.cols)
        }
        var key = ""
        if m.Key >= 0 {
            key = "t0." + quoteIdent(m.Columns[m.Key].Name)
        }
        if this.c.paged() || this.c.distinct || this.c.hasSrc() {
            w.raw(" FROM (")
            this.c.selectSql(w, entityCols(this.c.st, m))
            w.raw(") AS t0")
            for inc in this.includes {
                w.frag(inc.join)
            }
        } else {
            w.raw(" FROM " + quoteIdent(m.Table) + " AS t0")
            for j in this.c.joins {
                w.frag(j)
            }
            for inc in this.includes {
                w.frag(inc.join)
            }
            this.c.whereGroup(w)
        }
        this.c.orderBy(w, key)
        if this.c.x != nil && this.c.x.lockSql != "" {
            w.raw(this.c.x.lockSql)
        }
    }

    // Runs the query: the entities in order (tracked ones are the
    // instances the context already tracks).
    func ToList() Task<[]*T!> {
        return query_ToList(*this)
    }

    // The first entity (NoElementsError if there is none).
    func First(p ...expr<func(*T) bool>) Task<*T!> {
        if len(p) == 0 {
            return query_First(*this)
        }
        if len(p) == 1 {
            return query_First(this.Where(p[0]))
        }
        return query_First(this.filtered(p))
    }

    // The first entity, or nil.
    func FirstOrDefault(p ...expr<func(*T) bool>) Task<*T!> {
        if len(p) == 0 {
            return query_FirstOrDefault(*this)
        }
        if len(p) == 1 {
            return query_FirstOrDefault(this.Where(p[0]))
        }
        return query_FirstOrDefault(this.filtered(p))
    }

    // The only entity (an error if there is none or more than one).
    func Single(p ...expr<func(*T) bool>) Task<*T!> {
        if len(p) == 0 {
            return query_Single(*this)
        }
        if len(p) == 1 {
            return query_Single(this.Where(p[0]))
        }
        return query_Single(this.filtered(p))
    }

    // The only entity or nil (an error if there is more than one).
    func SingleOrDefault(p ...expr<func(*T) bool>) Task<*T!> {
        if len(p) == 0 {
            return query_SingleOrDefault(*this)
        }
        if len(p) == 1 {
            return query_SingleOrDefault(this.Where(p[0]))
        }
        return query_SingleOrDefault(this.filtered(p))
    }

    // Number of matching rows (SELECT COUNT(*)).
    func Count(p ...expr<func(*T) bool>) Task<int!> {
        if len(p) == 0 {
            return query_Count(*this)
        }
        if len(p) == 1 {
            return query_Count(this.Where(p[0]))
        }
        return query_Count(this.filtered(p))
    }

    // Whether any row matches (SELECT EXISTS).
    func Any(p ...expr<func(*T) bool>) Task<bool!> {
        if len(p) == 0 {
            return query_Any(*this)
        }
        if len(p) == 1 {
            return query_Any(this.Where(p[0]))
        }
        return query_Any(this.filtered(p))
    }
}

async func query_scalar<T, R>(q Query<T>, s string, args []any, empty int, what string) R! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    var w = q.c.writer()
    w.raw("SELECT ")
    w.frag(Frag{s: s, args: args})
    q.c.source(&w)
    var rows = await q.c.st.all(w.text(), w.args)?
    var r R
    if len(rows) == 0 || len(rows[0]) == 0 || rows[0][0] == nil {
        if empty == 1 {
            return NoElementsError{What: what}
        }
        return r
    }
    database.sql.convertInto(&r, rows[0][0], what)?
    return r
}

async func query_all<T>(q Query<T>, s string, args []any) bool! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    var q2 = q.where_("NOT (" + s + ")", args)
    return !await q2.c.exists(entityCols(q2.c.st, q2.c.meta))?
}

async func query_update<T>(q Query<T>, s string, args []any) int! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    var w = q.c.writer()
    w.raw("UPDATE " + quoteIdent(q.c.meta.Table) + " AS t0 SET ")
    w.frag(Frag{s: s, args: args})
    q.setScope(&w)
    var r = await q.c.st.exec(w.text(), w.args)?
    return r.RowsAffected
}

async func query_returning<T, R>(q Query<T>, what string, set Frag, sel Frag, m func([]any, *R) void!) []R! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    var d = q.c.st.d
    if !d.Returning() {
        d.Require("returning")?
        return error("data: RETURNING is not supported by " + d.Name())
    }
    var w = q.c.writer()
    if what == "UPDATE" {
        w.raw("UPDATE " + quoteIdent(q.c.meta.Table) + " AS t0 SET ")
        w.frag(set)
    } else {
        w.raw("DELETE FROM " + quoteIdent(q.c.meta.Table) + " AS t0")
    }
    q.setScope(&w)
    // unqualified: SQLite's RETURNING does not see the alias t0
    w.raw(" RETURNING ")
    w.frag(Frag{s: strings.ReplaceAll(sel.s, "t0.", ""), args: sel.args})
    var rows = await q.c.st.all(w.text(), w.args)?
    var out []R = []
    for vals in rows {
        var r R
        m(vals, &r)?
        out = append(out, r)
    }
    return out
}

async func query_ExecuteDelete<T>(q Query<T>) int! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    var w = q.c.writer()
    w.raw("DELETE FROM " + quoteIdent(q.c.meta.Table) + " AS t0")
    q.setScope(&w)
    var r = await q.c.st.exec(w.text(), w.args)?
    return r.RowsAffected
}

async func query_ToList<T>(q Query<T>) []*T! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    var w = q.c.writer()
    q.writeSelect(&w)
    var rs = await q.c.st.rows(w.text(), w.args)?
    defer rs.Close()
    var out []*T = []
    var st = q.c.st
    if q.joined() {
        var m = q.c.meta
        var byKey = map[string]*T{}
        var seen = map[string]bool{}
        // rows are mapped as they arrive: the driver reuses its row
        // buffer, and materialize/attach copy what they keep
        for await rs.Next()? {
            var vals = rs.Values()
            var pk = keyText(vals[m.Key])
            var p = byKey[pk]
            if p == nil {
                p = materialize(st, q.ent, vals, 0, q.tracking)?
                byKey[pk] = p
                for inc in q.includes {
                    inc.reset(p)
                }
                out = append(out, p)
            }
            var off = len(m.Columns)
            for ii, inc in q.includes {
                var ck = vals[off + inc.childKey]
                if ck != nil {
                    var sk = pk + "/" + fmt.Format("{0}", ii) + "/" + keyText(ck)
                    if !seen[sk] {
                        seen[sk] = true
                        inc.attach(st, p, vals, off, q.tracking)?
                    }
                }
                off += inc.ncols
            }
        }
        return out
    }
    for await rs.Next()? {
        out = append(out, materialize(st, q.ent, rs.Values(), 0, q.tracking)?)
    }
    if len(q.includes) > 0 && len(out) > 0 {
        for inc in q.includes {
            await inc.load(st, out, q.tracking)?
        }
    }
    return out
}

// The first entity of q with LIMIT 1, or nil: a query with Include goes
// through ToList (joined rows), a plain one maps the single row directly.
async func query_firstRow<T>(q Query<T>) *T! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    if len(q.includes) > 0 {
        var xs = await q.Take(1).ToList()?
        if len(xs) == 0 {
            return nil
        }
        return xs[0]
    }
    var q1 = q
    q1.c.take = 1
    var w = q1.c.writer()
    q1.writeSelect(&w)
    var rs = await q1.c.st.rows(w.text(), w.args)?
    defer rs.Close()
    var p *T = nil
    for await rs.Next()? {
        if p == nil {
            p = materialize(q1.c.st, q1.ent, rs.Values(), 0, q1.tracking)?
        }
    }
    return p
}

async func query_First<T>(q Query<T>) *T! {
    var p = await query_firstRow(q)?
    if p == nil {
        return NoElementsError{What: "First " + q.c.meta.Entity}
    }
    return p
}

async func query_FirstOrDefault<T>(q Query<T>) *T! {
    return await query_firstRow(q)?
}

async func query_Single<T>(q Query<T>) *T! {
    var xs = await q.Take(2).ToList()?
    if len(xs) == 0 {
        return NoElementsError{What: "Single " + q.c.meta.Entity}
    }
    if len(xs) > 1 {
        return error("data: Single " + q.c.meta.Entity + ": the sequence contains more than one element")
    }
    return xs[0]
}

async func query_SingleOrDefault<T>(q Query<T>) *T! {
    var xs = await q.Take(2).ToList()?
    if len(xs) > 1 {
        return error("data: SingleOrDefault " + q.c.meta.Entity + ": the sequence contains more than one element")
    }
    if len(xs) == 0 {
        return nil
    }
    return xs[0]
}

async func query_Count<T>(q Query<T>) int! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    return await q.c.count(entityCols(q.c.st, q.c.meta))?
}

async func query_Any<T>(q Query<T>) bool! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    return await q.c.exists(entityCols(q.c.st, q.c.meta))?
}

// The rows of a projection (Select, Join, GroupBy(...).Select).
struct Projection<R> {
    c   core
    sel Frag
    m   func([]any, *R) void!

    func Skip(n int) Projection<R> {
        var q = *this
        q.c.skip = n
        return q
    }

    func Take(n int) Projection<R> {
        var q = *this
        q.c.take = n
        return q
    }

    func Distinct() Projection<R> {
        var q = *this
        q.c.distinct = true
        return q
    }

    func ToSql() string {
        if this.c.err != "" {
            return "-- " + this.c.err
        }
        var w = this.c.writer()
        this.c.selectSql(&w, this.sel)
        return w.text()
    }

    func Args() []any {
        var w = this.c.writer()
        this.c.selectSql(&w, this.sel)
        return w.args
    }

    func subquery_() subq {
        return subq{c: this.c, em: nil, sel: this.sel}
    }

    func Union(other Projection<R>) Projection<R> {
        return setProjection(*this, "UNION", other)
    }

    func UnionAll(other Projection<R>) Projection<R> {
        return setProjection(*this, "UNION ALL", other)
    }

    func Intersect(other Projection<R>) Projection<R> {
        return setProjection(*this, "INTERSECT", other)
    }

    func Except(other Projection<R>) Projection<R> {
        return setProjection(*this, "EXCEPT", other)
    }

    func ToList() Task<[]R!> {
        return projection_ToList(*this)
    }

    func First() Task<R!> {
        return projection_First(*this)
    }

    // The first row, or the zero value.
    func FirstOrDefault() Task<R!> {
        return projection_FirstOrDefault(*this)
    }

    func Single() Task<R!> {
        return projection_Single(*this)
    }

    func Count() Task<int!> {
        return projection_Count(*this)
    }

    func Any() Task<bool!> {
        return projection_Any(*this)
    }

    // Filtering and ordering apply to entities: after Select they are an
    // error at compile time (raised when used).
    func Where(p expr<func(R) bool>) Projection<R> {
        reflect.Error("data: Where after Select: the projection's columns are not entities; apply Where before Select")
    }

    func OrderBy(key expr<func(R) any>) Projection<R> {
        reflect.Error("data: OrderBy after Select: the projection's columns are not entities; apply OrderBy before Select")
    }

    func OrderByDescending(key expr<func(R) any>) Projection<R> {
        reflect.Error("data: OrderByDescending after Select: the projection's columns are not entities; apply OrderByDescending before Select")
    }
}

async func projection_ToList<R>(q Projection<R>) []R! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    if q.c.needs() != "" {
        q.c.st.d.Require(q.c.needs())?
    }
    var w = q.c.writer()
    q.c.selectSql(&w, q.sel)
    var rows = await q.c.st.all(w.text(), w.args)?
    var out []R = []
    for vals in rows {
        var r R
        q.m(vals, &r)?
        out = append(out, r)
    }
    return out
}

async func projection_First<R>(q Projection<R>) R! {
    var xs = await q.Take(1).ToList()?
    if len(xs) == 0 {
        return NoElementsError{What: "First"}
    }
    return xs[0]
}

async func projection_FirstOrDefault<R>(q Projection<R>) R! {
    var xs = await q.Take(1).ToList()?
    var r R
    if len(xs) > 0 {
        r = xs[0]
    }
    return r
}

async func projection_Single<R>(q Projection<R>) R! {
    var xs = await q.Take(2).ToList()?
    if len(xs) != 1 {
        if len(xs) == 0 {
            return NoElementsError{What: "Single"}
        }
        return error("data: Single: the sequence contains more than one element")
    }
    return xs[0]
}

async func projection_Count<R>(q Projection<R>) int! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    return await q.c.count(q.sel)?
}

async func projection_Any<R>(q Projection<R>) bool! {
    if q.c.err != "" {
        return error(q.c.err)
    }
    return await q.c.exists(q.sel)?
}

// GroupBy(key): finished by Select((g) => (g.Key, g.Count(), g.Sum(...)));
// Where on a group is HAVING.
struct Grouped<T, K> {
    c   core
    ent *Entity<T>

    func having_(s string, args []any) Grouped<T, K> {
        var q = *this
        q.c.havings = addFrag(q.c.havings, Frag{s: s, args: args})
        return q
    }

    func order_(s string, args []any, then bool) Grouped<T, K> {
        var q = *this
        if !then {
            q.c.orders = []
        }
        q.c.orders = addFrag(q.c.orders, Frag{s: s, args: args})
        return q
    }

    func fail(msg string) Grouped<T, K> {
        var q = *this
        if q.c.err == "" {
            q.c.err = msg
        }
        return q
    }

    // g.Key in the lambdas: the GROUP BY fragments ({#i}).
    func keys() []sv {
        var out []sv = []
        var kt = reflect.TypeOf<K>()
        if kt.Kind == reflect.Kind.Tuple {
            for i, f in kt.Fields {
                var m = "{#" + strconv.Itoa(i) + "}"
                out = append(out, sv{s: m, t: f.Type})
            }
        } else {
            out = append(out, sv{s: "{#0}", t: kt})
        }
        return out
    }

    // HAVING: Where((g) => g.Sum((o) => o.Qty) > 3).
    func Where(p expr<func(Group<K, T>) bool>) Grouped<T, K> {
        var pl = groupPlan(this.c.st, this.ent.em, this.keys(), p, 0)
        if pl.err != "" {
            return this.fail(pl.err)
        }
        return this.having_(pl.s, planArgs(pl, &p))
    }

    func OrderBy(key expr<func(Group<K, T>) any>) Grouped<T, K> {
        return this.ordered(key, 1, false)
    }

    func OrderByDescending(key expr<func(Group<K, T>) any>) Grouped<T, K> {
        return this.ordered(key, 2, false)
    }

    func ThenBy(key expr<func(Group<K, T>) any>) Grouped<T, K> {
        return this.ordered(key, 1, true)
    }

    func ThenByDescending(key expr<func(Group<K, T>) any>) Grouped<T, K> {
        return this.ordered(key, 2, true)
    }

    func ordered(key expr<func(Group<K, T>) any>, what int, then bool) Grouped<T, K> {
        var pl = groupPlan(this.c.st, this.ent.em, this.keys(), key, what)
        if pl.err != "" {
            return this.fail(pl.err)
        }
        return this.order_(pl.s, planArgs(pl, &key), then)
    }

    // The values of every group: Select((g) => (g.Key, g.Count())).
    func Select<R>(f expr<func(Group<K, T>) R>) Projection<R> {
        selectCheck<R>()
        var pl = groupPlan(this.c.st, this.ent.em, this.keys(), f, 3)
        var c = this.c
        if pl.err != "" && c.err == "" {
            c.err = pl.err
        }
        return Projection<R>{c: c, sel: Frag{s: pl.s, args: planArgs(pl, &f)}, m: rowMapper<R>(pl.shape)}
    }

    // Groups are only read through Select (an error at compile time, raised
    // when used).
    func ToList() Task<[]T!> {
        reflect.Error("data: ToList on a GroupBy: select the group values first, e.g. .Select((g) => (g.Key, g.Count()))")
    }

    func First() Task<T!> {
        reflect.Error("data: First on a GroupBy: select the group values first, e.g. .Select((g) => (g.Key, g.Count()))")
    }

    func Count() Task<int!> {
        reflect.Error("data: Count on a GroupBy: select the group values first, e.g. .Select((g) => (g.Key, g.Count()))")
    }

    func ToSql() string {
        reflect.Error("data: ToSql on a GroupBy: select the group values first, e.g. .Select((g) => (g.Key, g.Count()))")
    }
}

// A group in the lambdas of GroupBy(...).Where/OrderBy/Select: its key and
// aggregates over its rows (translated to SQL; also usable in memory).
struct Group<K, T> {
    Key   K
    items []*T

    // COUNT(*).
    @expr.call
    func Count() int {
        return len(this.items)
    }

    // SUM of a value of the rows.
    @expr.call
    func Sum<N: Add>(f func(*T) N) N {
        numberCheck<N>("Sum")
        var s N
        for x in this.items {
            s = s + f(x)
        }
        return s
    }

    @expr.call
    func Min<N: Ordered>(f func(*T) N) N {
        var m N
        for i, x in this.items {
            var v = f(x)
            if i == 0 || v < m {
                m = v
            }
        }
        return m
    }

    @expr.call
    func Max<N: Ordered>(f func(*T) N) N {
        var m N
        for i, x in this.items {
            var v = f(x)
            if i == 0 || v > m {
                m = v
            }
        }
        return m
    }

    // AVG of a value of the rows.
    @expr.call
    func Average<N>(f func(*T) N) float {
        numberCheck<N>("Average")
        var s = 0.0
        for x in this.items {
            s += toFloat(f(x))
        }
        if len(this.items) == 0 {
            return 0.0
        }
        return s / float(len(this.items))
    }
}

// Client-side operators after AsEnumerable(): the query runs as it is,
// the functions filter in memory.
struct Enumerable<T> {
    q       Query<T>
    filters []func(*T) bool

    func Where(f func(*T) bool) Enumerable<T> {
        var e = *this
        var fs []func(*T) bool = []
        for x in e.filters {
            fs = append(fs, x)
        }
        fs = append(fs, f)
        e.filters = fs
        return e
    }

    func ToList() Task<[]*T!> {
        return enumerable_ToList(*this)
    }

    func First() Task<*T!> {
        return enumerable_First(*this)
    }

    func Count() Task<int!> {
        return enumerable_Count(*this)
    }
}

async func enumerable_ToList<T>(q Enumerable<T>) []*T! {
    var xs = await q.q.ToList()?
    var out []*T = []
    for x in xs {
        var ok = true
        for f in q.filters {
            if ok && !f(x) {
                ok = false
            }
        }
        if ok {
            out = append(out, x)
        }
    }
    return out
}

async func enumerable_First<T>(q Enumerable<T>) *T! {
    var xs = await q.ToList()?
    if len(xs) == 0 {
        return NoElementsError{What: "First"}
    }
    return xs[0]
}

async func enumerable_Count<T>(q Enumerable<T>) int! {
    var xs = await q.ToList()?
    return len(xs)
}

// The entities of m whose column col is one of keys (split includes,
// explicit loading).
async func loadIn<T>(st *ctxState, ent *Entity<T>, col string, keys []any, tracking bool) []*T! {
    var out []*T = []
    var uniq []any = []
    var seen = map[string]bool{}
    for k in keys {
        if k != nil {
            var t = keyText(k)
            if !seen[t] {
                seen[t] = true
                uniq = append(uniq, k)
            }
        }
    }
    if len(uniq) == 0 {
        return out
    }
    var w = sqlw{d: st.d, b: strings.Builder{}, args: [], groups: [], qmark: st.qmark}
    w.raw("SELECT " + columnList(ent.Meta, "t0") + " FROM " + quoteIdent(ent.Meta.Table) + " AS t0 WHERE t0." + quoteIdent(col) + " IN (")
    w.list(uniq)
    w.raw(")")
    if ent.Meta.Key >= 0 {
        w.raw(" ORDER BY t0." + quoteIdent(ent.Meta.Columns[ent.Meta.Key].Name))
    }
    var rows = await st.all(w.text(), w.args)?
    for vals in rows {
        out = append(out, materialize(st, ent, vals, 0, tracking)?)
    }
    return out
}

// Entities of a many-to-many navigation with the owner key of each.
struct linked<T> {
    items  []*T
    owners []string
}

async func loadThrough<T>(st *ctxState, ent *Entity<T>, through string, ownerCol string, targetCol string, keys []any, tracking bool) linked<T>! {
    var out = linked<T>{items: [], owners: []}
    var uniq []any = []
    var seen = map[string]bool{}
    for k in keys {
        if k != nil && !seen[keyText(k)] {
            seen[keyText(k)] = true
            uniq = append(uniq, k)
        }
    }
    if len(uniq) == 0 || ent.Meta.Key < 0 {
        return out
    }
    var w = sqlw{d: st.d, b: strings.Builder{}, args: [], groups: [], qmark: st.qmark}
    var k = quoteIdent(ent.Meta.Columns[ent.Meta.Key].Name)
    w.raw("SELECT " + columnList(ent.Meta, "t0") + ", j." + quoteIdent(ownerCol) + " FROM " + quoteIdent(ent.Meta.Table) + " AS t0 JOIN " + quoteIdent(through) + " AS j ON j." + quoteIdent(targetCol) + " = t0." + k + " WHERE j." + quoteIdent(ownerCol) + " IN (")
    w.list(uniq)
    w.raw(") ORDER BY t0." + k)
    var rows = await st.all(w.text(), w.args)?
    var n = len(ent.Meta.Columns)
    for vals in rows {
        out.items = append(out.items, materialize(st, ent, vals, 0, tracking)?)
        out.owners = append(out.owners, keyText(vals[n]))
    }
    return out
}

// ---- query lambdas: helpers -----------------------------------------------------

// Select's result type must be a value (compile-time check).
func selectCheck<R>() {
    if reflect.TypeOf<R>().Kind == reflect.Kind.Slice && reflect.TypeOf<R>().Elem.Kind != reflect.Kind.Uint8 {
        reflect.Error("data: Select: a collection (" + reflect.TypeOf<R>().Name + ") is not a value: select len(...), data.Count(...) or data.Any(...)")
    }
    if reflect.TypeOf<R>().Kind == reflect.Kind.Pointer &&
        reflect.TypeOf<R>().Elem.Kind == reflect.Kind.Struct &&
        reflect.TypeOf<R>().Elem != reflect.TypeOf<time.Time>() &&
        reflect.TypeOf<R>().Elem != reflect.TypeOf<math.big.Decimal>() {
        reflect.Error("data: Select: an entity (" + reflect.TypeOf<R>().Name + ") is not a value: select its columns")
    }
}

// Sum and Average need numbers (compile-time check).
func numberCheck<N>(what string) {
    if !(reflect.TypeOf<N>().Kind == reflect.Kind.Int ||
        reflect.TypeOf<N>().Kind == reflect.Kind.Int8 ||
        reflect.TypeOf<N>().Kind == reflect.Kind.Int16 ||
        reflect.TypeOf<N>().Kind == reflect.Kind.Int32 ||
        reflect.TypeOf<N>().Kind == reflect.Kind.Uint ||
        reflect.TypeOf<N>().Kind == reflect.Kind.Uint8 ||
        reflect.TypeOf<N>().Kind == reflect.Kind.Uint16 ||
        reflect.TypeOf<N>().Kind == reflect.Kind.Uint32 ||
        reflect.TypeOf<N>().Kind == reflect.Kind.Float ||
        reflect.TypeOf<N>().Kind == reflect.Kind.Float32 ||
        reflect.TypeOf<N>() == reflect.TypeOf<math.big.Decimal>() ||
        (reflect.TypeOf<N>().Kind == reflect.Kind.Pointer &&
            (reflect.TypeOf<N>().Elem.Kind == reflect.Kind.Int ||
                reflect.TypeOf<N>().Elem.Kind == reflect.Kind.Int32 ||
                reflect.TypeOf<N>().Elem.Kind == reflect.Kind.Float))) {
        reflect.Error("data: Sum and Average need a number, found " + reflect.TypeOf<N>().Name)
    }
}

// The row mapper of a projection of shape sh.
func rowMapper<R>(sh *rowShape) func([]any, *R) void! {
    return func(vals []any, r *R) void! {
        if sh == nil {
            return error("data: the projection could not be translated")
        }
        mapRow<R>(sh, vals, r)?
    }
}

func toFloat(v any) float {
    switch v {
    case int n:
        return float(n)
    case float f:
        return f
    case int32 n:
        return float(n)
    case float32 f:
        return float(f)
    }
    return 0.0
}

// The join fragment and the result selection of Join.
func joinInto(kw string, st *ctxState, outer *entModel, inner *entModel, ok *expr.Node, ik *expr.Node, res *expr.Node, j *plan, p *plan) void! {
    var cx1 = newTcx(st, ok, 0)
    cx1.bindEntity(0, outer, "t0")
    var oks = keyValues(cx1, ok)?
    var cx2 = newTcx(st, ik, len(cx1.args))
    cx2.bindEntity(0, inner, "t1")
    var iks = keyValues(cx2, ik)?
    if len(oks) != len(iks) {
        return untranslatable("the outer and inner keys of Join must have the same number of values")
    }
    j.s = kw + quoteIdent(inner.meta.Table) + " AS t1 ON "
    for i, a in oks {
        if i > 0 {
            j.s = j.s + " AND "
        }
        j.s = j.s + a.s + " = " + iks[i].s
    }
    j.vals = treeArgs(cx1, cxValues(cx1, ok))
    for a in treeArgs(cx2, cxValues(cx2, ik)) {
        j.vals = append(j.vals, a)
    }
    var cx3 = newTcx(st, res, 0)
    cx3.bindEntity(0, outer, "t0")
    cx3.bindEntity(1, inner, "t1")
    projection(cx3, res, p)?
    p.vals = treeArgs(cx3, cxValues(cx3, res))
}

// The result selection of CrossJoin.
func crossInto(st *ctxState, outer *entModel, inner *entModel, res *expr.Node, p *plan) void! {
    var cx = newTcx(st, res, 0)
    cx.bindEntity(0, outer, "t0")
    cx.bindEntity(1, inner, "t1")
    projection(cx, res, p)?
    p.vals = treeArgs(cx, cxValues(cx, res))
}

// A value of an outer-joined row that may be missing: selected as a
// pointer (nil for NULL), data.Nullable(o.Total) is *float.
@expr.call
func Nullable<V>(v V) *V {
    var x = v
    return &x
}

// The arguments of the markers of cx over the tree's values.
func treeArgs(cx *tcx, vals []any) []any {
    var out []any = []
    for i, o in cx.args {
        if cx.lists[i] {
            out = append(out, listValue(vals[o]))
        } else {
            out = append(out, argValue(vals[o]))
        }
    }
    return out
}

// One assignment of ExecuteUpdate: a constant (its driver value) or a
// tree over the row.
struct setter {
    col    string
    value  any
    isTree bool
    tree   *expr.Node
    vals   []any
}

// The assignments of ExecuteUpdate: s.Set((u) => u.Done, true) or
// s.SetWith((u) => u.N, (u) => u.N + 1).
struct Setters<T> {
    items []setter

    // Sets a column to a value.
    func Set<V>(col expr<func(*T) V>, value V) Setters<T> {
        var s = *this
        var v any = nil
        if reflect.TypeOf<V>().Kind == reflect.Kind.Enum {
            v = fmt.Format("{0}", value)
        } else if reflect.TypeOf<V>().Kind == reflect.Kind.Slice && reflect.TypeOf<V>().Elem.Kind != reflect.Kind.Uint8 {
            v = arrayArg(value)
        } else if reflect.TypeOf<V>().Kind == reflect.Kind.Map ||
            (reflect.TypeOf<V>().Kind == reflect.Kind.Struct &&
                reflect.TypeOf<V>() != reflect.TypeOf<time.Time>() &&
                reflect.TypeOf<V>() != reflect.TypeOf<math.big.Decimal>() &&
                reflect.TypeOf<V>() != reflect.TypeOf<encoding.json.Value>()) {
            v = encoding.json.Format(value)
        } else {
            v = database.sql.argOf(value)
        }
        s.items = appendSetter(s.items, setter{col: paramField(col.Root()), value: v, isTree: false, tree: nil, vals: []})
        return s
    }

    // Sets a column to an expression over the row.
    func SetWith<V>(col expr<func(*T) V>, value expr<func(*T) V>) Setters<T> {
        var s = *this
        var root = value.Root()
        s.items = appendSetter(s.items, setter{col: paramField(col.Root()), value: nil, isTree: true, tree: root, vals: expr.Values(root)})
        return s
    }
}

func appendSetter(xs []setter, x setter) []setter {
    var out []setter = []
    for y in xs {
        out = append(out, y)
    }
    out = append(out, x)
    return out
}

// The SET list of ExecuteUpdate.
struct updParts {
    s    string
    args []any
    err  string
}

func updateParts(st *ctxState, em *entModel, items []setter) updParts {
    var u = updParts{s: "", args: [], err: ""}
    try updateInto(st, em, items, &u) catch err {
        u.err = err.Message()
    }
    return u
}

func updateInto(st *ctxState, em *entModel, items []setter, u *updParts) void! {
    if len(items) == 0 {
        return error("data: ExecuteUpdate needs at least one s.Set(...)")
    }
    for i, it in items {
        if i > 0 {
            u.s = u.s + ", "
        }
        var ci = em.colOf(it.col)
        if ci < 0 {
            return error("data: the first argument of Set selects one column of " + em.meta.Entity + ": (u) => u.Name")
        }
        var c = em.meta.Columns[ci]
        if c.Key {
            return error("data: the key " + c.Field + " cannot be updated")
        }
        var lhs = quoteIdent(c.Name) + " = "
        if it.isTree {
            var cx = newTcx(st, it.tree, len(u.args))
            cx.bindEntity(0, em, "t0")
            var v = trValue(cx, it.tree)?
            u.s = u.s + lhs + v.s
            for a in treeArgs(cx, cxValues(cx, it.tree)) {
                u.args = append(u.args, a)
            }
        } else {
            if it.value == nil && !c.Nullable {
                return error("data: " + c.Field + " is not nullable")
            }
            var m = "{?" + strconv.Itoa(len(u.args)) + "}"
            u.s = u.s + lhs + m
            u.args = append(u.args, it.value)
        }
    }
}

// ---- navigations in query lambdas ---------------------------------------------------
//
// Translated to correlated subqueries (data.Any(u.Orders, (o) => o.Total >
// 100) is EXISTS (SELECT 1 FROM "orders" ...)); the functions also work in
// memory. len(u.Orders) is the COUNT(*) subquery.

// Whether p holds for some element of xs.
@expr.call
func Any<E>(xs []E, p func(E) bool) bool {
    for x in xs {
        if p(x) {
            return true
        }
    }
    return false
}

// Whether p holds for every element of xs.
@expr.call
func All<E>(xs []E, p func(E) bool) bool {
    for x in xs {
        if !p(x) {
            return false
        }
    }
    return true
}

// The number of elements of xs for which p holds.
@expr.call
func Count<E>(xs []E, p func(E) bool) int {
    var n = 0
    for x in xs {
        if p(x) {
            n += 1
        }
    }
    return n
}

// The sum of f over xs.
@expr.call
func Sum<E, N: Add>(xs []E, f func(E) N) N {
    numberCheck<N>("Sum")
    var s N
    for x in xs {
        s = s + f(x)
    }
    return s
}

@expr.call
func Min<E, N: Ordered>(xs []E, f func(E) N) N {
    var m N
    for i, x in xs {
        var v = f(x)
        if i == 0 || v < m {
            m = v
        }
    }
    return m
}

@expr.call
func Max<E, N: Ordered>(xs []E, f func(E) N) N {
    var m N
    for i, x in xs {
        var v = f(x)
        if i == 0 || v > m {
            m = v
        }
    }
    return m
}

// The average of f over xs.
@expr.call
func Average<E, N>(xs []E, f func(E) N) float {
    numberCheck<N>("Average")
    var s = 0.0
    for x in xs {
        s += toFloat(f(x))
    }
    if len(xs) == 0 {
        return 0.0
    }
    return s / float(len(xs))
}
