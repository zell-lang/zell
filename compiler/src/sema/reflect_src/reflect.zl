namespace reflect

// Kind of a type (TypeInfo.Kind). `int64` is `int`, `uint64` is `Uint`,
// `byte` is `Uint8`, `float64` is `Float`.
enum Kind {
    Invalid
    Void
    Bool
    Int
    Int8
    Int16
    Int32
    Uint
    Uint8
    Uint16
    Uint32
    Float
    Float32
    Char
    String
    Error
    Any
    Interface
    Struct
    Enum
    Pointer
    Weak
    Slice
    Array
    Map
    Tuple
    Func
    Fallible
    Task
}

// Declaration kinds for @attribute(targets: [...]).
enum Target {
    Namespace
    Struct
    Interface
    Enum
    Variant
    Field
    Func
    Param
}

// Values of the builtin attributes (f.Attribute<json>()).
struct json {
    name      string = ""
    omitEmpty bool = false
    skip      bool = false
}

struct deprecated {
    message string = ""
}

// @log(skip: true): log leaves the field out of `{@X}` (named
// logAttr so that it does not clash with the namespace log; the
// compiler maps @log to it).
struct logAttr {
    skip bool = false
}

// @csv, @xml, @yaml, @toml: field mappings of the encoding.* codecs
// (named ...Attr so that they do not clash with those namespaces); @serde
// is the format-independent fallback every codec reads after its own.
struct csvAttr {
    name      string = ""
    index     int = -1
    skip      bool = false
    omitEmpty bool = false
}

struct xmlAttr {
    name      string = ""
    attr      bool = false
    text      bool = false
    omitEmpty bool = false
    ns        string = ""
    skip      bool = false
}

struct yamlAttr {
    name      string = ""
    omitEmpty bool = false
    skip      bool = false
    flow      bool = false
}

struct tomlAttr {
    name      string = ""
    omitEmpty bool = false
    skip      bool = false
    inline    bool = false
}

struct serde {
    name      string = ""
    omitEmpty bool = false
    skip      bool = false
}

struct inline {}

struct test {}

// The static description of a type. The first three words are the
// runtime's zell_type_info header (runtime/ABI.md section 17).
struct TypeInfo {
    rtName   int
    rtSize   int
    rtDrop   int
    Kind     Kind
    Name     string
    FullName string
    Size     int
    Align    int
    Fields   []*FieldInfo
    Methods  []*MethodInfo
    Variants []*VariantInfo
    Elem     *TypeInfo
    Key      *TypeInfo
    Len      int
    attrs    []any
    ptrTo    *TypeInfo
    canon    *TypeInfo
    // Namespace path of the declaration (empty for builtin and composite types).
    Package  string

    // Attribute returns the attribute of type A on the type, or nil.
    func Attribute<A>() *A {
        return attrOf<A>(this.attrs)
    }

    // Attributes returns every attribute of type A on the type.
    func Attributes<A>() []*A {
        return attrsOf<A>(this.attrs)
    }

    // Field returns the field called name, or nil.
    func Field(name string) *FieldInfo {
        for f in this.Fields {
            if f.Name == name {
                return f
            }
        }
        return nil
    }

    // Method returns the method called name, or nil.
    func Method(name string) *MethodInfo {
        for m in this.Methods {
            if m.Name == name {
                return m
            }
        }
        return nil
    }

    // Variant returns the enum variant called name, or nil.
    func Variant(name string) *VariantInfo {
        for v in this.Variants {
            if v.Name == name {
                return v
            }
        }
        return nil
    }

    // New returns a pointer to a new zero value of the type (as `any`); it panics if the type cannot be instantiated.
    func New() any {
        if this.ptrTo == nil {
            panic(
                "reflect: " +
                    this.Name +
                    ".New: no constructor metadata (name the type in reflect.TypeOf<T>(), typeof or mark it @reflect)",
            )
        }
        return newOf(this)
    }

    // Same reports whether both describe the same type.
    func Same(other *TypeInfo) bool {
        return sameType(this, other)
    }

    // String returns the type name.
    func String() string {
        return this.Name
    }
}

// FieldInfo describes a struct field.
struct FieldInfo {
    Name     string
    Type     *TypeInfo
    Offset   int
    Index    int
    Embedded bool
    Exported bool
    attrs    []any

    // Attribute returns the attribute of type A on the field, or nil.
    func Attribute<A>() *A {
        return attrOf<A>(this.attrs)
    }

    // Attributes returns every attribute of type A on the field.
    func Attributes<A>() []*A {
        return attrsOf<A>(this.attrs)
    }
}

// MethodInfo describes a method.
struct MethodInfo {
    Name   string
    Type   *TypeInfo
    Static bool
    invoke int
    fnval  int
    attrs  []any
    // The parameters without the receiver.
    Params []*ParamInfo

    // Attribute returns the attribute of type A on the method, or nil.
    func Attribute<A>() *A {
        return attrOf<A>(this.attrs)
    }

    // Attributes returns every attribute of type A on the method.
    func Attributes<A>() []*A {
        return attrsOf<A>(this.attrs)
    }

    // m.Call(recv, args...) is lowered to this: the arguments are boxed
    // into a []any; the result (if any) is boxed into an any.
    func Invoke(recv any, args []any) any! {
        return invokeMethod(this.invoke, recv, args)?
    }

    // Call returns the method as a function value of type F; it panics if F is not its type.
    func Call<F>() F {
        var want = TypeOf<F>()
        if want != this.Type {
            panic(
                "reflect: " +
                    this.Name +
                    ".Call<" +
                    want.Name +
                    ">: the method has type " +
                    this.Type.Name,
            )
        }
        return asFunc<F>(this.fnval)
    }
}

// ParamInfo describes a method parameter.
struct ParamInfo {
    Name  string
    Type  *TypeInfo
    Index int
    attrs []any

    // Attribute returns the attribute of type A on the parameter, or nil.
    func Attribute<A>() *A {
        return attrOf<A>(this.attrs)
    }

    // Attributes returns every attribute of type A on the parameter.
    func Attributes<A>() []*A {
        return attrsOf<A>(this.attrs)
    }
}

// VariantInfo describes an enum variant.
struct VariantInfo {
    Name   string
    Index  int
    Fields []*FieldInfo
    attrs  []any

    // Attribute returns the attribute of type A on the variant, or nil.
    func Attribute<A>() *A {
        return attrOf<A>(this.attrs)
    }

    // Attributes returns every attribute of type A on the variant.
    func Attributes<A>() []*A {
        return attrsOf<A>(this.attrs)
    }
}

// A reference to a value: its address, its type and an owner keeping the
// memory alive.
struct Value {
    owner any
    addr  int
    Type  *TypeInfo
    name  string

    // IsValid reports whether the value holds something (ValueOf(nil) is invalid).
    func IsValid() bool {
        return this.Type != nil
    }

    // Field returns field name of a struct value; it panics for other values.
    func Field(name string) Value {
        var t = this.Type
        if t == nil {
            panic("reflect: Field(" + name + ") of an invalid Value")
        }
        var addr = this.addr
        if t.Kind == Kind.Pointer {
            addr = loadAddr(addr)
            if addr == 0 {
                panic("reflect: Field(" + name + ") through a nil " + t.Name)
            }
            t = t.Elem
        }
        if t.Kind != Kind.Struct {
            panic("reflect: Field(" + name + ") of non-struct type " + t.Name)
        }
        var f = t.Field(name)
        if f == nil {
            panic("reflect: struct " + t.Name + " has no field " + name)
        }
        return Value{owner: this.owner, addr: addr + f.Offset, Type: f.Type, name: f.Name}
    }

    // Get returns the value as a T; it panics if the type is not T.
    func Get<T>() T {
        var want = TypeOf<T>()
        if this.Type == nil {
            panic("reflect: Get<" + want.Name + "> of an invalid Value")
        }
        if !sameType(want, this.Type) {
            panic("reflect: Get<" + want.Name + ">: " + this.name + " has type " + this.Type.Name)
        }
        return load<T>(this.addr)
    }

    // Set stores v; it panics if the type is not T or the value is not addressable.
    func Set<T>(v T) {
        var want = TypeOf<T>()
        if this.Type == nil {
            panic("reflect: Set of an invalid Value")
        }
        if !sameType(want, this.Type) {
            panic(
                "reflect: cannot set " +
                    this.name +
                    " (type " +
                    this.Type.Name +
                    ") to a value of type " +
                    want.Name,
            )
        }
        store<T>(this.addr, v)
    }
}

// ValueOf returns a Value for the dynamic value of x.
func ValueOf(x any) Value {
    var t = anyType(x)
    if t == nil {
        return Value{}
    }
    // A scalar held inline in the `any` gets a heap copy to point at.
    var o = anyBox(x)
    return Value{owner: o, addr: anyAddr(o), Type: t, name: t.Name}
}

// Compile-time field list of struct T: only as the sequence of a for loop
// inside a generic function (unrolled at instantiation).
func Fields<T>() []*FieldInfo {
    return TypeOf<T>().Fields
}

func sameType(a *TypeInfo, b *TypeInfo) bool {
    return canonOf(a) == canonOf(b)
}

func canonOf(t *TypeInfo) *TypeInfo {
    if t != nil && t.canon != nil {
        return t.canon
    }
    return t
}

func attrOf<A>(attrs []any) *A {
    for a in attrs {
        switch a {
            case *A p:
                return p
        }
    }
    return nil
}

func attrsOf<A>(attrs []any) []*A {
    var out []*A = []
    for a in attrs {
        switch a {
            case *A p:
                out = append(out, p)
        }
    }
    return out
}

// Intrinsics: code generation provides the bodies (compiler/src/codegen/reflect.rs).

// TypeOf returns the type information of T (computed at compile time).
func TypeOf<T>() *TypeInfo {
    return nil
}

// TypesWith returns every type of the program (all packages) declared
// with attribute A, by package, file and declaration order (computed at
// compile time; a constant slice).
func TypesWith<A>() []*TypeInfo {
    var none []*TypeInfo = []
    return none
}

// Error stops compilation with msg (a constant string) when the call is
// reachable after compile-time folding: a library-level static_assert.
func Error(msg string) {}

func anyType(x any) *TypeInfo {
    return nil
}

func anyAddr(x any) int {
    return 0
}

func anyBox(x any) any {
    return x
}

func ifaceType<I>(x I) *TypeInfo {
    return nil
}

func errType(e error) *TypeInfo {
    return nil
}

func loadAddr(addr int) int {
    return 0
}

func load<T>(addr int) T {
    var zero T
    return zero
}

func store<T>(addr int, v T) {}

func newOf(t *TypeInfo) any {
    return nil
}

func invokeMethod(fn int, recv any, args []any) any! {
    return nil
}

func asFunc<F>(fn int) F {
    var zero F
    return zero
}

func storeTag<T>(p *T, tag int) {}
