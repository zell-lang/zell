namespace strings

// strings.Builder: accumulates text in one growing byte buffer (capacity
// doubles, so n writes cost O(n) copying); String() builds the string once.
struct Builder {
    buf []byte
    n   int

    func Write(s string) {
        var need = this.n + len(s)
        if need > len(this.buf) {
            this.grow(need)
        }
        rtCopyString(this.buf, this.n, s, 0, len(s))
        this.n = need
    }

    func grow(need int) {
        var c = len(this.buf) * 2
        if c < 64 {
            c = 64
        }
        if c < need {
            c = need
        }
        var nb = rtMakeBytes(c)
        if this.n > 0 {
            rtCopy(nb, 0, this.buf, 0, this.n)
        }
        this.buf = nb
    }

    func String() string {
        if this.n == 0 {
            return ""
        }
        return FromBytes(this.buf[..this.n])
    }

    func Len() int {
        return this.n
    }

    func Reset() {
        this.buf = nil
        this.n = 0
    }
}
