// json.Format / json.Parse use compile-time reflection: inside these generic
// functions `reflect.Fields<T>()` loops are unrolled per field and the
// `if reflect.TypeOf<T>().Kind == ...` tests are resolved at compile time,
// so every instance is straight-line code for its type. Library code names
// other namespaces by their full path (it is instantiated in user scope).
//
// The text is parsed by the C runtime (runtime/src/std_json.c, ABI.md 17.4)
// into one arena document of nodes; a Value is a node of such a document
// and Parse<T> walks the nodes directly, allocating Zell strings only for
// the string fields of the destination. Format<T> appends to a runtime
// writer (rtW*). Error paths are built only when a value is wrong.
namespace encoding.json

// A parsed document, shared by the Values made from it and freed with the
// last of them.
struct document {
    h int

    func Drop() {
        rtFree(this.h)
    }
}

// A dynamic JSON value (json.ParseValue): a node of a parsed document. The
// zero Value is null.
struct Value {
    d *document
    n int

    // IsNull reports whether the value is null (also the zero Value).
    func IsNull() bool {
        return rtKind(this.n) == 0
    }

    // IsBool reports whether the value is a boolean.
    func IsBool() bool {
        return rtKind(this.n) == 1
    }

    // IsNumber reports whether the value is a number.
    func IsNumber() bool {
        return rtKind(this.n) == 2
    }

    // IsString reports whether the value is a string.
    func IsString() bool {
        return rtKind(this.n) == 3
    }

    // IsArray reports whether the value is an array.
    func IsArray() bool {
        return rtKind(this.n) == 4
    }

    // IsObject reports whether the value is an object.
    func IsObject() bool {
        return rtKind(this.n) == 5
    }

    // "null", "bool", "number", "string", "array" or "object".
    func Type() string {
        return kindName(rtKind(this.n))
    }

    // Bool returns the boolean; an error for other kinds.
    func Bool() bool! {
        if rtKind(this.n) != 1 {
            return error("json: " + this.Type() + " is not a bool")
        }
        return rtBool(this.n)
    }

    // Float returns the number; an error for other kinds.
    func Float() float! {
        // rtFloat is NaN for every node that is not a number (JSON has no NaN).
        var f = rtFloat(this.n)
        if math.IsNaN(f) {
            return error("json: " + this.Type() + " is not a number")
        }
        return f
    }

    // Int returns the number as an int; an error for other kinds and for
    // numbers with a fraction.
    func Int() int! {
        if rtIsInt(this.n) {
            return rtInt(this.n)
        }
        if rtKind(this.n) != 2 {
            return error("json: " + this.Type() + " is not a number")
        }
        return integral(rtFloat(this.n))?
    }

    // String returns the string; an error for other kinds.
    func String() string! {
        if rtKind(this.n) != 3 {
            return error("json: " + this.Type() + " is not a string")
        }
        return rtStr(this.n)
    }

    // Number of elements of an array or members of an object, else 0.
    func Len() int {
        return rtLen(this.n)
    }

    // Element i of an array (null if out of range or not an array).
    func Index(i int) Value {
        return Value{d: this.d, n: rtIndex(this.doc(), this.n, i)}
    }

    // Member `key` of an object (null if missing or not an object; the
    // last one wins for duplicate keys).
    func Get(key string) Value {
        return Value{d: this.d, n: rtGet(this.n, key)}
    }

    // Has reports whether an object has key.
    func Has(key string) bool {
        return rtGet(this.n, key) != 0
    }

    // Member names of an object in document order.
    func Keys() []string {
        var out []string = []
        if rtKind(this.n) == 5 {
            var k = rtFirst(this.n)
            for _ in 0..rtLen(this.n) {
                out = append(out, rtStr(k))
                k = rtNext(rtNext(k))
            }
        }
        return out
    }

    // Elements of an array (or member values of an object).
    func Items() []Value {
        var out []Value = []
        var kind = rtKind(this.n)
        if kind == 4 {
            var c = rtFirst(this.n)
            for _ in 0..rtLen(this.n) {
                out = append(out, Value{d: this.d, n: c})
                c = rtNext(c)
            }
        } else if kind == 5 {
            var k = rtFirst(this.n)
            for _ in 0..rtLen(this.n) {
                out = append(out, Value{d: this.d, n: rtNext(k)})
                k = rtNext(rtNext(k))
            }
        }
        return out
    }

    // Compact JSON text of the value.
    func Format() string {
        var w = rtWNew()
        rtWNode(w, this.n)
        return rtWFinish(w)
    }

    func doc() int {
        if this.d == nil {
            return 0
        }
        return this.d.h
    }
}

// NewNull returns the null value.
func NewNull() Value {
    return Value{}
}

// NewBool returns a boolean value.
func NewBool(b bool) Value {
    if b {
        return fromText("true")
    }
    return fromText("false")
}

// NewNumber returns a number value (null for NaN and infinities).
func NewNumber(n float) Value {
    var w = rtWNew()
    rtWFloat(w, n)
    return fromText(rtWFinish(w))
}

// NewString returns a string value.
func NewString(s string) Value {
    return fromText(Quote(s))
}

// NewArray returns an array of copies of items.
func NewArray(items []Value) Value {
    var w = rtWNew()
    rtWRaw(w, "[")
    for i, x in items {
        if i > 0 {
            rtWRaw(w, ",")
        }
        rtWNode(w, x.n)
    }
    rtWRaw(w, "]")
    return fromText(rtWFinish(w))
}

// NewObject returns an object of keys to values (in that order); an error if the lengths differ.
func NewObject(keys []string, values []Value) Value! {
    if len(keys) != len(values) {
        return error("json.NewObject: keys and values differ in length")
    }
    var w = rtWNew()
    rtWRaw(w, "{")
    for i, k in keys {
        rtWKey(w, k, i == 0)
        rtWNode(w, values[i].n)
    }
    rtWRaw(w, "}")
    return fromText(rtWFinish(w))
}

// The Value of a text written by the writer (always valid JSON).
func fromText(text string) Value {
    return try ParseValue(text) else Value{}
}

func kindName(k int) string {
    if k == 0 {
        return "null"
    }
    if k == 1 {
        return "bool"
    }
    if k == 2 {
        return "number"
    }
    if k == 3 {
        return "string"
    }
    if k == 4 {
        return "array"
    }
    return "object"
}

// -- parsing ----------------------------------------------------------------

// Parses a JSON text into a dynamic Value. Syntax errors read "json: <what>
// at offset N" (lexical) or "json: expected , or ] in an array, found
// number 2", "json: unexpected end of input" (grammar); nesting deeper than
// 512 containers is "json: nesting too deep".
func ParseValue(text string) Value! {
    var h = rtParse(text)?
    return Value{d: new document{h: h}, n: rtRoot(h)}
}

// Parses a JSON text into a T (structs by their fields and @json, slices,
// maps with string keys, pointers, strings, numbers, bools, plain enums by
// variant name, json.Value, any). Errors name the path: "users[2].id: ...".
func Parse<T>(text string) T! {
    var v = ParseValue(text)?
    return Decode<T>(v)?
}

// Decodes a dynamic Value into a T.
func Decode<T>(v Value) T! {
    var out T
    decode(v.d, v.n, &out)?
    return out
}

// A decoding error: what was wrong and the path of the bad value
// ("Users[2].id"), extended on the way out of the decoder; "json: <msg>" at
// the top level.
struct pathError {
    path string
    msg  string

    func Message() string {
        if this.path == "" {
            return "json: " + this.msg
        }
        return this.path + ": " + this.msg
    }
}

func fail(msg string) error {
    return pathError{msg: msg}
}

// err with the path segment seg (a field or key name, or "[i]") in front.
func at(err error, seg string) error {
    switch err {
        case pathError e:
            if e.path == "" {
                e.path = seg
            } else if strings.HasPrefix(e.path, "[") {
                e.path = seg + e.path
            } else {
                e.path = seg + "." + e.path
            }
            return e
        default:
            return err
    }
}

func mismatch(want string, n int) error {
    return fail("expected " + want + ", found " + kindName(rtKind(n)))
}

// The integer value of f (an error if it has a fraction or is too large).
func integral(f float) int! {
    if f != math.Trunc(f) || f < -9223372036854775808.0 || f >= 9223372036854775808.0 {
        return fail("expected int, found number " + fmt.Format("{0}", f))
    }
    return int(f)
}

func intIn(n int, lo int, hi int) int! {
    var v = 0
    if rtIsInt(n) {
        v = rtInt(n)
    } else {
        if rtKind(n) != 2 {
            return mismatch("int", n)
        }
        v = integral(rtFloat(n))?
    }
    if v < lo || v > hi {
        return fail("number " + fmt.Format("{0}", v) + " out of range")
    }
    return v
}

func decode<T>(d *document, n int, out *T) void! {
    if reflect.TypeOf<T>() == reflect.TypeOf<Value>() {
        *out = Value{d: d, n: n}
        return
    }
    if reflect.TypeOf<T>() == reflect.TypeOf<time.Time>() {
        if rtKind(n) != 3 {
            return mismatch("string", n)
        }
        *out = try time.ParseTime(time.RFC3339Nano, rtStr(n)) catch err {
            return fail("invalid time " + Quote(rtStr(n)) + " (want RFC 3339)")
        }
        return
    }
    if reflect.TypeOf<T>() == reflect.TypeOf<time.Duration>() {
        *out = time.Nanoseconds(intIn(n, math.MinInt, math.MaxInt)?)
        return
    }
    if reflect.TypeOf<T>().Kind == reflect.Kind.Pointer ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Slice ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Map {
        if rtKind(n) == 0 {
            *out = nil
            return
        }
    }
    if reflect.TypeOf<T>().Kind == reflect.Kind.Struct {
        if rtKind(n) != 5 {
            return mismatch("object", n)
        }
        // f.Attribute<reflect.json>(), f.Name and f.Get are resolved at
        // compile time; written inline (not held in variables) so that the
        // name tests fold to constants too.
        for f in reflect.Fields<T>() {
            if f.Attribute<reflect.json>() != nil && f.Attribute<reflect.json>().skip {
                continue
            }
            var name = f.Name
            if f.Attribute<reflect.json>() != nil && len(f.Attribute<reflect.json>().name) > 0 {
                name = f.Attribute<reflect.json>().name
            }
            var c = rtGet(n, name)
            if c == 0 {
                // Like Go: an exact key first, else a case-insensitive one.
                c = rtGetFold(n, name)
            }
            if c != 0 {
                try decode(d, c, &f.Get(*out)) catch err {
                    return at(err, name)
                }
            }
        }
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.String {
        if rtKind(n) != 3 {
            return mismatch("string", n)
        }
        *out = rtStr(n)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Bool {
        if rtKind(n) != 1 {
            return mismatch("bool", n)
        }
        *out = rtBool(n)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int {
        *out = intIn(n, math.MinInt, math.MaxInt)?
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int8 {
        *out = int8(intIn(n, -128, 127)?)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int16 {
        *out = int16(intIn(n, -32768, 32767)?)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int32 {
        *out = int32(intIn(n, math.MinInt32, math.MaxInt32)?)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Uint {
        *out = uint(intIn(n, 0, math.MaxInt)?)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Uint8 {
        *out = byte(intIn(n, 0, 255)?)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Uint16 {
        *out = uint16(intIn(n, 0, 65535)?)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Uint32 {
        *out = uint32(intIn(n, 0, math.MaxUint32)?)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Float {
        if rtKind(n) != 2 {
            return mismatch("number", n)
        }
        *out = rtFloat(n)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Float32 {
        if rtKind(n) != 2 {
            return mismatch("number", n)
        }
        *out = float32(rtFloat(n))
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Enum {
        if rtKind(n) != 3 {
            return mismatch("string", n)
        }
        var t = reflect.TypeOf<T>()
        var s = rtStr(n)
        var variant = t.Variant(s)
        if variant == nil || len(variant.Fields) > 0 {
            return fail("unknown " + t.Name + " value " + Quote(s))
        }
        reflect.storeTag(out, variant.Index)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Slice {
        if rtKind(n) != 4 {
            return mismatch("array", n)
        }
        decodeSlice(d, n, out)?
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Map {
        if reflect.TypeOf<T>().Key.Kind == reflect.Kind.String {
            if rtKind(n) != 5 {
                return mismatch("object", n)
            }
            decodeMap(d, n, out)?
        } else {
            return fail("cannot decode into " + reflect.TypeOf<T>().Name + " (map keys must be strings)")
        }
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Pointer {
        decodePtr(d, n, out)?
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Any {
        *out = Value{d: d, n: n}
    } else {
        return fail("cannot decode into " + reflect.TypeOf<T>().Name)
    }
}

func decodeSlice<E>(d *document, n int, out *[]E) void! {
    var count = rtLen(n)
    if count == 0 {
        // `[]` decodes to an empty slice that is not nil, so that it formats
        // back as `[]` (null decodes to nil and formats as null).
        var z E
        var one []E = [z]
        *out = one[0..0]
        return
    }
    // A slice of the final size, decoded element by element in place
    // (rtMake<E>(n) is the compiler's sized-slice intrinsic: n zeroed
    // elements, len == cap == n).
    var res = rtMake<E>(count)
    var c = rtFirst(n)
    for i in 0..count {
        try decode(d, c, &res[i]) catch err {
            return at(err, "[" + fmt.Format("{0}", i) + "]")
        }
        c = rtNext(c)
    }
    *out = res
}

func decodeMap<V>(d *document, n int, out *map[string]V) void! {
    var m = map[string]V{}
    var k = rtFirst(n)
    for _ in 0..rtLen(n) {
        var key = rtStr(k)
        var vn = rtNext(k)
        var e V
        try decode(d, vn, &e) catch err {
            return at(err, key)
        }
        m[key] = e
        k = rtNext(vn)
    }
    *out = m
}

func decodePtr<E>(d *document, n int, out **E) void! {
    var e E
    decode(d, n, &e)?
    *out = &e
}

// -- formatting -------------------------------------------------------------

// Compact JSON text of v (structs by their fields and @json(name, skip,
// omitEmpty), slices and arrays, maps (keys sorted), pointers, strings,
// numbers, bools, plain enums by variant name, json.Value, any holding
// those). Nil slices, maps and pointers are null; an empty slice is [].
func Format<T>(v T) string {
    var w = rtWNew()
    write(w, v)
    return rtWFinish(w)
}

// FormatIndent is Format with Go's MarshalIndent layout: each element or
// pair on a new line that starts with prefix and one indent per nesting
// level; "key": value; empty containers stay {} and []. The first line
// has no prefix.
func FormatIndent<T>(v T, prefix string, indent string) string {
    return rtIndent(Format(v), prefix, indent)
}

func write<T>(w int, v T) {
    if reflect.TypeOf<T>() == reflect.TypeOf<Value>() {
        rtWNode(w, v.n)
    } else if reflect.TypeOf<T>() == reflect.TypeOf<time.Time>() {
        // RFC 3339 with nanoseconds, as Go's time.Time.MarshalJSON
        rtWStr(w, v.Format(time.RFC3339Nano))
    } else if reflect.TypeOf<T>() == reflect.TypeOf<time.Duration>() {
        // an integer count of nanoseconds, as Go
        rtWInt(w, v.Nanoseconds())
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Struct {
        rtWRaw(w, "{")
        var first = true
        for f in reflect.Fields<T>() {
            if f.Attribute<reflect.json>() != nil && f.Attribute<reflect.json>().skip {
                continue
            }
            var name = f.Name
            if f.Attribute<reflect.json>() != nil && len(f.Attribute<reflect.json>().name) > 0 {
                name = f.Attribute<reflect.json>().name
            }
            if f.Attribute<reflect.json>() != nil && f.Attribute<reflect.json>().omitEmpty && isEmpty(f.Get(v)) {
                continue
            }
            writeField(w, name, first, f.Get(v))
            first = false
        }
        rtWRaw(w, "}")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.String {
        rtWStr(w, v)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Bool {
        rtWBool(w, v)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Float ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Float32 {
        rtWFloat(w, float(v))
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Uint {
        rtWUint(w, uint(v))
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Int8 ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Int16 ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Int32 ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Uint8 ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Uint16 ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Uint32 {
        rtWInt(w, int(v))
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Char {
        rtWStr(w, string(v))
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Enum {
        rtWStr(w, fmt.Format("{0}", v))
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Slice {
        if v == nil {
            rtWRaw(w, "null")
        } else if reflect.TypeOf<T>().Elem.Kind == reflect.Kind.String {
            rtWStrs(w, v)
        } else {
            rtWRaw(w, "[")
            for i, x in v {
                if i > 0 {
                    rtWRaw(w, ",")
                }
                write(w, x)
            }
            rtWRaw(w, "]")
        }
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Array {
        rtWRaw(w, "[")
        for i, x in v {
            if i > 0 {
                rtWRaw(w, ",")
            }
            write(w, x)
        }
        rtWRaw(w, "]")
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Map {
        if v == nil {
            rtWRaw(w, "null")
        } else {
            writeMap(w, v)
        }
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Pointer {
        if v == nil {
            rtWRaw(w, "null")
        } else {
            write(w, *v)
        }
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Any {
        writeAny(w, v)
    } else {
        rtWRaw(w, "null")
    }
}

// A struct member: key and value in one runtime call for the scalar types.
func writeField<F>(w int, name string, first bool, v F) {
    if reflect.TypeOf<F>().Kind == reflect.Kind.String {
        rtWKeyStr(w, name, first, v)
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Int ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Int8 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Int16 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Int32 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Uint8 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Uint16 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Uint32 {
        rtWKeyInt(w, name, first, int(v))
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Float ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Float32 {
        rtWKeyFloat(w, name, first, float(v))
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Bool {
        rtWKeyBool(w, name, first, v)
    } else {
        rtWKey(w, name, first)
        write(w, v)
    }
}

// An object with the members sorted by key (as Go does).
func writeMap<K, V>(w int, m map[K]V) {
    var keys []K = []
    var names []string = []
    for k, _ in m {
        keys = append(keys, k)
        names = append(names, keyString(k))
    }
    // Insertion sort of names, moving keys along.
    for i in 1..len(names) {
        var j = i
        for j > 0 && names[j - 1] > names[j] {
            var s = names[j]
            names[j] = names[j - 1]
            names[j - 1] = s
            var k = keys[j]
            keys[j] = keys[j - 1]
            keys[j - 1] = k
            j -= 1
        }
    }
    rtWRaw(w, "{")
    for i, k in keys {
        rtWKey(w, names[i], i == 0)
        write(w, m[k])
    }
    rtWRaw(w, "}")
}

func keyString<K>(k K) string {
    if reflect.TypeOf<K>().Kind == reflect.Kind.String {
        return k
    } else {
        return fmt.Format("{0}", k)
    }
}

func isEmpty<F>(x F) bool {
    if reflect.TypeOf<F>().Kind == reflect.Kind.String {
        return x == ""
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Bool {
        return !x
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Int ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Int8 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Int16 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Int32 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Uint ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Uint8 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Uint16 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Uint32 ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Float ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Float32 {
        return x == 0
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Slice ||
        reflect.TypeOf<F>().Kind == reflect.Kind.Map {
        return len(x) == 0
    } else if reflect.TypeOf<F>().Kind == reflect.Kind.Pointer {
        return x == nil
    } else {
        return false
    }
}

func writeAny(w int, x any) {
    switch x {
        case string s:
            rtWStr(w, s)
        case int n:
            rtWInt(w, n)
        case float f:
            rtWFloat(w, f)
        case bool t:
            rtWBool(w, t)
        case Value v:
            rtWNode(w, v.n)
        default:
            rtWRaw(w, "null")
    }
}
