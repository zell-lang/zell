// Zell grammar in IntelliJ Grammar-Kit format.
// Canonical syntax reference for IDE tooling; keep in sync with DESIGN.md
// and compiler/src/parser.rs. Generates a PSI parser for the IDEA plugin.

{
  parserClass="org.zell.lang.parser.ZellParser"
  extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

  psiClassPrefix="Zell"
  psiImplClassSuffix="Impl"
  psiPackage="org.zell.lang.psi"
  psiImplPackage="org.zell.lang.psi.impl"

  elementTypeHolderClass="org.zell.lang.psi.ZellTypes"
  elementTypeClass="org.zell.lang.psi.ZellElementType"
  tokenTypeClass="org.zell.lang.psi.ZellTokenType"

  tokens = [
    // Keywords
    NAMESPACE='namespace' IMPORT='import' AS='as'
    STRUCT='struct' INTERFACE='interface' ENUM='enum'
    FUNC='func' STATIC='static' ASYNC='async' AWAIT='await'
    VAR='var' CONST='const'
    IF='if' ELSE='else' FOR='for'
    SWITCH='switch' CASE='case' DEFAULT='default'
    RETURN='return' BREAK='break' CONTINUE='continue' DEFER='defer'
    TRY='try' CATCH='catch' NEW='new'
    NIL='nil' TRUE='true' FALSE='false' MAP='map' THIS='this'

    // Punctuation
    LPAREN='(' RPAREN=')' LBRACE='{' RBRACE='}' LBRACKET='[' RBRACKET=']'
    COMMA=',' DOT='.' DOTDOT='..' COLON=':' SEMI=';'
    QUESTION='?' BANG='!' ARROW='=>' AT='@'
    AMP='&' STAR='*' PLUS='+' MINUS='-' SLASH='/' PERCENT='%'
    PIPE='|' CARET='^' SHL='<<' SHR='>>'
    ANDAND='&&' OROR='||'
    LT='<' GT='>' LE='<=' GE='>=' EQEQ='==' NOTEQ='!='
    ASSIGN='=' PLUSEQ='+=' MINUSEQ='-=' STAREQ='*=' SLASHEQ='/=' PERCENTEQ='%='
    AMPEQ='&=' PIPEEQ='|=' CARETEQ='^=' SHLEQ='<<=' SHREQ='>>=' ATEQ='@='
    UNDERSCORE='_'

    // Literals and trivia (regex for the JFlex lexer)
    LINE_COMMENT='regexp://.*'
    BLOCK_COMMENT='regexp:/\*([^*]|\*+[^*/])*\*+/'
    INT_LITERAL='regexp:(0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[oO][0-7_]+|[0-9][0-9_]*)'
    FLOAT_LITERAL='regexp:[0-9][0-9_]*(\.[0-9][0-9_]*)?([eE][+-]?[0-9]+)?'
    STRING_LITERAL='regexp:"([^"\\\n]|\\.)*"'
    RAW_STRING_LITERAL='regexp:`[^`]*`'
    CHAR_LITERAL="regexp:'([^'\\\n]|\\.)'"
    IDENTIFIER='regexp:[a-zA-Z][a-zA-Z0-9_]*'
    NEWLINE='regexp:\n'
    WHITE_SPACE='regexp:[ \t\r]+'
  ]

  // Statement terminators: the lexer layer inserts SEMI at a newline after
  // IDENTIFIER, literals, RETURN, BREAK, CONTINUE, NIL, TRUE, FALSE, THIS,
  // UNDERSCORE, RPAREN, RBRACE, RBRACKET, QUESTION, BANG, GT, SHR (Go-style),
  // never directly inside ( ) or [ ], and not when the next line's first
  // token is DOT (a line starting with `.` continues the previous one).
  // `eos` below accepts either an explicit or an inserted SEMI.
}

// ---------------------------------------------------------------------------
// File
// ---------------------------------------------------------------------------

// `@cfg(...)` before `namespace` excludes the whole file.
file ::= attribute* namespace_decl import_decl* top_level_decl*

namespace_decl ::= NAMESPACE qualified_name eos
import_decl ::= IMPORT qualified_name (AS IDENTIFIER)? eos
qualified_name ::= name_segment (DOT name_segment)*
// keywords are allowed as path segments (`examples.async`, `@default`)
name_segment ::= IDENTIFIER | NAMESPACE | IMPORT | AS | STRUCT | INTERFACE | ENUM | FUNC | STATIC | ASYNC | AWAIT | VAR | CONST | IF | ELSE | FOR | SWITCH | CASE | DEFAULT | RETURN | BREAK | CONTINUE | DEFER | TRY | CATCH | NEW | NIL | TRUE | FALSE | MAP | THIS

// A declaration ending in `}` gets an automatic SEMI at the newline after it.
top_level_decl ::= attribute* ((struct_decl | interface_decl | enum_decl | func_decl) eos? | extern_func_decl eos | var_decl eos | const_decl eos)
// `extern` is a contextual keyword (an IDENTIFIER spelled "extern"): a runtime
// (C) function without a body, only in the generated std/**/*_extern.zl files.
extern_func_decl ::= IDENTIFIER func_signature

// `@json("name")`, `@reflect`, `@deprecated(reason: "...")`, `@allowCycle`;
// an attribute on its own line is followed by an automatic SEMI.
attribute ::= AT qualified_name attribute_args? eos?
attribute_args ::= LPAREN (attribute_arg (COMMA attribute_arg)*)? RPAREN
// Keywords may name an argument (and a field): `@cli.flag(default: "8080")`,
// `@Conf(enum: "a,b")`.
attribute_arg ::= (field_name COLON)? expr

// ---------------------------------------------------------------------------
// Declarations
// ---------------------------------------------------------------------------

// `default` is allowed as a struct name (the `@default("now()")` attribute of data)
struct_decl ::= STRUCT (IDENTIFIER | DEFAULT) generic_params? implements_clause? LBRACE struct_member* RBRACE
// `implements` is a contextual keyword (an IDENTIFIER spelled "implements").
implements_clause ::= IDENTIFIER type (COMMA type)*
struct_member ::= attribute* (method_decl | field_decl | embed_decl) eos?
// `Port int = 8080`: a default value (attribute structs, options).
// A field may be named by a keyword (`enum string`, `default string`),
// except FUNC, STATIC and ASYNC, which start a method.
field_decl ::= field_name type (ASSIGN expr)?
field_name ::= IDENTIFIER | NAMESPACE | IMPORT | AS | STRUCT | INTERFACE | ENUM | AWAIT | VAR | CONST | IF | ELSE | FOR | SWITCH | CASE | DEFAULT | RETURN | BREAK | CONTINUE | DEFER | TRY | CATCH | NEW | NIL | TRUE | FALSE | MAP | THIS
embed_decl ::= type
method_decl ::= STATIC? func_decl

// An embedded interface is a bare interface name on its own line. A method
// with a body is a default method (`this` is the interface value).
// `sealed` is a contextual keyword (an IDENTIFIER spelled "sealed").
interface_decl ::= IDENTIFIER? INTERFACE IDENTIFIER generic_params? LBRACE ((attribute* func_signature block? | named_type) eos?)* RBRACE

// Methods (with `this` = the enum value) follow the variants.
enum_decl ::= ENUM IDENTIFIER generic_params? implements_clause? LBRACE enum_variant ((COMMA | eos) enum_variant)* (COMMA | eos)?
              (attribute* method_decl eos?)* RBRACE
enum_variant ::= attribute* IDENTIFIER (LPAREN param_list? RPAREN)?

func_decl ::= func_signature block
func_signature ::= ASYNC? FUNC IDENTIFIER generic_params? LPAREN param_list? RPAREN type?
param_list ::= param_group (COMMA param_group)* COMMA?
// `a, b int` groups names under one type, like Go; `@body p Point` (parameter attributes)
param_group ::= attribute* IDENTIFIER (COMMA IDENTIFIER)* type

generic_params ::= LT generic_param (COMMA generic_param)* GT
generic_param ::= IDENTIFIER (COLON type)?

// `var (q, r) = f()` and `var q, r = f()` destructure a tuple; with a map
// index, `var v, ok = m[k]` is the comma-ok lookup (DESIGN.md "Переменные").
var_decl ::= VAR (var_name (COMMA var_name)* | var_tuple) type? (ASSIGN expr)?
var_tuple ::= LPAREN var_name (COMMA var_name)* RPAREN
var_name ::= IDENTIFIER | UNDERSCORE
const_decl ::= CONST IDENTIFIER type? ASSIGN expr

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

type ::= prefix_type BANG?
prefix_type ::= pointer_type | slice_type | array_type | map_type | func_type | tuple_type | named_type
named_type ::= qualified_name generic_args?
generic_args ::= LT type (COMMA type)* GT
// `weak *T` (weak pointer): `weak` is contextual, an IDENTIFIER spelled
// "weak" directly before STAR; it is not a reserved word.
pointer_type ::= IDENTIFIER? STAR prefix_type
slice_type ::= LBRACKET RBRACKET prefix_type
// The length is an integer constant expression (`[3]int`, `[N + 1]int`).
array_type ::= LBRACKET expr RBRACKET prefix_type
map_type ::= MAP LBRACKET type RBRACKET prefix_type
func_type ::= FUNC LPAREN (type (COMMA type)*)? RPAREN type?
tuple_type ::= LPAREN type (COMMA type)+ RPAREN

// ---------------------------------------------------------------------------
// Statements
// ---------------------------------------------------------------------------

block ::= LBRACE statement* RBRACE
statement ::= (var_decl | const_decl | if_stmt | for_stmt | switch_stmt | try_stmt | return_stmt
             | break_stmt | continue_stmt | defer_stmt | block | assign_stmt | expr_stmt) eos?

if_stmt ::= IF expr block (ELSE (if_stmt | block))?

for_stmt ::= FOR for_header? block
for_header ::= for_in | expr
// `in` is a contextual keyword (an IDENTIFIER spelled "in"), only here;
// elsewhere it is an ordinary name (`var in = 1`, a parameter `in`).
for_in ::= var_name (COMMA var_name)? IDENTIFIER (range_expr | expr)
// `0..10`, `s[1..]`, `s[..3]`; only valid as a for iterator, index or case pattern
range_expr ::= expr? DOTDOT expr?

switch_stmt ::= SWITCH expr? LBRACE switch_case* default_case? RBRACE
switch_case ::= CASE pattern (COMMA pattern)* COLON statement*
default_case ::= DEFAULT COLON statement*
pattern ::= range_pattern | type_bind_pattern | expr
range_pattern ::= range_expr
// `case Circle c:`; the lookahead keeps `case await F(x) > 5:` an expression
type_bind_pattern ::= type IDENTIFIER &(COLON | COMMA)

// `try { ... } catch err { ... }`: `?` inside the block jumps to catch
try_stmt ::= TRY block CATCH var_name block

return_stmt ::= RETURN (expr (COMMA expr)*)?
break_stmt ::= BREAK
continue_stmt ::= CONTINUE
defer_stmt ::= DEFER expr
// `a, b = b, a` (all right-hand values are evaluated first) and
// `(q, r) = f()` (tuple result, `_` discards) assign to existing places.
assign_stmt ::= expr (COMMA expr)* assign_op expr (COMMA expr)*
assign_op ::= ASSIGN | PLUSEQ | MINUSEQ | STAREQ | SLASHEQ | PERCENTEQ | AMPEQ | PIPEEQ | CARETEQ | SHLEQ | SHREQ | ATEQ
expr_stmt ::= expr

eos ::= SEMI

// ---------------------------------------------------------------------------
// Expressions (lowest to highest precedence)
// ---------------------------------------------------------------------------

// lambda_expr is a primary_expr, so that it can be called directly: `defer func() { ... }()`
expr ::= try_expr | or_expr
try_expr ::= TRY expr (CATCH var_name block | ELSE else_value)
else_value ::= CONTINUE | BREAK | return_stmt | expr
// `async` lambdas return Task<T> when called.
lambda_expr ::= ASYNC? FUNC LPAREN param_list? RPAREN type? block
              | ASYNC? LPAREN (param_list | lambda_names)? RPAREN ARROW (block | expr)
// `(u) => ...`: parameter types from the expected function type (sema)
lambda_names ::= IDENTIFIER (COMMA IDENTIFIER)*

or_expr ::= and_expr (OROR and_expr)*
and_expr ::= cmp_expr (ANDAND cmp_expr)*
cmp_expr ::= add_expr ((EQEQ | NOTEQ | LT | LE | GT | GE) add_expr)*
add_expr ::= mul_expr ((PLUS | MINUS | PIPE | CARET) mul_expr)*
// AT between operands is matrix multiplication (`a @ b`, MatMul); an AT
// that starts a declaration (or a field, method, parameter) is an attribute.
// Operators on struct/enum values call their operator methods
// (DESIGN.md "Перегрузка операторов").
mul_expr ::= unary_expr ((STAR | SLASH | PERCENT | AT | SHL | SHR | AMP) unary_expr)*
unary_expr ::= (MINUS | BANG | AMP | STAR | AWAIT) unary_expr | postfix_expr
postfix_expr ::= primary_expr postfix*
// keywords are member names after `.` (`tag.default`), as in the lexer's semicolon rule
postfix ::= DOT name_segment
          | LPAREN arg_list? RPAREN
          | LBRACKET (range_expr | expr) RBRACKET
          | QUESTION (LPAREN expr RPAREN)?
          // explicit type arguments `Max<int>(1, 2)`, `Option<int>.Some(1)`, `F<int>`;
          // the compiler accepts them only before ( { . ) ] } , or the end of a statement
          | generic_args
// `name: value` arguments only inside attribute arguments (`@cfg(not(os: "windows"))`).
arg_list ::= call_arg (COMMA call_arg)* COMMA?
call_arg ::= (field_name COLON)? expr

// `_` is the discard target (`_ = f()`) and a wildcard in patterns (`Shape.Rect(w, _)`)
primary_expr ::= lambda_expr | literal | THIS | NIL | UNDERSCORE
               | struct_literal | slice_literal | map_literal
               | NEW primary_expr
               | LPAREN expr (COMMA expr)* RPAREN
               | IDENTIFIER
literal ::= INT_LITERAL | FLOAT_LITERAL | STRING_LITERAL | RAW_STRING_LITERAL | CHAR_LITERAL | TRUE | FALSE

// `Point{X: 1}`; not allowed directly in if/for/switch headers (Go rule)
struct_literal ::= qualified_name generic_args? LBRACE (field_init (COMMA field_init)* COMMA?)? RBRACE
field_init ::= field_name COLON expr
slice_literal ::= LBRACKET (expr (COMMA expr)* COMMA?)? RBRACKET
map_literal ::= map_type LBRACE (map_entry (COMMA map_entry)* COMMA?)? RBRACE
map_entry ::= expr COLON expr
