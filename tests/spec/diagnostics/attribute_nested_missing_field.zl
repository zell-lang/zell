// error: missing field name in attribute value unit{...} (the field is @required)
// status: passing
namespace spec.diagnostics.attribute_nested_missing_field

import io

@attribute
struct unit {
    @required name string
}

@attribute
struct metric {
    u unit
}

@metric(u: unit{})
struct A {
    X int
}

func main() {
    println(A{X: 1}.X)
}
