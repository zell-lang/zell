// test: app.MapError<E>(status) turns errors of type E (also wrapped by ?("ctx") and returned as pointers) into Problem Details with that status and the message as detail; app.OnError sees every error first and may return its own Problem or nil for the default mapping; unmapped errors stay a generic 500
// status: passing
// run-flags: --leak-check
namespace spec.web.error_mapping

import io
import web

struct NotFound {
    What string
    func Message() string { return this.What + " not found" }
}

struct Conflict {
    func Message() string { return "version mismatch" }
}

struct Teapot {
    func Message() string { return "I'm a teapot" }
}

func find(what string) string! {
    return NotFound{What: what}
}

func build(hook bool) *App {
    var app = NewAppWith(AppOptions{
        Environment: "production",
        Logger: log.New().MinimumLevel(log.Level.Fatal).CreateLogger(),
    })
    app.MapError<NotFound>(404).MapError<Conflict>(409)
    if hook {
        app.OnError(func(c *Context, err error) *ProblemDetails {
            switch err {
                case Teapot t:
                    return &ProblemDetails{Type: "https://example.com/teapot", Title: "I'm a teapot", Status: 418, Detail: t.Message()}
            }
            return nil
        })
    }
    app.MapGet("/missing", func() string! {
        return find("order")?("loading")
    })
    app.MapGet("/conflict", func() string! {
        return &Conflict{}
    })
    app.MapGet("/teapot", func() string! {
        return Teapot{}
    })
    app.MapGet("/boom", func() string! {
        return error("database is down")
    })
    return app
}

async func main() void! {
    for hook in [false, true] {
        println("hook:", hook)
        var c = TestServer(build(hook))?
        for path in ["/missing", "/conflict", "/teapot", "/boom"] {
            var r = await c.Get(path)
            println(path, "->", r.Status, r.Body)
        }
    }
}
