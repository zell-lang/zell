keys: [*spec.web.di_scopes.Config *spec.web.di_scopes.Counter *spec.web.di_scopes.Db *spec.web.di_scopes.RequestState *spec.web.di_scopes.Stamp *spec.web.di_scopes.Repo spec.web.di_scopes.Greeter string]
build:
  new Db for test
GET /di/ann
  drop RequestState 1
  200 Good day, ann | request 1 | same scope true | transient differs true | unused nil true | db 1
GET /di/bob
  drop RequestState 2
  200 Good day, bob | request 2 | same scope true | transient differs true | unused nil true | db 1
GET /resolve
  200 Good day, test-value
GET /ctx
  drop RequestState 100
  200 true
GET /missing
  500 {"type":"about:blank","title":"Internal Server Error","status":500,"detail":"internal error","instance":"/missing"}
lifetime: Scoped true false
