// test: errors from handlers become RFC 9457 Problem Details: the message as detail only for web.Error and in development (else "internal error"), web.Error(status, ...) for other statuses, the errors.Trace only in development mode; web.Problem, BadRequest, Conflict, ValidationProblem results; 404/405 problems; Problem JSON member order
// status: passing
// run-flags: --leak-check
namespace spec.web.problems

import io
import web

func load(id int) string! {
    if id == 0 {
        return error("database is down")
    }
    if id > 10 {
        return Error(404, "no order " + fmt.Format("{0}", id))
    }
    return "order"
}

func build(env string) *App {
    var app = NewAppWith(AppOptions{
        Environment: env,
        Logger: log.New().MinimumLevel(log.Level.Fatal).CreateLogger(),
    })
    app.MapGet("/orders/{id}", func(id int) string! {
        return load(id)?
    })
    app.MapGet("/problem", () => Problem<string>(418, "I'm a teapot", "short and stout"))
    app.MapGet("/bad", () => BadRequest<int>("missing filter"))
    app.MapGet("/conflict", () => Conflict<int>("version mismatch"))
    app.MapGet("/invalid", () => ValidationProblem<int>([
        FieldError{Field: "a", Message: "first"},
        FieldError{Field: "b", Message: "second"},
        FieldError{Field: "a", Message: "third"},
    ]))
    return app
}

async func main() void! {
    for env in ["production", "development"] {
        println("env:", env)
        var app = build(env)
        println("dev:", app.IsDevelopment())
        var c = TestServer(app)?
        var r = await c.Get("/orders/0")
        var p = encoding.json.ParseValue(r.Body)?
        println(
            r.Status,
            r.Header("Content-Type"),
            p.Get("title").String()?,
            p.Get("detail").String()?,
            p.Has("trace"),
        )
        if p.Has("trace") {
            println("trace mentions load:", strings.Contains(p.Get("trace").String()?, "load"))
        }
    }
    var c = TestServer(build("production"))?
    for path in ["/orders/1", "/orders/12", "/problem", "/bad", "/conflict", "/invalid", "/none"] {
        var r = await c.Get(path)
        println(path, "->", r.Status, r.Body)
    }
    var p = ProblemDetails{
        Type: "https://example.com/probs/out-of-credit",
        Title: "You do not have enough credit.",
        Status: 403,
        Detail: "Your current balance is 30, but that costs 50.",
        Instance: "/account/12345/msgs/abc",
    }
    println(p.Json())
}
