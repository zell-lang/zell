// test: UseRecover contains a handler panic: the request gets a 500 Problem Details with the generic detail "internal error", the panic is logged at Error level, and the next request is served
// status: passing
// The handler panics in a synchronous frame: what that frame and its callers held is leaked (DESIGN.md "Паника"), so no --leak-check here.
namespace spec.web.recover_panic

import io
import web

async func main() void! {
    var logger = log.New().WriteTo.Console(log.ConsoleOptions{
        Template: "log: {Level:u3} {Message:lj}{NewLine}",
        Stdout: true,
    }).CreateLogger()
    var app = NewAppWith(AppOptions{Logger: logger})
    app.UseRecover()
    app.MapGet("/boom", func(c *Context) string {
        var xs = [1, 2]
        return fmt.Format("{0}", xs[len(c.Request.Path)])
    })
    app.MapGet("/ok", () => "still serving")
    var cli = TestServer(app)?
    var r = await cli.Get("/boom")
    println("->", r.Status, r.Header("Content-Type"))
    println(r.Body)
    r = await cli.Get("/ok")
    println("->", r.Status, r.Body)
}
