// error: User has no field or method Invoices
// status: passing
namespace spec.data.err_entry_nav

struct User {
    Id    int
    Name  string
    Age   int
    @data.ignore Cache string
    Orders []*Order
}

struct Order {
    Id     int
    UserId int
    Total  float
}

struct Shop {
    data.Context
    Users  data.Set<User>
    Orders data.Set<Order>
}

async func main() void! {
    var ctx = data.Open<Shop>(data.Provider.Sqlite, ":memory:")?
    var u = await ctx.Users.First()?
    await ctx.Entry(u).Collection((u) => u.Invoices).Load()?
}
