SELECT t0."id", t0."name", t0."parent_id" FROM (WITH RECURSIVE "categories_tree" AS (SELECT t0."id", t0."name", t0."parent_id" FROM "categories" AS t0 WHERE (t0."name" = $1) UNION SELECT r1."id", r1."name", r1."parent_id" FROM "categories" AS r1 JOIN "categories_tree" AS r0 ON (r0."parent_id" = r1."id")) SELECT * FROM "categories_tree") AS t0
