SELECT t0."id", t0."name", t0."parent_id" FROM (WITH RECURSIVE "categories_tree" AS (SELECT t0."id", t0."name", t0."parent_id" FROM "categories" AS t0 WHERE (t0."id" = ?) UNION SELECT r1."id", r1."name", r1."parent_id" FROM "categories" AS r1 JOIN "categories_tree" AS r0 ON (r1."parent_id" = r0."id")) SELECT * FROM "categories_tree") AS t0 [2]
