SELECT t0."id", t0."name", t0."email", t0."age", t0."joined", t0."admin" FROM "users" AS t0 WHERE ((t0."id" IN (?, ?, ?)) AND (t0."age" IS NULL)) [2 3 99]
SELECT t0."id", t0."name", t0."email", t0."age", t0."joined", t0."admin" FROM "users" AS t0 WHERE ((t0."id" IN ($1, $2, $3)) AND (t0."age" IS NULL))
