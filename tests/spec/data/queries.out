SELECT t0."id", t0."name", t0."email", t0."age", t0."joined", t0."admin" FROM "users" AS t0 WHERE (EXISTS (SELECT 1 FROM "orders" AS s1 WHERE s1."user_id" = t0."id" AND (((s1."total" * 2) > 200))) OR (((SELECT COUNT(*) FROM "orders" AS s2 WHERE s2."user_id" = t0."id") >= 1) AND (NOT t0."admin")))
