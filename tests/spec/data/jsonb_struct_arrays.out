CREATE TABLE "orders" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "name" text NOT NULL,
    "items" jsonb NOT NULL,
    "extra" jsonb,
    "meta" jsonb NOT NULL
)
CREATE TABLE "orders" (
    "id" INTEGER PRIMARY KEY AUTOINCREMENT,
    "name" TEXT NOT NULL,
    "items" TEXT NOT NULL,
    "extra" TEXT,
    "meta" TEXT NOT NULL
)
a [] [{"Sku":"pen","Qty":3,"Price":1.5,"Owner":{"Name":"Ann"}},{"Sku":"ink","Qty":1,"Price":4,"Owner":null}]
b SQL NULL [{"Sku":"cup","Qty":2,"Price":3,"Owner":null}]
c [{"Sku":"mug","Qty":5,"Price":2,"Owner":null}] []
a penx3@Ann,inkx1@- extra=0 meta=1
b cupx2@- extra=nil meta=0
c  extra=1 meta=0
SELECT t0."id", t0."name", t0."items", t0."extra", t0."meta" FROM "orders" AS t0 WHERE EXISTS (SELECT 1 FROM json_each(t0."items") AS e1 WHERE (json_extract(e1.value, '$.Qty') > ?)) [2]
SELECT t0."id", t0."name", t0."items", t0."extra", t0."meta" FROM "orders" AS t0 WHERE EXISTS (SELECT 1 FROM jsonb_array_elements(t0."items") AS e1 WHERE (((e1 ->> 'Qty'))::bigint > $1))
any qty > 2 a
SELECT t0."id", t0."name", t0."items", t0."extra", t0."meta" FROM "orders" AS t0 WHERE NOT EXISTS (SELECT 1 FROM json_each(t0."items") AS e1 WHERE NOT ((json_extract(e1.value, '$.Price') >= ?) AND (json_extract(e1.value, '$.Sku') <> ?)))
SELECT t0."id", t0."name", t0."items", t0."extra", t0."meta" FROM "orders" AS t0 WHERE NOT EXISTS (SELECT 1 FROM jsonb_array_elements(t0."items") AS e1 WHERE NOT ((((e1 ->> 'Price'))::double precision >= $1) AND ((e1 ->> 'Sku') <> $2)))
all price >= 1.5 a,b,c
SELECT t0."id", t0."name", t0."items", t0."extra", t0."meta" FROM "orders" AS t0 WHERE EXISTS (SELECT 1 FROM jsonb_array_elements(t0."items") AS e1 WHERE (((e1 #>> '{Owner}') IS NOT NULL) AND ((e1 #>> '{Owner,Name}') = $1)))
owner a
SELECT t0."id", t0."name", t0."items", t0."extra", t0."meta" FROM "orders" AS t0 WHERE ((json_array_length(t0."items") >= ?) OR (json_array_length(json_extract(t0."meta", '$.Lines')) > ?))
SELECT t0."id", t0."name", t0."items", t0."extra", t0."meta" FROM "orders" AS t0 WHERE ((jsonb_array_length(t0."items") >= $1) OR (jsonb_array_length(CASE jsonb_typeof((t0."meta" #> '{Lines}')) WHEN 'array' THEN (t0."meta" #> '{Lines}') END) > $2))
len a
nested any a
SELECT t0."id", t0."name", t0."items", t0."extra", t0."meta" FROM "orders" AS t0 WHERE EXISTS (SELECT 1 FROM jsonb_array_elements(CASE jsonb_typeof((t0."meta" #> '{Lines}')) WHEN 'array' THEN (t0."meta" #> '{Lines}') END) AS e1 WHERE ((e1 ->> 'Sku') = $1))
extra nil b extra empty a
all over null and empty a,b,c
SELECT t0."name", (SELECT COUNT(*) FROM jsonb_array_elements(t0."items") AS e1 WHERE (((e1 ->> 'Qty'))::bigint > $1)), (SELECT COALESCE(CAST(SUM(((e2 ->> 'Qty'))::bigint) AS bigint), 0) FROM jsonb_array_elements(t0."items") AS e2) FROM "orders" AS t0 ORDER BY t0."id" ASC
stats [(a 2 4 8.5) (b 1 2 6) (c 0 0 0)]
[items] [extra] [extra]
