CREATE TABLE "users" (
    "id" bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    "name" text NOT NULL,
    "meta" jsonb NOT NULL,
    "tags" text[] NOT NULL,
    "nums" bigint[] NOT NULL
)
CREATE INDEX "ix_users_meta" ON "users" USING gin ("meta")
