// error: call of spec.data.err_untranslatable_call.isAdult is not allowed in an expression tree
// status: passing
namespace spec.data.err_untranslatable_call

struct User {
    Id    int
    Name  string
    Age   int
    @data.ignore Cache string
    Orders []*Order
}

struct Order {
    Id     int
    UserId int
    Total  float
}

struct Shop {
    data.Context
    Users  data.Set<User>
    Orders data.Set<Order>
}

func isAdult(u *User) bool {
    return u.Age >= 18
}

async func main() void! {
    var ctx = data.Open<Shop>(data.Provider.Sqlite, ":memory:")?
    _ = await ctx.Users.Where((u) => isAdult(u)).ToList()?
}
