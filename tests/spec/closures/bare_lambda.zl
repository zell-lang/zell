// test: a short lambda with one untyped parameter needs no parentheses: u => body, inferred from the expected function type
// status: passing
namespace spec.closures.bare_lambda

import io

func apply(f func(int) int, v int) int {
    return f(v)
}

func main() {
    var xs = [1, 2, 3]
    println(slices.Map(xs, x => x * 2))
    var g func(string) bool = s => s != ""
    println(g(""), g("a"))
    println(apply(n => {
        var k = n + 1
        return k * k
    }, 3))
    println(apply(n =>
        n - 1, 10))
}
