// test: `in` is a contextual keyword: a variable, a parameter and a field may be named `in`, and `for x in in` loops over it
// status: passing
namespace spec.control.in_contextual

import io

struct Pipe {
    in []int
    out int
}

func sum(in []int) int {
    var total = 0
    for x in in {
        total += x
    }
    return total
}

func main() {
    var in = [1, 2, 3]
    println(sum(in))
    for i, in in in {
        println(i, in)
    }
    var p = Pipe{in: [4, 5], out: 1}
    for v in p.in {
        p.out *= v
    }
    println(p.out, len(p.in))
    var in2 = in
    in = append(in, 4)
    println(in2, in)
}
