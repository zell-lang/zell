// error: try is not allowed in an expression tree
// status: passing
// test: try inside an expression tree
namespace spec.expr.err_try

import io

struct User {
    Name string
    Age int
}

func older(u *User) bool { return u.Age > 40 }

func parse(s string) int! { return len(s) }

func main() {
    var p expr<func(*User) bool> = u => u.Age > try parse("3") else 0
    println(p)
}
