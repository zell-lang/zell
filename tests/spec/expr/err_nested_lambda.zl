// error: a nested lambda is not allowed in an expression tree
// status: passing
// test: a lambda inside an expression tree
namespace spec.expr.err_nested_lambda

import io

struct User {
    Name string
    Age int
}

func older(u *User) bool { return u.Age > 40 }

func main() {
    var p expr<func(*User) bool> = u => slices.ContainsFunc([1, 2], x => x == u.Age)
    println(p)
}
