// error: a nested lambda is only allowed as an argument of a call in an expression tree
// status: passing
// test: a lambda inside an expression tree that is not an argument of a call (a lambda as the tree's result)
namespace spec.expr.err_nested_lambda

import io

struct User {
    Name string
    Age int
}

func main() {
    var p expr<func(*User) func() int> = u => () => u.Age
    println(p)
}
