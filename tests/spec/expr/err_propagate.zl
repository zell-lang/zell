// error: ? is not allowed in an expression tree
// status: passing
// test: error propagation inside an expression tree
namespace spec.expr.err_propagate

import io

struct User {
    Name string
    Age int
}

func older(u *User) bool { return u.Age > 40 }

func parse(s string) int! { return len(s) }

func main() {
    var p expr<func(*User) bool> = u => u.Age > parse("3")?
    println(p)
}
