// error: *Store does not implement Getter: method Get has type async func(int) string!, want func(int) Task<int!>
// status: passing
namespace spec.interfaces2.async_method_impl_error

interface Getter {
    func Get(n int) Task<int!>
}

// An `async` method implements `Get` only if its result is the task's:
// here it yields Task<string!>, not Task<int!>.
struct Store {
    async func Get(n int) string! { return "x" }
}

func main() {
    var g Getter = &Store{}
    _ = g
}
