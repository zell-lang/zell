// error: *Store does not implement Getter: method Get is async (calling it yields a task), want func(int) Task<int!>
// status: passing
namespace spec.interfaces2.async_method_impl_error

interface Getter {
    func Get(n int) Task<int!>
}

// An `async` method does not satisfy the interface: implement `Get` as a
// plain method returning the task of an async function.
struct Store {
    async func Get(n int) int! { return n }
}

func main() {
    var g Getter = &Store{}
    _ = g
}
