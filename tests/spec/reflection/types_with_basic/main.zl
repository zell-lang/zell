// test: reflect.TypesWith<A>() lists the marked structs of every file, by file path then declaration order; unmarked types are left out
// status: passing
namespace spec.reflection.types_with_basic

import io

@attribute(targets: [reflect.Target.Struct])
struct Entity {
    Table string
}

@Entity(Table: "users")
struct User {
    Id int
}

struct NotMarked {
    X int
}

@Entity(Table: "orders")
struct Order {
    Id    int
    Total int
}

func main() {
    var ts = reflect.TypesWith<Entity>()
    println(len(ts))
    for t in ts {
        println(t.FullName, t.Package, t.Attribute<Entity>().Table, len(t.Fields))
    }
    // a constant slice: the same tables on every call
    println(reflect.TypesWith<Entity>()[0] == ts[0], ts[1] == reflect.TypeOf<Order>())
}
