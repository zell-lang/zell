// error: @range needs a number, a string or a slice; Active is bool
// status: passing
// stderr: raised by Check<Account>
namespace spec.reflection.reflect_error_attr_on_bool

import io

@attribute(targets: [reflect.Target.Field])
struct range {
    min int
    max int
}

struct Account {
    @range(min: 1, max: 64) Name string
    @range(min: 0, max: 1) Active bool
}

// A misplaced attribute is rejected at compile time: the condition is a
// constant per field, so reflect.Error fires only for the bad one.
func Check<T>(v T) int {
    var n = 0
    for f in reflect.Fields<T>() {
        if f.Attribute<range>() != nil && f.Type.Kind != reflect.Kind.Int && f.Type.Kind != reflect.Kind.String && f.Type.Kind != reflect.Kind.Slice {
            reflect.Error("@range needs a number, a string or a slice; " + f.Name + " is " + f.Type.Name)
        }
        n += 1
    }
    return n
}

func main() {
    println(Check(Account{}))
}
