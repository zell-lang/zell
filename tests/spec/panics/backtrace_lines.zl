// test: a panic backtrace names the source file, line and function of every Zell frame (DESIGN.md "Паника", ABI.md 8.2), paths relative to the working directory
// status: passing
// exit: 2
// env: ZELL_NO_BACKTRACE=
// stderr: panic: runtime error: index out of range [5] with length 3
// stderr: backtrace (most recent call first):
// stderr:   tests/spec/panics/backtrace_lines.zl:17 inner
// stderr:   tests/spec/panics/backtrace_lines.zl:21 middle
// stderr:   tests/spec/panics/backtrace_lines.zl:26 outer
// stderr:   tests/spec/panics/backtrace_lines.zl:31 main
namespace spec.panics.backtrace_lines

import io

func inner(xs []int, i int) int {
    var k = i + 1
    return xs[k]
}

func middle(xs []int) int {
    return inner(xs, 4) + 1
}

func outer() int {
    var xs = [1, 2, 3]
    return middle(xs) + 1
}

func main() {
    println("start")
    println(outer())
}
