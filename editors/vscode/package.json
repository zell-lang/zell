{
  "name": "zell",
  "displayName": "Zell",
  "description": "Zell language support: syntax highlighting and the zell-lsp language server (diagnostics with quick fixes, navigation, hover, rename, completion, signature help, inlay hints, formatting, semantic highlighting, code lenses to run tests) and debugging through lldb-dap with Zell value formatters",
  "version": "0.3.0",
  "publisher": "zell",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:zell",
    "workspaceContains:**/zell.{toml,json,yaml,yml}",
    "onDebugResolve:zell",
    "onDebugDynamicConfigurations:zell",
    "onDebugInitialConfigurations"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zell",
        "aliases": [
          "Zell",
          "zell"
        ],
        "extensions": [
          ".zl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zell",
        "scopeName": "source.zell",
        "path": "./syntaxes/zell.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "zell.restartServer",
        "title": "Restart server",
        "category": "Zell"
      },
      {
        "command": "zell.fmt",
        "title": "Format document (zell fmt)",
        "category": "Zell"
      },
      {
        "command": "zell.runTest",
        "title": "Run test",
        "category": "Zell"
      },
      {
        "command": "zell.debugTest",
        "title": "Debug test",
        "category": "Zell"
      },
      {
        "command": "zell.run",
        "title": "Run",
        "category": "Zell"
      },
      {
        "command": "zell.showReferences",
        "title": "Show references",
        "category": "Zell"
      },
      {
        "command": "zell.showOutput",
        "title": "Show language server output",
        "category": "Zell"
      }
    ],
    "configuration": {
      "title": "Zell",
      "properties": {
        "zell.serverPath": {
          "type": "string",
          "default": "zell-lsp",
          "markdownDescription": "Path to the language server executable. Empty or `zell-lsp`: look for `zell-lsp` on `PATH`, then next to the `zell` CLI found on `PATH` (the toolchain archive layout `bin/zell-lsp`), then use `zell lsp`. A path to the `zell` CLI also works (it is started as `zell lsp`)."
        },
        "zell.serverArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments passed to the language server."
        },
        "zell.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the Zell language server."
        },
        "zell.inlayHints.types.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the inferred type after names declared with `var x = ...` (and `for x in ...`)."
        },
        "zell.inlayHints.parameterNames.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show parameter names before literal arguments at call sites (`Open(owner: \"alice\", initial: 100)`)."
        },
        "zell.path": {
          "type": "string",
          "default": "zell",
          "markdownDescription": "The `zell` CLI used to build programs for debugging (`zell build`) and to locate the lldb formatters (`zell debug --formatters lldb`)."
        },
        "zell.debug.lldbDapPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `lldb-dap` (LLVM 18+; `lldb-vscode` in older LLVMs). Empty: look for `lldb-dap`, `lldb-dap-18`, ... on `PATH`."
        },
        "zell.debug.formatters": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `tools/lldb/zell_formatters.py`. Empty: ask `zell debug --formatters lldb`."
        },
        "zell.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the analyzer state (`zell/analyzerStatus`: idle, analysing, queued requests) in the status bar."
        }
      }
    },
    "configurationDefaults": {
      "[zell]": {
        "editor.defaultFormatter": "zell.zell",
        "editor.formatOnSave": true
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "zell.fmt",
          "when": "editorLangId == zell"
        },
        {
          "command": "zell.runTest",
          "when": "false"
        },
        {
          "command": "zell.debugTest",
          "when": "false"
        },
        {
          "command": "zell.run",
          "when": "false"
        },
        {
          "command": "zell.showReferences",
          "when": "false"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "zell"
      }
    ],
    "debuggers": [
      {
        "type": "zell",
        "label": "Zell",
        "languages": [
          "zell"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "adapter": {
                "type": "string",
                "enum": [
                  "agent",
                  "lldb"
                ],
                "default": "agent",
                "enumDescriptions": [
                  "The in-process debug agent (debug): the program is started with ZELL_DEBUG=127.0.0.1:0,wait and VS Code connects to it over DAP (docs/DEBUGGER.md stage 2).",
                  "lldb-dap with the Zell formatters (stage 1; DWARF, needs LLDB 18+)."
                ],
                "description": "Debug adapter: the in-process agent (default) or lldb-dap."
              },
              "program": {
                "type": "string",
                "description": "Executable to debug (built with debug info: any non-release `zell build`, or `--release -g`)."
              },
              "source": {
                "type": "string",
                "description": "A .zl file or project directory: built with `zell build` before launching when no preLaunchTask is set (`program` defaults to target/zell-debug/<name>)."
              },
              "build": {
                "type": "boolean",
                "default": true,
                "description": "Build `source` before launching (ignored with a preLaunchTask)."
              },
              "buildArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra `zell build` arguments, e.g. [\"--release\", \"-g\"]."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Program arguments."
              },
              "env": {
                "type": [
                  "object",
                  "array"
                ],
                "default": {},
                "description": "Environment variables: an object {\"NAME\": \"value\"} or [\"NAME=value\"]."
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "Working directory of the program."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Stop at the program entry point."
              },
              "initCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra lldb commands run before the target is created (after the Zell formatters are imported)."
              },
              "preRunCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "lldb commands run just before launching or attaching."
              },
              "stopCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "lldb commands run each time the process stops."
              }
            }
          },
          "attach": {
            "properties": {
              "adapter": {
                "type": "string",
                "enum": [
                  "agent",
                  "lldb"
                ],
                "default": "agent",
                "enumDescriptions": [
                  "The in-process debug agent (debug): the program is started with ZELL_DEBUG=127.0.0.1:0,wait and VS Code connects to it over DAP (docs/DEBUGGER.md stage 2).",
                  "lldb-dap with the Zell formatters (stage 1; DWARF, needs LLDB 18+)."
                ],
                "description": "Debug adapter: the in-process agent (default) or lldb-dap."
              },
              "address": {
                "type": "string",
                "description": "agent: [host:]port of a program started with ZELL_DEBUG (e.g. \"127.0.0.1:2345\" or \":2345\")."
              },
              "host": {
                "type": "string",
                "default": "127.0.0.1",
                "description": "agent: host of the debug agent."
              },
              "port": {
                "type": "number",
                "description": "agent: port of the debug agent."
              },
              "pid": {
                "type": [
                  "number",
                  "string"
                ],
                "description": "lldb: process id to attach to (asked for when missing)."
              },
              "program": {
                "type": "string",
                "description": "Executable of the process (optional with pid)."
              },
              "waitFor": {
                "type": "boolean",
                "default": false,
                "description": "Wait for a process named after `program` to start."
              },
              "initCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra lldb commands run before the target is created (after the Zell formatters are imported)."
              },
              "preRunCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "lldb commands run just before launching or attaching."
              },
              "stopCommands": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "lldb commands run each time the process stops."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "zell",
            "request": "launch",
            "name": "Debug Zell file",
            "source": "${file}",
            "program": "${workspaceFolder}/target/zell-debug/${fileBasenameNoExtension}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "zell: build"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Zell: Launch",
            "description": "Build a .zl file with debug info and debug it",
            "body": {
              "type": "zell",
              "request": "launch",
              "name": "Debug ${1:program}",
              "source": "^\"\\${file}\"",
              "args": [],
              "cwd": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "Zell: Attach to process (lldb)",
            "description": "Attach lldb-dap to a running Zell program",
            "body": {
              "type": "zell",
              "request": "attach",
              "name": "Attach",
              "pid": "^\"\\${command:pickProcess}\"",
              "adapter": "lldb"
            }
          },
          {
            "label": "Zell: Attach to the debug agent",
            "description": "Connect to a program started with ZELL_DEBUG=:2345 (or `zell debug run --headless --port 2345`)",
            "body": {
              "type": "zell",
              "request": "attach",
              "name": "Attach to agent",
              "adapter": "agent",
              "address": ":2345"
            }
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "zell",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "test",
              "run"
            ],
            "description": "`build`: zell build <source> -o <program> (debug info included); `test` and `run` are started by the code lenses."
          },
          "source": {
            "type": "string",
            "description": "File or project to build (default: the active file)."
          },
          "program": {
            "type": "string",
            "description": "Output executable (default: target/zell-debug/<name>)."
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra `zell build` arguments."
          }
        }
      }
    ],
    "snippets": [
      {
        "language": "zell",
        "path": "./snippets/zell.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "zell",
        "scopes": {
          "namespace": [
            "entity.name.namespace.zell"
          ],
          "type": [
            "entity.name.type.zell"
          ],
          "struct": [
            "entity.name.type.struct.zell"
          ],
          "enum": [
            "entity.name.type.enum.zell"
          ],
          "enumMember": [
            "variable.other.enummember.zell"
          ],
          "interface": [
            "entity.name.type.interface.zell"
          ],
          "function": [
            "entity.name.function.zell"
          ],
          "method": [
            "entity.name.function.member.zell"
          ],
          "property": [
            "variable.other.property.zell"
          ],
          "variable": [
            "variable.other.readwrite.zell"
          ],
          "variable.readonly": [
            "variable.other.constant.zell"
          ],
          "parameter": [
            "variable.parameter.zell"
          ],
          "keyword": [
            "keyword.control.zell"
          ],
          "string": [
            "string.quoted.double.zell"
          ],
          "number": [
            "constant.numeric.zell"
          ],
          "comment": [
            "comment.line.double-slash.zell"
          ],
          "operator": [
            "keyword.operator.zell"
          ]
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "zell",
        "owner": "zell",
        "source": "zell",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning): (.*)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s*-->\\s+(.*):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --sourcemap --outfile=out/extension.js",
    "build": "npm run typecheck && npm run bundle",
    "watch": "npm run bundle -- --watch",
    "vscode:prepublish": "npm run typecheck && npm run bundle -- --minify",
    "compile": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "1.82.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zell-lang/zell"
  }
}
