// Typed text templates with Go text/template syntax: {{.Field.Sub}},
// {{$}}, {{$x := pipeline}}, pipelines with | and builtin or custom
// functions, {{if}}/{{else if}}/{{else}}, {{range [$i, $e :=] ...}} (with
// {{break}}/{{continue}}/{{else}}), {{with}}, {{define}}/{{template}}/
// {{block}}, comments {{/* */}} and trim markers {{- -}}.
//
// Parse<T> checks every field path against T: at compile time when the
// source is a string literal (sema/litcheck.rs), otherwise at run time
// from T's reflection table, so a misspelt field is an error before any
// data is rendered. Execute converts the data to a dynamic Value tree
// (compile-time reflection) and interprets the template over it. Struct
// methods cannot be called (fields only).
//
// html.template uses this engine with contextual escaping: every
// action is escaped for where it appears (text, attribute, URL, JS, CSS),
// as Go's html/template does (see htmlctx.zl).
namespace text.template

// A dynamic value: nil, bool, int, float, string, list, map (sorted keys),
// struct (fields in order), or safe HTML / URL / JS text (html templates).
struct Value {
    kind     int
    b        bool
    i        int
    f        float
    s        string
    items    []Value
    keys     []string
    typeName string
    // maps: the zero value of the element type (for missing keys)
    zero []Value

    // IsNil reports whether the value is nil (missing).
    func IsNil() bool {
        return this.kind == 0
    }

    // The value as text (as {{.}} prints it).
    func Text() string {
        return show(*this)
    }

    // A field / map entry ("" for others).
    func Get(name string) Value {
        for i, k in this.keys {
            if k == name {
                return this.items[i]
            }
        }
        return Value{}
    }

    // Len returns the length of a string or list (0 otherwise).
    func Len() int {
        if this.kind == 4 {
            return len(this.s)
        }
        return len(this.items)
    }

    // Index returns element i of a list (nil if out of range).
    func Index(i int) Value {
        if (this.kind == 5) && i >= 0 && i < len(this.items) {
            return this.items[i]
        }
        return Value{}
    }

    // Int returns the value as an int; an error for non-numbers.
    func Int() int! {
        if this.kind == 2 {
            return this.i
        }
        if this.kind == 3 && this.f == math.Trunc(this.f) {
            return int(this.f)
        }
        return error("template: " + kindName(this.kind) + " is not an int")
    }

    // Float returns the value as a float; an error for non-numbers.
    func Float() float! {
        if this.kind == 2 {
            return float(this.i)
        }
        if this.kind == 3 {
            return this.f
        }
        return error("template: " + kindName(this.kind) + " is not a number")
    }

    // Bool returns the truth of the value (false, 0, "", nil and empty lists are false).
    func Bool() bool {
        return truth(*this)
    }

    // Items returns the elements of a list.
    func Items() []Value {
        return this.items
    }
}

// Str returns a string value.
func Str(s string) Value {
    return Value{kind: 4, s: s}
}

// Int returns an int value.
func Int(i int) Value {
    return Value{kind: 2, i: i}
}

// Float returns a float value.
func Float(f float) Value {
    return Value{kind: 3, f: f}
}

// Bool returns a bool value.
func Bool(b bool) Value {
    return Value{kind: 1, b: b}
}

// List returns a list value.
func List(items []Value) Value {
    return Value{kind: 5, items: items}
}

// Nil returns the nil value.
func Nil() Value {
    return Value{}
}

func kindName(k int) string {
    if k == 0 {
        return "nil"
    }
    if k == 1 {
        return "bool"
    }
    if k == 2 {
        return "int"
    }
    if k == 3 {
        return "float"
    }
    if k == 4 || k >= 8 {
        return "string"
    }
    if k == 5 {
        return "list"
    }
    if k == 6 {
        return "map"
    }
    return "struct"
}

// The dynamic Value of v (compile-time reflection).
func ValueOf<T>(v T) Value {
    if reflect.TypeOf<T>() == reflect.TypeOf<Value>() {
        return v
    } else if reflect.TypeOf<T>() == reflect.TypeOf<html.template.HTML>() {
        return Value{kind: 8, s: v.Text}
    } else if reflect.TypeOf<T>() == reflect.TypeOf<html.template.URL>() {
        return Value{kind: 9, s: v.Text}
    } else if reflect.TypeOf<T>() == reflect.TypeOf<html.template.JS>() {
        return Value{kind: 10, s: v.Text}
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Struct {
        var keys []string = []
        var vals []Value = []
        for f in reflect.Fields<T>() {
            keys = append(keys, f.Name)
            vals = append(vals, ValueOf(f.Get(v)))
        }
        return Value{kind: 7, keys: keys, items: vals, typeName: reflect.TypeOf<T>().Name}
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.String {
        return Value{kind: 4, s: v}
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Bool {
        return Value{kind: 1, b: v}
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Int ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Int8 ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Int16 ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Int32 ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Uint ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Uint8 ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Uint16 ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Uint32 {
        return Value{kind: 2, i: int(v)}
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Float ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Float32 {
        return Value{kind: 3, f: float(v)}
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Char {
        return Value{kind: 4, s: string(v)}
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Enum {
        return Value{kind: 4, s: fmt.Format("{0}", v)}
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Slice ||
        reflect.TypeOf<T>().Kind == reflect.Kind.Array {
        var items []Value = []
        for x in v {
            items = append(items, ValueOf(x))
        }
        return Value{kind: 5, items: items}
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Map {
        var keys []string = []
        var vals []Value = []
        var nums []int = []
        var numeric = reflect.TypeOf<T>().Key.Kind == reflect.Kind.Int
        for k, x in v {
            keys = append(keys, fmt.Format("{0}", k))
            vals = append(vals, ValueOf(x))
            if numeric {
                nums = append(nums, try strings.ToInt(fmt.Format("{0}", k)) else 0)
            }
        }
        sortPairs(keys, vals, nums, numeric)
        return Value{kind: 6, keys: keys, items: vals, zero: [mapZero(v)]}
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Pointer {
        if v == nil {
            return Value{s: "<nil>"}
        }
        return ValueOf(*v)
    } else if reflect.TypeOf<T>().Kind == reflect.Kind.Any {
        return anyValue(v)
    } else {
        return Value{kind: 4, s: reflect.TypeOf<T>().Name}
    }
}

func mapZero<K, V>(m map[K]V) Value {
    var z V
    return ValueOf(z)
}

func anyValue(x any) Value {
    switch x {
        case string s:
            return Value{kind: 4, s: s}
        case int n:
            return Value{kind: 2, i: n}
        case float f:
            return Value{kind: 3, f: f}
        case bool b:
            return Value{kind: 1, b: b}
        case Value v:
            return v
        default:
            return Value{}
    }
}

func sortPairs(keys []string, vals []Value, nums []int, numeric bool) {
    for i in 1..len(keys) {
        var j = i
        for j > 0 && ((numeric && nums[j - 1] > nums[j]) || (!numeric && keys[j - 1] > keys[j])) {
            var k = keys[j]
            keys[j] = keys[j - 1]
            keys[j - 1] = k
            var x = vals[j]
            vals[j] = vals[j - 1]
            vals[j - 1] = x
            if numeric {
                var n = nums[j]
                nums[j] = nums[j - 1]
                nums[j - 1] = n
            }
            j -= 1
        }
    }
}

// -- templates ----------------------------------------------------------------------

// A parsed template for data of type T.
struct Template<T> {
    t *tmpl

    // Renders the template for data.
    func Execute(data T) string! {
        return this.t.execute(this.t.root, ValueOf(data))?
    }

    // Renders a template defined with {{define "name"}}.
    func ExecuteTemplate(name string, data T) string! {
        var n = this.t.defs[name]
        if n == 0 {
            return error(
                "template: no template " +
                    encoding.json.Quote(name) +
                    " defined in " +
                    this.t.name,
            )
        }
        return this.t.execute(n - 1, ValueOf(data))?
    }

    // Name returns the template name.
    func Name() string {
        return this.t.name
    }

    // The names of the {{define}}d templates, sorted.
    func Defined() []string {
        var out []string = []
        for k, _ in this.t.defs {
            out = append(out, k)
        }
        sortStrings(out)
        return out
    }
}

// A custom function: receives the evaluated arguments.
func Funcs() map[string]func([]Value) Value! {
    return map[string]func([]Value) Value!{}
}

// Parses a template for data of type T (fields checked against T).
func Parse<T>(src string) Template<T>! {
    return ParseNamed<T>("template", src)?
}

// ParseNamed is Parse with a template name (shown in errors).
func ParseNamed<T>(name string, src string) Template<T>! {
    var none = map[string]func([]Value) Value!{}
    var t = build(name, src, none, false)?
    checkTypes(t, reflect.TypeOf<T>())?
    return Template<T>{t: t}
}

// Parses with custom functions (callable as {{name args}}).
func ParseWith<T>(src string, funcs map[string]func([]Value) Value!) Template<T>! {
    var t = build("template", src, funcs, false)?
    checkTypes(t, reflect.TypeOf<T>())?
    return Template<T>{t: t}
}

// For html.template: parse with contextual escaping.
func parseHTML<T>(name string, src string, funcs map[string]func([]Value) Value!) Template<T>! {
    var t = build(name, src, funcs, true)?
    checkTypes(t, reflect.TypeOf<T>())?
    return Template<T>{t: t}
}

func build(name string, src string, funcs map[string]func([]Value) Value!, html bool) *tmpl! {
    var t = &tmpl{
        name: name,
        src: src,
        funcs: funcs,
        html: html,
        defs: map[string]int{},
        fnames: map[string]bool{},
    }
    for k, _ in funcs {
        t.fnames[k] = true
    }
    var p = tparser{t: t, src: src, line: 1}
    var r = p.list()?
    if r.end != "" {
        return t.fail(p.line, "unexpected {{" + r.end + "}}")
    }
    t.nodes = append(t.nodes, tnode{kind: 0, list: r.list})
    t.root = len(t.nodes) - 1
    if html {
        escapeAll(t)?
    }
    return t
}

// -- tree --------------------------------------------------------------------------

// Node kinds: 0 list, 1 text, 2 action, 3 if, 4 range, 5 with, 6 template
// call, 8 break, 9 continue.
struct tnode {
    kind     int
    text     string
    pipe     int
    list     []int
    elseList []int
    hasElse  bool
    name     string
    line     int
    esc      int
}

struct tpipe {
    vars   []string
    assign bool
    cmds   []tcmd
    line   int
    // exactly one command with one argument: a one-element field chain on dot
    simple bool
}

struct tcmd {
    args []targ
}

// Argument kinds: 1 field chain on dot, 2 variable (+ fields), 3 dot,
// 4 identifier (function), 5 string, 6 int, 7 float, 8 bool, 9 nil,
// 10 parenthesized pipeline (+ fields).
struct targ {
    kind   int
    name   string
    fields []string
    s      string
    i      int
    f      float
    b      bool
    pipe   int
}

struct tmpl {
    name   string
    src    string
    nodes  []tnode
    pipes  []tpipe
    defs   map[string]int
    root   int
    funcs  map[string]func([]Value) Value!
    fnames map[string]bool
    html   bool

    func fail(line int, msg string) error {
        return error(fmt.Format("template: {0}:{1}: {2}", this.name, line, msg))
    }

    func add(n tnode) int {
        this.nodes = append(this.nodes, n)
        return len(this.nodes) - 1
    }

    func execute(node int, data Value) string! {
        var b = strings.Builder{}
        var ex = executor{t: this, out: &b}
        ex.names = ["$"]
        ex.vals = [data]
        ex.run(this.nodes[node].list, data, 0)?
        return b.String()
    }
}

struct listResult {
    list []int
    end  string
    // for "else if" / "else with": the keyword after else
    elseKw string
}

// -- parser --------------------------------------------------------------------------

struct tparser {
    t        *tmpl
    src      string
    pos      int
    line     int
    trimNext bool
    // set while inside {{range}} (break/continue allowed)
    rangeDepth int
    vars       []string
    // the end of the current action (after }} and a trim marker)
    actEnd int

    func fail(msg string) error {
        return this.t.fail(this.line, msg)
    }

    // Parses nodes up to {{end}} / {{else}} or the end of the source.
    func list() listResult! {
        var nodes []int = []
        for {
            var open = regex.rtIndex(this.src, "{{", this.pos)
            var textEnd = open
            if open < 0 {
                textEnd = len(this.src)
            }
            var text = this.src[this.pos..textEnd]
            if this.trimNext {
                text = strings.TrimLeft(text, " \t\r\n")
                this.trimNext = false
            }
            var trimLeft = open >= 0 &&
                open + 2 < len(this.src) &&
                int(this.src[open + 2]) == 45 &&
                open + 3 < len(this.src) &&
                isSpace(int(this.src[open + 3]))
            if trimLeft {
                text = strings.TrimRight(text, " \t\r\n")
            }
            if text != "" {
                nodes = append(nodes, this.t.add(tnode{kind: 1, text: text, line: this.line}))
            }
            this.line += countLines(this.src[this.pos..textEnd])
            if open < 0 {
                this.pos = len(this.src)
                return listResult{list: nodes}
            }
            this.pos = open + 2
            if trimLeft {
                this.pos += 2
            }
            this.skipSpace()
            // comment
            if strings.HasPrefix(this.src[this.pos..], "/*") {
                var close = regex.rtIndex(this.src, "*/", this.pos + 2)
                if close < 0 {
                    return this.fail("unclosed comment")
                }
                this.line += countLines(this.src[this.pos..close])
                this.pos = close + 2
                this.closeAction()?
                continue
            }
            var kw = this.peekWord()
            if kw == "end" {
                this.pos += 3
                this.closeAction()?
                return listResult{list: nodes, end: "end"}
            }
            if kw == "else" {
                this.pos += 4
                this.skipSpace()
                var next = this.peekWord()
                if next == "if" || next == "with" {
                    return listResult{list: nodes, end: "else", elseKw: next}
                }
                this.closeAction()?
                return listResult{list: nodes, end: "else"}
            }
            if kw == "if" || kw == "with" || kw == "range" {
                this.pos += len(kw)
                nodes = append(nodes, this.control(kw)?)
                continue
            }
            if kw == "define" || kw == "block" {
                this.pos += len(kw)
                var n = this.define(kw == "block")?
                if n >= 0 {
                    nodes = append(nodes, n)
                }
                continue
            }
            if kw == "template" {
                this.pos += 8
                this.skipSpace()
                var name = this.stringLit()?
                this.skipSpace()
                var pipe = -1
                if !this.atActionEnd() {
                    pipe = this.pipeline(false)?
                }
                this.closeAction()?
                nodes = append(nodes, this.t.add(tnode{
                    kind: 6,
                    name: name,
                    pipe: pipe,
                    line: this.line,
                }))
                continue
            }
            if kw == "break" || kw == "continue" {
                if this.rangeDepth == 0 {
                    return this.fail("{{" + kw + "}} outside {{range}}")
                }
                this.pos += len(kw)
                this.closeAction()?
                var k = 8
                if kw == "continue" {
                    k = 9
                }
                nodes = append(nodes, this.t.add(tnode{kind: k, line: this.line}))
                continue
            }
            var line = this.line
            var pipe = this.pipeline(true)?
            this.closeAction()?
            nodes = append(nodes, this.t.add(tnode{kind: 2, pipe: pipe, line: line}))
        }
    }

    // if / with / range up to the matching {{end}} (else-chains included).
    func control(kw string) int! {
        var line = this.line
        var mark = len(this.vars)
        var pipe = this.pipeline(true)?
        this.closeAction()?
        if kw == "range" {
            this.rangeDepth += 1
        }
        var body = this.list()?
        if kw == "range" {
            this.rangeDepth -= 1
        }
        var kind = 3
        if kw == "range" {
            kind = 4
        } else if kw == "with" {
            kind = 5
        }
        var n = tnode{kind: kind, pipe: pipe, list: body.list, line: line}
        if body.end == "" {
            return this.fail("unexpected EOF: missing {{end}} for {{" + kw + "}}")
        }
        if body.end == "else" {
            n.hasElse = true
            if body.elseKw != "" {
                // {{else if ...}}: a nested control that ends with the same {{end}}
                if kw == "range" {
                    return this.fail("{{else " + body.elseKw + "}} after {{range}}")
                }
                this.pos += len(body.elseKw)
                var nested = this.control(body.elseKw)?
                n.elseList = [nested]
            } else {
                var els = this.list()?
                if els.end != "end" {
                    if els.end == "" {
                        return this.fail("unexpected EOF: missing {{end}} for {{" + kw + "}}")
                    }
                    return this.fail("expected {{end}}, found {{" + els.end + "}}")
                }
                n.elseList = els.list
            }
        }
        this.vars = this.vars[..mark]
        return this.t.add(n)
    }

    func define(block bool) int! {
        this.skipSpace()
        var name = this.stringLit()?
        this.skipSpace()
        var pipe = -1
        if block {
            pipe = this.pipeline(false)?
        }
        this.closeAction()?
        var saved = this.vars
        this.vars = []
        var body = this.list()?
        this.vars = saved
        if body.end != "end" {
            return this.fail("unexpected EOF: missing {{end}} for {{define}}")
        }
        if this.t.defs[name] != 0 {
            return this.fail("template " + encoding.json.Quote(name) + " redefined")
        }
        this.t.nodes = append(this.t.nodes, tnode{kind: 0, list: body.list})
        this.t.defs[name] = len(this.t.nodes)
        if block {
            return this.t.add(tnode{kind: 6, name: name, pipe: pipe, line: this.line})
        }
        return -1
    }

    // Expects the end of an action (" -}}" trims the following text).
    func closeAction() void! {
        this.skipSpace()
        if strings.HasPrefix(this.src[this.pos..], "-}}") {
            this.pos += 3
            this.trimNext = true
            return
        }
        if strings.HasPrefix(this.src[this.pos..], "}}") {
            this.pos += 2
            return
        }
        if this.pos >= len(this.src) {
            return this.fail("unclosed action")
        }
        return this.fail(
            "unexpected " +
                encoding.json.Quote(
                    this.src[this.pos..math.IMin(this.pos + 10, len(this.src))],
                ) +
                " in action",
        )
    }

    func atActionEnd() bool {
        var r = this.src[this.pos..]
        return strings.HasPrefix(r, "}}") || strings.HasPrefix(r, "-}}") || r == ""
    }

    func skipSpace() {
        for this.pos < len(this.src) && isSpace(int(this.src[this.pos])) {
            if int(this.src[this.pos]) == 10 {
                this.line += 1
            }
            this.pos += 1
        }
    }

    func peekWord() string {
        var i = this.pos
        for i < len(this.src) && isIdent(int(this.src[i])) {
            i += 1
        }
        return this.src[this.pos..i]
    }

    func stringLit() string! {
        if this.pos >= len(this.src) {
            return this.fail("expected a template name")
        }
        var c = int(this.src[this.pos])
        if c == 34 {
            return this.quoted()?
        }
        if c == 96 {
            var close = regex.rtIndex(this.src, "`", this.pos + 1)
            if close < 0 {
                return this.fail("unterminated raw string")
            }
            var s = this.src[this.pos + 1..close]
            this.pos = close + 1
            return s
        }
        return this.fail("expected a quoted template name")
    }

    func quoted() string! {
        this.pos += 1
        var b = strings.Builder{}
        for {
            if this.pos >= len(this.src) || int(this.src[this.pos]) == 10 {
                return this.fail("unterminated quoted string")
            }
            var c = int(this.src[this.pos])
            if c == 34 {
                this.pos += 1
                return b.String()
            }
            if c == 92 && this.pos + 1 < len(this.src) {
                var e = int(this.src[this.pos + 1])
                this.pos += 2
                if e == 110 {
                    b.Write("\n")
                } else if e == 116 {
                    b.Write("\t")
                } else if e == 114 {
                    b.Write("\r")
                } else if e == 34 || e == 92 || e == 39 {
                    b.Write(string(char(e)))
                } else {
                    return this.fail("invalid escape in a string")
                }
                continue
            }
            b.Write(this.src[this.pos..this.pos + 1])
            this.pos += 1
        }
    }

    // A pipeline, with an optional variable declaration.
    func pipeline(allowDecl bool) int! {
        var p = tpipe{line: this.line}
        this.skipSpace()
        // $x := / $x = / $i, $e :=
        var save = this.pos
        if allowDecl && this.pos < len(this.src) && int(this.src[this.pos]) == 36 {
            var names []string = []
            var ok = false
            for {
                var start = this.pos
                this.pos += 1
                for this.pos < len(this.src) && isIdent(int(this.src[this.pos])) {
                    this.pos += 1
                }
                names = append(names, this.src[start..this.pos])
                this.skipSpace()
                if strings.HasPrefix(this.src[this.pos..], ":=") {
                    this.pos += 2
                    ok = true
                    break
                }
                if strings.HasPrefix(this.src[this.pos..], "=") &&
                    !strings.HasPrefix(this.src[this.pos..], "==") {
                    this.pos += 1
                    p.assign = true
                    ok = true
                    break
                }
                if this.pos < len(this.src) && int(this.src[this.pos]) == 44 && len(names) == 1 {
                    this.pos += 1
                    this.skipSpace()
                    if this.pos < len(this.src) && int(this.src[this.pos]) == 36 {
                        continue
                    }
                }
                break
            }
            if ok {
                for n in names {
                    if p.assign {
                        if !this.hasVar(n) {
                            return this.fail("undefined variable " + n)
                        }
                    }
                }
                p.vars = names
            } else {
                this.pos = save
            }
        }
        for {
            this.skipSpace()
            var cmd = tcmd{}
            for {
                this.skipSpace()
                if this.atActionEnd() || this.pos >= len(this.src) {
                    break
                }
                var c = int(this.src[this.pos])
                if c == 124 || c == 41 {
                    break
                }
                cmd.args = append(cmd.args, this.operand()?)
            }
            if len(cmd.args) == 0 {
                return this.fail("missing value for command")
            }
            p.cmds = append(p.cmds, cmd)
            this.skipSpace()
            if this.pos < len(this.src) && int(this.src[this.pos]) == 124 {
                this.pos += 1
                continue
            }
            break
        }
        // declared variables are visible after the pipeline
        if !p.assign {
            for n in p.vars {
                this.vars = append(this.vars, n)
            }
        }
        if len(p.vars) == 0 && len(p.cmds) == 1 && len(p.cmds[0].args) == 1 {
            var a0 = p.cmds[0].args[0]
            p.simple = a0.kind == 1 && len(a0.fields) == 1
        }
        this.t.pipes = append(this.t.pipes, p)
        return len(this.t.pipes) - 1
    }

    func hasVar(n string) bool {
        if n == "$" {
            return true
        }
        for v in this.vars {
            if v == n {
                return true
            }
        }
        return false
    }

    func operand() targ! {
        var a = this.term()?
        // field chain after a variable or a parenthesized pipeline
        if a.kind == 2 || a.kind == 10 {
            for this.pos < len(this.src) &&
                int(this.src[this.pos]) == 46 &&
                this.pos + 1 < len(this.src) &&
                isIdent(int(this.src[this.pos + 1])) {
                this.pos += 1
                var start = this.pos
                for this.pos < len(this.src) && isIdent(int(this.src[this.pos])) {
                    this.pos += 1
                }
                a.fields = append(a.fields, this.src[start..this.pos])
            }
        }
        return a
    }

    func term() targ! {
        var c = int(this.src[this.pos])
        if c == 46 {
            // . or .Field.Chain
            if this.pos + 1 < len(this.src) && isIdent(int(this.src[this.pos + 1])) {
                var a = targ{kind: 1}
                for this.pos < len(this.src) &&
                    int(this.src[this.pos]) == 46 &&
                    this.pos + 1 < len(this.src) &&
                    isIdent(int(this.src[this.pos + 1])) {
                    this.pos += 1
                    var start = this.pos
                    for this.pos < len(this.src) && isIdent(int(this.src[this.pos])) {
                        this.pos += 1
                    }
                    a.fields = append(a.fields, this.src[start..this.pos])
                }
                return a
            }
            this.pos += 1
            return targ{kind: 3}
        }
        if c == 36 {
            var start = this.pos
            this.pos += 1
            for this.pos < len(this.src) && isIdent(int(this.src[this.pos])) {
                this.pos += 1
            }
            var name = this.src[start..this.pos]
            if !this.hasVar(name) {
                return this.fail("undefined variable " + name)
            }
            return targ{kind: 2, name: name}
        }
        if c == 34 {
            return targ{kind: 5, s: this.quoted()?}
        }
        if c == 96 {
            return targ{kind: 5, s: this.stringLit()?}
        }
        if c == 39 {
            // a character constant: its code point
            var close = regex.rtIndex(this.src, "'", this.pos + 1)
            if close < 0 {
                return this.fail("unterminated character constant")
            }
            var body = this.src[this.pos + 1..close]
            this.pos = close + 1
            var r = strings.Runes(body)
            if len(r) != 1 {
                return this.fail("invalid character constant")
            }
            return targ{kind: 6, i: int(r[0])}
        }
        if c == 40 {
            this.pos += 1
            var p = this.pipeline(false)?
            this.skipSpace()
            if this.pos >= len(this.src) || int(this.src[this.pos]) != 41 {
                return this.fail("unclosed left paren")
            }
            this.pos += 1
            return targ{kind: 10, pipe: p}
        }
        if (c >= 48 && c <= 57) || c == 45 || c == 43 {
            var start = this.pos
            this.pos += 1
            for this.pos < len(this.src) &&
                (isIdent(int(this.src[this.pos])) ||
                    int(this.src[this.pos]) == 46 ||
                    ((int(this.src[this.pos]) == 45 || int(this.src[this.pos]) == 43) &&
                        (int(this.src[this.pos - 1]) == 101 ||
                            int(this.src[this.pos - 1]) == 69))) {
                this.pos += 1
            }
            var text = this.src[start..this.pos]
            if strings.Contains(text, ".") ||
                ((strings.Contains(text, "e") || strings.Contains(text, "E")) &&
                    !strings.HasPrefix(strings.TrimLeft(text, "+-"), "0x")) {
                var f = try strings.ToFloat(text) catch err {
                    return this.fail("bad number syntax: " + encoding.json.Quote(text))
                }
                return targ{kind: 7, f: f}
            }
            var body = strings.TrimLeft(text, "+-")
            var v = 0
            if strings.HasPrefix(body, "0x") {
                for k in 2..len(body) {
                    var h = hexVal(int(body[k]))
                    if h < 0 {
                        return this.fail("bad number syntax: " + encoding.json.Quote(text))
                    }
                    v = v * 16 + h
                }
                if strings.HasPrefix(text, "-") {
                    v = -v
                }
            } else {
                v = try strings.ToInt(text) catch err {
                    return this.fail("bad number syntax: " + encoding.json.Quote(text))
                }
            }
            return targ{kind: 6, i: v}
        }
        if isIdent(c) {
            var w = this.peekWord()
            this.pos += len(w)
            if w == "true" || w == "false" {
                return targ{kind: 8, b: w == "true"}
            }
            if w == "nil" {
                return targ{kind: 9}
            }
            if !isBuiltin(w) && !this.t.fnames[w] {
                return this.fail("function " + encoding.json.Quote(w) + " not defined")
            }
            return targ{kind: 4, name: w}
        }
        return this.fail("unexpected " + encoding.json.Quote(string(char(c))) + " in operand")
    }
}

func isSpace(c int) bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

func isIdent(c int) bool {
    return c == 95 ||
        (c >= 48 && c <= 57) ||
        (c >= 65 && c <= 90) ||
        (c >= 97 && c <= 122) ||
        c >= 128
}

func hexVal(c int) int {
    if c >= 48 && c <= 57 {
        return c - 48
    }
    if c >= 97 && c <= 102 {
        return c - 87
    }
    if c >= 65 && c <= 70 {
        return c - 55
    }
    return -1
}

func countLines(s string) int {
    return strings.Count(s, "\n")
}

func isBuiltin(name string) bool {
    for b in builtinNames() {
        if b == name {
            return true
        }
    }
    return false
}

func builtinNames() []string {
    return [
        "and",
        "or",
        "not",
        "len",
        "index",
        "slice",
        "print",
        "printf",
        "println",
        "eq",
        "ne",
        "lt",
        "le",
        "gt",
        "ge",
        "html",
        "js",
        "urlquery",
        "upper",
        "lower",
        "title",
        "trim",
        "join",
        "split",
        "contains",
        "hasPrefix",
        "hasSuffix",
        "replace",
        "repeat",
        "default",
    ]
}

func sortStrings(a []string) {
    for i in 1..len(a) {
        var j = i
        for j > 0 && a[j - 1] > a[j] {
            var t = a[j]
            a[j] = a[j - 1]
            a[j - 1] = t
            j -= 1
        }
    }
}
