namespace data

// The PostgreSQL dialect (database.postgres): moves to zell-lang/postgres
// with the driver (docs/EXTRACTION.md), together with the PostgreSQL-only
// query functions below. Placeholders are $n, SUM of integers and AVG are
// cast back from numeric, strings use strpos/starts_with, migrations use
// PostgreSQL types (identity keys, timestamptz, jsonb).
struct PostgresDialect {
    func Name() string {
        return "postgres"
    }

    func Open(dsn string) *database.sql.DB! {
        return database.postgres.Open(dsn)?
    }

    func Placeholder(n int) string {
        return "$" + strconv.Itoa(n)
    }

    // The protocol's 16-bit parameter count.
    func MaxParams() int {
        return 65535
    }

    func AggregateCast(f string, isInt bool) string {
        if f == "Sum" && isInt {
            return "int64"
        }
        if f == "Average" {
            return "float"
        }
        return ""
    }

    // A path into a @data.jsonb column: col ->> 'a', col #>> '{a,b}',
    // cast to the field's type.
    func TranslateMember(b *SqlBuilder, base SqlExpr, f *reflect.FieldInfo, t *reflect.TypeInfo) bool! {
        var (col, keys, ok) = jsonMember(base, f, t)
        if !ok {
            return false
        }
        if jsonNode(t) {
            b.Emit("(" + col + " #>> '{" + strings.Join(keys, ",") + "}')", t)
            return true
        }
        var e = "(" + col + " #>> '{" + strings.Join(keys, ",") + "}')"
        if len(keys) == 1 {
            e = "(" + col + " ->> '" + keys[0] + "')"
        }
        b.Emit(pgJsonCast(e, t), t)
        return true
    }

    // col #> '{a,b}' (jsonb) or col #>> '{a,b}' (text).
    func JsonExtract(col string, keys []string, asJson bool) string {
        var op = " #>> '{"
        if asJson {
            if len(keys) == 0 {
                return col
            }
            op = " #> '{"
        }
        return "(" + col + op + strings.Join(keys, ",") + "}')"
    }

    func JsonEach(arr string, alias string) string {
        return "jsonb_array_elements(" + pgArrayOnly(arr) + ") AS " + alias
    }

    // A scalar element is read as text and cast like a path.
    func JsonElement(alias string, t *reflect.TypeInfo) string {
        if jsonInner(t) {
            return alias
        }
        return pgJsonCast("(" + alias + " #>> '{}')", t)
    }

    func JsonLength(arr string) string {
        return "jsonb_array_length(" + pgArrayOnly(arr) + ")"
    }

    func TranslateCall(b *SqlBuilder, name string, args []*expr.Node, t *reflect.TypeInfo) bool! {
        if isPostgresCall(name) {
            b.Emit(postgresCall(b, name, args, t)?, t)
            return true
        }
        if name == "len" && isAnySliceTy(expr.TypeOf(args[0])) {
            var x = b.Value(args[0])?
            var (col, keys, path) = jsonPath(x.Text)
            if path {
                // an array inside a document
                b.Emit(this.JsonLength(this.JsonExtract(col, keys, true)), reflect.TypeOf<int>())
            } else if isSliceTy(x.Type) {
                b.Emit("cardinality(" + x.Text + ")", reflect.TypeOf<int>())
            } else {
                b.Emit(this.JsonLength(x.Text), reflect.TypeOf<int>())
            }
            return true
        }
        if name == "len" && isStrTy(expr.TypeOf(args[0])) {
            var x = b.Value(args[0])?
            b.Emit("char_length(" + x.Text + ")", reflect.TypeOf<int>())
            return true
        }
        if name == "strings.Contains" || name == "strings.HasPrefix" || name == "strings.HasSuffix" {
            var x = b.Value(args[0])?
            var a = b.Value(args[1])?
            if name == "strings.Contains" {
                b.Emit("(strpos(" + x.Text + ", " + a.Text + ") > 0)", reflect.TypeOf<bool>())
            } else if name == "strings.HasPrefix" {
                b.Emit("starts_with(" + x.Text + ", " + a.Text + ")", reflect.TypeOf<bool>())
            } else {
                b.Emit("(right(" + x.Text + ", length(" + a.Text + ")) = " + a.Text + ")", reflect.TypeOf<bool>())
            }
            return true
        }
        return false
    }

    func Lock(mode string, wait string) string! {
        var s = " FOR UPDATE"
        if mode == "share" {
            s = " FOR SHARE"
        }
        if wait == "nowait" {
            s = s + " NOWAIT"
        } else if wait == "skip locked" {
            s = s + " SKIP LOCKED"
        }
        return s
    }

    func DistinctOn() bool {
        return true
    }

    // ---- DDL ----

    func ColumnType(c Column) string {
        var t = c.Type
        if strings.HasSuffix(t, "[]") {
            return this.ColumnType(Column{Type: t[0..len(t) - 2], MaxLength: 0}) + "[]"
        }
        if t == "int64" {
            return "bigint"
        }
        if t == "int32" {
            return "integer"
        }
        if t == "int16" {
            return "smallint"
        }
        if t == "float" {
            return "double precision"
        }
        if t == "float32" {
            return "real"
        }
        if t == "bool" {
            return "boolean"
        }
        if t == "bytes" {
            return "bytea"
        }
        if t == "time" {
            return "timestamptz"
        }
        if t == "decimal" {
            return "numeric"
        }
        if t == "json" {
            return "jsonb"
        }
        if t == "string" && c.MaxLength > 0 {
            return "varchar(" + strconv.Itoa(c.MaxLength) + ")"
        }
        return "text"
    }

    func ColumnDef(c Column, inlinePk bool) string {
        var after = ""
        if c.Auto {
            after = " GENERATED BY DEFAULT AS IDENTITY"
        }
        return standardColumnDef(this, c, inlinePk, after)
    }

    // CREATE INDEX ... USING gin (...).
    func CreateIndex(table string, name string, cols []string, unique bool, using string) string! {
        var u = ""
        if unique {
            u = "UNIQUE "
        }
        var m = ""
        if using != "" {
            m = " USING " + using
        }
        return "CREATE " + u + "INDEX " + quoteIdent(name) + " ON " + quoteIdent(table) + m + " (" + strings.Join(cols, ", ") + ")"
    }

    func ZeroLiteral(t string) string {
        if strings.HasSuffix(t, "[]") {
            return "'{}'"
        }
        if t == "bytes" {
            return "''::bytea"
        }
        if t == "bool" {
            return "false"
        }
        if t == "int64" || t == "int32" || t == "int16" || t == "float" || t == "float32" || t == "decimal" {
            return "0"
        }
        if t == "time" {
            return "'0001-01-01 00:00:00+00'"
        }
        if t == "json" {
            return "'null'"
        }
        return "''"
    }

    // ---- ANSI defaults ----

    func Quote(ident string) string {
        return ansiQuote(this, ident)
    }

    func Paging(take int, skip int) string {
        if take == 1 && skip == 0 {
            return " LIMIT 1"
        }
        return ansiPaging(this, take, skip)
    }

    func MultiRowDefaultValues() bool {
        return ansiMultiRowDefaultValues(this)
    }

    func CastType(kind string) string {
        return ansiCastType(this, kind)
    }

    func BindArray(xs []any) any {
        return ansiBindArray(this, xs)
    }

    func Returning() bool {
        return ansiReturning(this)
    }

    func Require(feature string) void! {
        ansiRequire(this, feature)?
    }

    func DefaultSql(sql string) string {
        return ansiDefaultSql(this, sql)
    }

    func AlterColumn(table string, c Column) []string {
        return ansiAlterColumn(this, table, c)
    }

    func AddForeignKey(table string, name string, def string) string {
        return ansiAddForeignKey(this, table, name, def)
    }

    func DropForeignKey(table string, name string) string {
        return ansiDropForeignKey(this, table, name)
    }
}

// ---- PostgreSQL-only query functions ------------------------------------------------
//
// Marked @expr.call: only PostgresDialect.TranslateCall emits them; on
// another dialect the call fails ("ILike is not supported by sqlite").
// Each has an in-memory implementation for Compile() where one makes
// sense. They live in namespace data until the split (then: namespace
// postgres of zell-lang/postgres). JSON values are passed as JSON text
// (json.Format(v), evaluated when the lambda is built).

// s ILIKE pattern (case-insensitive LIKE: % any run, _ one character).
@expr.call
func ILike(s string, pattern string) bool {
    return likeMatch(strings.ToLower(s), strings.ToLower(pattern))
}

// s ~ pattern (POSIX regular expression).
@expr.call
func Regex(s string, pattern string) bool {
    return try regex.MatchString(pattern, s) else false
}

// s ~* pattern (case-insensitive).
@expr.call
func IRegex(s string, pattern string) bool {
    return try regex.MatchString("(?i)" + pattern, s) else false
}

// A tsvector (full-text search document).
struct TsVector {
    text string
}

// A tsquery (full-text search query).
struct TsQuery {
    text string
}

// to_tsvector(config, text).
@expr.call
func ToTsVector(config string, text string) TsVector {
    return TsVector{text: strings.ToLower(text)}
}

// plainto_tsquery(config, text): all the words.
@expr.call
func PlainToTsQuery(config string, text string) TsQuery {
    return TsQuery{text: strings.ToLower(text)}
}

// websearch_to_tsquery(config, text): web search syntax ("a b" -c or d).
@expr.call
func WebSearchToTsQuery(config string, text string) TsQuery {
    return TsQuery{text: strings.ToLower(text)}
}

// to_tsquery(config, text): tsquery syntax (a & b | !c).
@expr.call
func ToTsQuery(config string, text string) TsQuery {
    return TsQuery{text: strings.ToLower(text)}
}

// v @@ q. In memory: every word of q occurs in v.
@expr.call
func Matches(v TsVector, q TsQuery) bool {
    for w in strings.Fields(q.text) {
        if !strings.Contains(v.text, w) {
            return false
        }
    }
    return true
}

// ts_rank(v, q), for ordering by relevance.
@expr.call
func TsRank(v TsVector, q TsQuery) float {
    return 0.0
}

// doc @> json: the document contains the JSON value (json.Format(v)).
@expr.call
func JsonContains<V>(doc V, value string) bool {
    panic("data.JsonContains is translated to SQL: use it inside a query lambda")
}

// doc <@ json.
@expr.call
func JsonContainedBy<V>(doc V, value string) bool {
    panic("data.JsonContainedBy is translated to SQL: use it inside a query lambda")
}

// doc ? key: the top-level key exists.
@expr.call
func JsonHasKey<V>(doc V, key string) bool {
    var v = try encoding.json.Parse<encoding.json.Value>(encoding.json.Format(doc)) else encoding.json.NewNull()
    return v.Has(key)
}

// doc ?| keys: one of the keys exists.
@expr.call
func JsonHasAnyKey<V>(doc V, keys []string) bool {
    for k in keys {
        if JsonHasKey(doc, k) {
            return true
        }
    }
    return false
}

// doc ?& keys: all the keys exist.
@expr.call
func JsonHasAllKeys<V>(doc V, keys []string) bool {
    for k in keys {
        if !JsonHasKey(doc, k) {
            return false
        }
    }
    return true
}

// doc @? path: the SQL/JSON path returns an item ('$.tags[*] ? (@ == "a")').
@expr.call
func JsonPathExists<V>(doc V, path string) bool {
    panic("data.JsonPathExists is translated to SQL: use it inside a query lambda")
}

// doc @@ path: the SQL/JSON path predicate holds ('$.age > 18').
@expr.call
func JsonPathMatch<V>(doc V, path string) bool {
    panic("data.JsonPathMatch is translated to SQL: use it inside a query lambda")
}

// jsonb_set(doc, path, json): doc with the value at path replaced (for
// ExecuteUpdate: s.SetWith((u) => u.Meta, (u) => data.JsonSet(u.Meta,
// ["plan"], json.Format("pro")))).
@expr.call
func JsonSet<V>(doc V, path []string, value string) V {
    return doc
}

// xs @> ys: the array contains every element of ys.
@expr.call
func ArrayContains<E>(xs []E, ys []E) bool {
    for y in ys {
        if !slices.Contains(xs, y) {
            return false
        }
    }
    return true
}

// xs <@ ys.
@expr.call
func ArrayContainedBy<E>(xs []E, ys []E) bool {
    return ArrayContains(ys, xs)
}

// xs && ys: the arrays share an element.
@expr.call
func ArrayOverlaps<E>(xs []E, ys []E) bool {
    for y in ys {
        if slices.Contains(xs, y) {
            return true
        }
    }
    return false
}

// x == data.AnyOf(u.Tags): x = ANY(tags) (only as an operand of ==).
@expr.call
func AnyOf<E>(xs []E) E {
    panic("data.AnyOf is translated to SQL: compare with it inside a query lambda (x == data.AnyOf(u.Tags))")
}

// The names of the PostgreSQL-only calls.
func isPostgresCall(name string) bool {
    return name == "data.ILike" ||
        name == "data.Regex" ||
        name == "data.IRegex" ||
        name == "data.ToTsVector" ||
        name == "data.PlainToTsQuery" ||
        name == "data.WebSearchToTsQuery" ||
        name == "data.ToTsQuery" ||
        name == "data.Matches" ||
        name == "data.TsRank" ||
        name == "data.JsonContains" ||
        name == "data.JsonContainedBy" ||
        name == "data.JsonHasKey" ||
        name == "data.JsonHasAnyKey" ||
        name == "data.JsonHasAllKeys" ||
        name == "data.JsonPathExists" ||
        name == "data.JsonPathMatch" ||
        name == "data.JsonSet" ||
        name == "data.ArrayContains" ||
        name == "data.ArrayContainedBy" ||
        name == "data.ArrayOverlaps" ||
        name == "data.AnyOf"
}

// An array column's type ([]T of scalars, not a navigation).
// JSON text e as a value of type t: numbers, booleans and times cast.
func pgJsonCast(e string, t *reflect.TypeInfo) string {
    var k = baseOf(t)
    if k != nil && isIntKind(k.Kind) {
        return "(" + e + ")::bigint"
    }
    if k != nil && (k.Kind == reflect.Kind.Float || k.Kind == reflect.Kind.Float32) {
        return "(" + e + ")::double precision"
    }
    if k != nil && k.Kind == reflect.Kind.Bool {
        return "(" + e + ")::boolean"
    }
    if k != nil && k.FullName == "time.Time" {
        return "(" + e + ")::timestamptz"
    }
    return e
}

// A JSON array argument of jsonb_array_elements/jsonb_array_length: a
// path into a document may hold JSON null (a nil slice), which these
// functions reject, so it is NULL unless it is an array.
func pgArrayOnly(arr string) string {
    if strings.HasPrefix(arr, "(") && strings.Contains(arr, " #> '{") {
        return "CASE jsonb_typeof(" + arr + ") WHEN 'array' THEN " + arr + " END"
    }
    return arr
}

// A slice that is not []byte (an array column, or a JSON array).
func isAnySliceTy(t *reflect.TypeInfo) bool {
    var b = baseOf(t)
    return b != nil && b.Kind == reflect.Kind.Slice && b.Elem.Kind != reflect.Kind.Uint8
}

func isSliceTy(t *reflect.TypeInfo) bool {
    var b = baseOf(t)
    return b != nil && arrayKind(b) != ""
}

// A list argument as an array: ARRAY[$1, $2]::type[] (a captured slice
// expands to one parameter per element).
func pgArray(b *SqlBuilder, n *expr.Node, elemOf *reflect.TypeInfo) string! {
    var x = b.Value(n)?
    var cast = ""
    var t = baseOf(elemOf)
    if t != nil && t.Kind == reflect.Kind.Slice {
        var k = scalarKind(t.Elem)
        if k != "" {
            cast = "::" + PostgresDialect{}.ColumnType(Column{Type: k}) + "[]"
        }
    }
    if strings.HasPrefix(x.Text, "{*") {
        return "ARRAY[" + x.Text + "]" + cast
    }
    return x.Text
}

func postgresCall(b *SqlBuilder, name string, args []*expr.Node, t *reflect.TypeInfo) string! {
    var m = name[5..len(name)]
    if m == "AnyOf" {
        var x = b.Value(args[0])?
        return "ANY(" + x.Text + ")"
    }
    if m == "ArrayContains" || m == "ArrayContainedBy" || m == "ArrayOverlaps" {
        var x = pgArray(b, args[0], expr.TypeOf(args[0]))?
        var y = pgArray(b, args[1], expr.TypeOf(args[0]))?
        var op = " @> "
        if m == "ArrayContainedBy" {
            op = " <@ "
        } else if m == "ArrayOverlaps" {
            op = " && "
        }
        return "(" + x + op + y + ")"
    }
    if m == "JsonHasAnyKey" || m == "JsonHasAllKeys" {
        var d = b.Value(args[0])?
        var k = pgArray(b, args[1], reflect.TypeOf<[]string>())?
        var op = " ?| "
        if m == "JsonHasAllKeys" {
            op = " ?& "
        }
        return "(" + d.Text + op + k + ")"
    }
    if m == "JsonSet" {
        var d = b.Value(args[0])?
        var p = pgArray(b, args[1], reflect.TypeOf<[]string>())?
        var v = b.Value(args[2])?
        return "jsonb_set(" + d.Text + ", " + p + ", CAST(" + v.Text + " AS jsonb))"
    }
    var x = b.Value(args[0])?
    var y = b.Value(args[1])?
    if m == "ILike" {
        return "(" + x.Text + " ILIKE " + y.Text + ")"
    }
    if m == "Regex" {
        return "(" + x.Text + " ~ " + y.Text + ")"
    }
    if m == "IRegex" {
        return "(" + x.Text + " ~* " + y.Text + ")"
    }
    if m == "ToTsVector" || m == "PlainToTsQuery" || m == "WebSearchToTsQuery" || m == "ToTsQuery" {
        var f = "to_tsvector("
        if m == "PlainToTsQuery" {
            f = "plainto_tsquery("
        } else if m == "WebSearchToTsQuery" {
            f = "websearch_to_tsquery("
        } else if m == "ToTsQuery" {
            f = "to_tsquery("
        }
        return f + "CAST(" + x.Text + " AS regconfig), " + y.Text + ")"
    }
    if m == "Matches" {
        return "(" + x.Text + " @@ " + y.Text + ")"
    }
    if m == "TsRank" {
        return "ts_rank(" + x.Text + ", " + y.Text + ")"
    }
    if m == "JsonContains" {
        return "(" + x.Text + " @> CAST(" + y.Text + " AS jsonb))"
    }
    if m == "JsonContainedBy" {
        return "(" + x.Text + " <@ CAST(" + y.Text + " AS jsonb))"
    }
    if m == "JsonHasKey" {
        return "(" + x.Text + " ? " + y.Text + ")"
    }
    if m == "JsonPathExists" {
        return "(" + x.Text + " @? CAST(" + y.Text + " AS jsonpath))"
    }
    return "(" + x.Text + " @@ CAST(" + y.Text + " AS jsonpath))"
}

// LIKE matching in memory (% any run, _ one character, \ escapes).
func likeMatch(s string, p string) bool {
    if len(p) == 0 {
        return len(s) == 0
    }
    var c = int(p[0])
    if c == 37 {
        for i in 0..len(s) + 1 {
            if likeMatch(s[i..len(s)], p[1..len(p)]) {
                return true
            }
        }
        return false
    }
    if c == 92 && len(p) > 1 {
        return len(s) > 0 && s[0] == p[1] && likeMatch(s[1..len(s)], p[2..len(p)])
    }
    if len(s) == 0 {
        return false
    }
    if c == 95 || s[0] == p[0] {
        return likeMatch(s[1..len(s)], p[1..len(p)])
    }
    return false
}

// ---- LISTEN/NOTIFY --------------------------------------------------------------------

// The notifications of ctx.Listen: payloads arrive on C (closed after
// Close or when the connection fails).
struct Subscription {
    C task.Channel<string>
    l *database.postgres.Listener

    func Close() {
        this.l.Close()
    }
}

async func notifyPg(st *ctxState, channel string, payload string) void! {
    if st.d.Name() != "postgres" {
        return error("data: Notify (NOTIFY) is not supported by " + st.d.Name())
    }
    _ = await st.exec("SELECT pg_notify(" + st.d.Placeholder(1) + ", " + st.d.Placeholder(2) + ")", [channel, payload])?
}

async func listenPg(st *ctxState, channel string) *Subscription! {
    if st.d.Name() != "postgres" {
        return error("data: Listen (LISTEN) is not supported by " + st.d.Name())
    }
    var l = await database.postgres.Listen(st.db.st.dsn, [channel])?
    var ch = task.Channel<string>(64)
    task.Go(pump(l, ch))
    return new Subscription{C: ch, l: l}
}

func pump(l *database.postgres.Listener, ch task.Channel<string>) func() Task<void> {
    return async () => {
        for {
            var n = try await l.Next() catch err {
                break
            }
            await ch.Send(n.Payload)
        }
        ch.Close()
    }
}
