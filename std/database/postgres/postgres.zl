// database.postgres: a PostgreSQL driver for database.sql written
// in Zell over net (and net.tls for sslmode): frontend/backend
// protocol 3.0, startup and authentication (trust, cleartext password,
// MD5, SCRAM-SHA-256), the simple query protocol (no arguments) and the
// extended protocol (Parse/Describe/Bind/Execute/Sync) for prepared
// statements, with binary results for the common scalar types and text
// otherwise; transactions; notices and LISTEN/NOTIFY callbacks; COPY
// FROM STDIN (CopyFrom) and COPY TO STDOUT (rows of one "data" column).
// Postgres types and Zell values: see decodeBinary/decodeText
// (postgres_types.zl); numeric, uuid, json/jsonb, interval and unknown
// types come as strings, arrays as []any.
namespace database.postgres

// The driver: sql.Register("postgres", postgres.Driver{}). OnNotice gets
// NOTICE/WARNING messages, OnNotification LISTEN/NOTIFY messages.
struct Driver {
    OnNotice       func(Error)
    OnNotification func(Notification)

    func Open(dsn string) Task<database.sql.DriverConn!> {
        return connect(dsn, this.OnNotice, this.OnNotification)
    }
}

// An asynchronous notification (NOTIFY channel, 'payload').
struct Notification {
    Pid     int
    Channel string
    Payload string
}

// Opens a pool over the driver without registering it.
func Open(dsn string) *database.sql.DB! {
    _ = ParseDSN(dsn)?
    return database.sql.OpenDriver(Driver{}, dsn)
}

// ---- byte streams ---------------------------------------------------------------

// A net.Conn or a net.tls.Conn.
interface stream {
    func Read(n int) Task<[]byte!>
    func Write(data []byte) Task<int!>
    func Close()
}

struct reader {
    b []byte
    p int

    func byte1() int {
        var v = int(this.b[this.p])
        this.p += 1
        return v
    }

    func i16() int {
        var v = bes(this.b, this.p, 2)
        this.p += 2
        return v
    }

    func i32() int {
        var v = bes(this.b, this.p, 4)
        this.p += 4
        return v
    }

    func cstr() string {
        var start = this.p
        for this.p < len(this.b) && this.b[this.p] != 0 {
            this.p += 1
        }
        var s = strings.FromBytes(this.b[start..this.p])
        if this.p < len(this.b) {
            this.p += 1
        }
        return s
    }

    func bytes(n int) []byte {
        var v = this.b[this.p..this.p + n]
        this.p += n
        return v
    }
}

// Builds frontend messages.
struct writer {
    b     []byte
    start int

    func begin(t int) {
        this.start = len(this.b)
        if t != 0 {
            this.b = append(this.b, byte(t))
            this.start = len(this.b)
        }
        this.b = append(this.b, 0, 0, 0, 0)
    }

    func end() {
        var n = len(this.b) - this.start
        this.b[this.start] = byte((n >> 24) & 255)
        this.b[this.start + 1] = byte((n >> 16) & 255)
        this.b[this.start + 2] = byte((n >> 8) & 255)
        this.b[this.start + 3] = byte(n & 255)
    }

    func i16(v int) {
        this.b = append(this.b, byte((v >> 8) & 255), byte(v & 255))
    }

    func i32(v int) {
        this.b = append(
            this.b,
            byte((v >> 24) & 255),
            byte((v >> 16) & 255),
            byte((v >> 8) & 255),
            byte(v & 255),
        )
    }

    func str(s string) {
        this.raw(strings.Bytes(s))
        this.b = append(this.b, 0)
    }

    func raw(d []byte) {
        this.b = compress.rtConcat(this.b, d)
    }
}

// ---- connection -----------------------------------------------------------------

struct column {
    name   string
    oid    int
    format int
}

struct conn {
    s        stream
    buf      []byte
    pos      int
    bad      bool
    closed   bool
    tx       int
    pid      int
    secret   int
    params   map[string]string
    mu       task.Mutex
    cur      *rows
    stmtSeq  int
    toClose  []string
    onNotice func(Error)
    onNotify func(Notification)
    cfg      Config
    // a Listener's connection: recv returns after each notification
    listening bool

    // ---- low level I/O ----

    async func fill(n int) void! {
        for len(this.buf) - this.pos < n {
            var chunk = try await this.s.Read(65536) catch err {
                this.bad = true
                return err
            }
            if len(chunk) == 0 {
                this.bad = true
                return error("postgres: server closed the connection")
            }
            if this.pos > 0 {
                this.buf = this.buf[this.pos..]
                this.pos = 0
            }
            this.buf = compress.rtConcat(this.buf, chunk)
        }
    }

    // The next backend message: (type, payload). Notices and
    // notifications are handled here.
    async func recv() (int, []byte)! {
        for {
            await this.fill(5)?
            var t = int(this.buf[this.pos])
            var n = be(this.buf, this.pos + 1, 4)
            if n < 4 || n > 1 << 30 {
                this.bad = true
                return error("postgres: protocol error (bad message length)")
            }
            await this.fill(1 + n)?
            var payload = compress.rtCopy(this.buf, this.pos + 5, this.pos + 1 + n)
            this.pos += 1 + n
            if t == 78 {
                // 'N' NoticeResponse
                if this.onNotice != nil {
                    this.onNotice(parseError(payload))
                }
                continue
            }
            if t == 65 {
                // 'A' NotificationResponse
                if this.onNotify != nil {
                    var r = reader{b: payload}
                    var pid = r.i32()
                    var ch = r.cstr()
                    this.onNotify(Notification{Pid: pid, Channel: ch, Payload: r.cstr()})
                }
                if this.listening {
                    return (t, payload)
                }
                continue
            }
            if t == 83 {
                // 'S' ParameterStatus
                var r = reader{b: payload}
                var k = r.cstr()
                this.params[k] = r.cstr()
                continue
            }
            return (t, payload)
        }
    }

    async func send(w writer) void! {
        try await this.s.Write(w.b) catch err {
            this.bad = true
            return err
        }
    }

    // Reads up to ReadyForQuery, remembering the first error.
    async func sync(first error) void! {
        var err = first
        for {
            var (t, p) = await this.recv()?
            if t == 69 {
                if err == nil {
                    err = parseError(p)
                }
            } else if t == 90 {
                this.tx = int(p[0])
                break
            }
        }
        if err != nil {
            return err
        }
    }

    // Startup message and authentication (protocol 53.2.1).
    async func startup(cfg Config) void! {
        var w = writer{}
        w.begin(0)
        w.i32(196608)
        w.str("user")
        w.str(cfg.User)
        w.str("database")
        w.str(cfg.Database)
        w.str("client_encoding")
        w.str("UTF8")
        w.str("DateStyle")
        w.str("ISO, MDY")
        for k, v in cfg.Params {
            w.str(k)
            w.str(v)
        }
        w.b = append(w.b, 0)
        w.end()
        await this.send(w)?
        var sc = Scram{Password: cfg.Password}
        for {
            var (t, p) = await this.recv()?
            if t == 82 {
                var r = reader{b: p}
                var code = r.i32()
                if code == 0 {
                    continue
                }
                if code == 3 || code == 5 || code == 10 {
                    if cfg.Password == "" {
                        return error("postgres: the server requested a password but none was given")
                    }
                }
                var m = writer{}
                m.begin(112)
                if code == 3 {
                    m.str(cfg.Password)
                } else if code == 5 {
                    m.str(md5Password(cfg.User, cfg.Password, r.bytes(4)))
                } else if code == 10 {
                    var mechs []string = []
                    for r.p < len(r.b) {
                        var name = r.cstr()
                        if name == "" {
                            break
                        }
                        mechs = append(mechs, name)
                    }
                    var ok = false
                    for x in mechs {
                        if x == "SCRAM-SHA-256" {
                            ok = true
                        }
                    }
                    if !ok {
                        return error(
                            "postgres: no supported SASL mechanism among " +
                                strings.Join(mechs, ", "),
                        )
                    }
                    sc.ClientNonce = encoding.base64.Encode(crypto.rand.Bytes(18)?)
                    var first = strings.Bytes(sc.First())
                    m.str("SCRAM-SHA-256")
                    m.i32(len(first))
                    m.raw(first)
                } else if code == 11 {
                    m.raw(strings.Bytes(sc.Final(strings.FromBytes(r.bytes(len(p) - 4)))?))
                } else if code == 12 {
                    sc.Verify(strings.FromBytes(r.bytes(len(p) - 4)))?
                    continue
                } else {
                    return error(
                        "postgres: unsupported authentication method " +
                            fmt.Format("{0}", code),
                    )
                }
                m.end()
                await this.send(m)?
            } else if t == 75 {
                var r = reader{b: p}
                this.pid = r.i32()
                this.secret = r.i32()
            } else if t == 69 {
                return parseError(p)
            } else if t == 90 {
                this.tx = int(p[0])
                return
            }
        }
    }

    // ---- operations (serialized by mu) ----

    async func lock() void! {
        await this.mu.Lock()
        if this.cur != nil {
            var r = this.cur
            this.cur = nil
            try await r.drain() catch err {
                this.mu.Unlock()
                return err
            }
        }
        if this.closed || this.bad {
            this.mu.Unlock()
            return database.sql.ErrConnDone
        }
    }

    func unlock() {
        this.mu.Unlock()
    }

    func Exec(query string, args []any) Task<database.sql.Result!> {
        return this.execAsync(query, args)
    }

    async func execAsync(query string, args []any) database.sql.Result! {
        await this.lock()?
        defer this.unlock()
        if len(args) == 0 {
            return await this.simpleExec(query)?
        }
        var r = await this.extended("", query, nil, args, false)?
        return await r.finishExec()?
    }

    // Simple query protocol: may hold several statements; the affected
    // rows of the last command.
    async func simpleExec(query string) database.sql.Result! {
        var w = writer{}
        w.begin(81)
        w.str(query)
        w.end()
        await this.send(w)?
        var res = database.sql.Result{}
        var err error
        for {
            var (t, p) = await this.recv()?
            if t == 67 {
                res.RowsAffected = affected(cstrOf(p))
            } else if t == 69 {
                if err == nil {
                    err = parseError(p)
                }
            } else if t == 71 {
                // CopyInResponse: Exec cannot supply data
                var f = writer{}
                f.begin(102)
                f.str("COPY FROM STDIN is not supported by Exec (use postgres.CopyFrom)")
                f.end()
                await this.send(f)?
            } else if t == 72 {
                // CopyOutResponse: discard the data
            } else if t == 90 {
                this.tx = int(p[0])
                break
            }
        }
        if err != nil {
            return err
        }
        return res
    }

    func Query(query string, args []any) Task<database.sql.DriverRows!> {
        return this.queryAsync(query, args)
    }

    async func queryAsync(query string, args []any) database.sql.DriverRows! {
        await this.lock()?
        defer this.unlock()
        if len(args) == 0 {
            var w = writer{}
            w.begin(81)
            w.str(query)
            w.end()
            await this.send(w)?
            var r = new rows{c: this, simple: true}
            await r.start()?
            if !r.done {
                this.cur = r
            }
            return r
        }
        var r = await this.extended("", query, nil, args, true)?
        if !r.done {
            this.cur = r
        }
        return r
    }

    // Sends pending statement closes (before another extended exchange).
    func flushCloses(w writer) writer {
        var out = w
        for name in this.toClose {
            out.begin(67)
            out.b = append(out.b, byte(83))
            out.str(name)
            out.end()
        }
        this.toClose = []
        return out
    }

    // Runs a statement with the extended protocol. With st == nil the
    // query is parsed as the unnamed statement and results come as text;
    // a prepared st has its columns already, so binary results are asked
    // for the types decodeBinary knows.
    async func extended(name string, query string, st *stmt, args []any, isQuery bool) *rows! {
        var w = writer{}
        w = this.flushCloses(w)
        var cols []column = []
        if st == nil {
            w.begin(80)
            w.str("")
            w.str(query)
            w.i16(0)
            w.end()
        } else {
            cols = st.cols
            if len(args) != len(st.params) {
                return error(
                    "postgres: expected " +
                        fmt.Format("{0}", len(st.params)) +
                        " arguments, got " +
                        fmt.Format("{0}", len(args)),
                )
            }
        }
        // Bind
        w.begin(66)
        w.str("")
        w.str(name)
        w.i16(len(args))
        for a in args {
            switch a {
                case []byte b:
                    w.i16(1)
                default:
                    w.i16(0)
            }
        }
        w.i16(len(args))
        for a in args {
            if a == nil {
                w.i32(-1)
                continue
            }
            switch a {
                case []byte b:
                    w.i32(len(b))
                    w.raw(b)
                default:
                    var t = encodeText(a)?
                    var tb = strings.Bytes(t)
                    w.i32(len(tb))
                    w.raw(tb)
            }
        }
        if st == nil {
            w.i16(0)
        } else {
            w.i16(len(cols))
            for i in 0..len(cols) {
                if binaryResult(cols[i].oid) {
                    cols[i].format = 1
                    w.i16(1)
                } else {
                    cols[i].format = 0
                    w.i16(0)
                }
            }
        }
        w.end()
        if st == nil {
            w.begin(68)
            w.b = append(w.b, byte(80))
            w.str("")
            w.end()
        }
        w.begin(69)
        w.str("")
        w.i32(0)
        w.end()
        w.begin(83)
        w.end()
        await this.send(w)?
        var r = new rows{c: this, cols: cols, described: st != nil}
        await r.start()?
        return r
    }

    func Prepare(query string) Task<database.sql.DriverStmt!> {
        return this.prepareAsync(query)
    }

    async func prepareAsync(query string) database.sql.DriverStmt! {
        await this.lock()?
        defer this.unlock()
        this.stmtSeq += 1
        var name = "zell_" + fmt.Format("{0}", this.stmtSeq)
        var w = writer{}
        w = this.flushCloses(w)
        w.begin(80)
        w.str(name)
        w.str(query)
        w.i16(0)
        w.end()
        w.begin(68)
        w.b = append(w.b, byte(83))
        w.str(name)
        w.end()
        w.begin(83)
        w.end()
        await this.send(w)?
        var st = new stmt{c: this, name: name, query: query}
        var err error
        for {
            var (t, p) = await this.recv()?
            if t == 69 {
                if err == nil {
                    err = parseError(p)
                }
            } else if t == 116 {
                // ParameterDescription
                var r = reader{b: p}
                var n = r.i16()
                for _ in 0..n {
                    st.params = append(st.params, r.i32())
                }
            } else if t == 84 {
                st.cols = parseRowDesc(p)
            } else if t == 90 {
                this.tx = int(p[0])
                break
            }
        }
        if err != nil {
            return err
        }
        return st
    }

    func Begin() Task<database.sql.DriverTx!> {
        return this.beginAsync()
    }

    async func beginAsync() database.sql.DriverTx! {
        await this.lock()?
        defer this.unlock()
        _ = await this.simpleExec("BEGIN")?
        return new tx{c: this}
    }

    func Ping() Task<void!> {
        return this.pingAsync()
    }

    async func pingAsync() void! {
        await this.lock()?
        defer this.unlock()
        _ = await this.simpleExec("")?
    }

    func Close() void! {
        // breaks the conn.cur <-> rows.c cycle
        this.cur = nil
        if !this.closed {
            this.closed = true
            if !this.bad {
                var w = writer{}
                w.begin(88)
                w.end()
                _ = this.s.Write(w.b)
            }
            this.s.Close()
        }
    }

    func IsValid() bool {
        return !this.closed && !this.bad
    }

    func Placeholder() int {
        return database.sql.PlaceholderDollar
    }

    // Transaction status: 'I' idle, 'T' in a transaction, 'E' failed
    // transaction.
    func TxStatus() int {
        return this.tx
    }

    // A server parameter reported at startup or later (server_version,
    // TimeZone, ...).
    func Parameter(name string) string {
        return this.params[name]
    }

    // The backend process id.
    func Pid() int {
        return this.pid
    }

    // COPY ... FROM STDIN with the given data (text or CSV as the
    // statement says); the number of rows copied.
    async func CopyFrom(query string, data []byte) int! {
        await this.lock()?
        defer this.unlock()
        var w = writer{}
        w.begin(81)
        w.str(query)
        w.end()
        await this.send(w)?
        var n = 0
        var err error
        for {
            var (t, p) = await this.recv()?
            if t == 71 {
                var d = writer{}
                var off = 0
                for off < len(data) {
                    var end = off + 65536
                    if end > len(data) {
                        end = len(data)
                    }
                    d.begin(100)
                    d.raw(data[off..end])
                    d.end()
                    off = end
                }
                d.begin(99)
                d.end()
                await this.send(d)?
            } else if t == 67 {
                n = affected(cstrOf(p))
            } else if t == 69 {
                if err == nil {
                    err = parseError(p)
                }
            } else if t == 90 {
                this.tx = int(p[0])
                break
            }
        }
        if err != nil {
            return err
        }
        return n
    }
}

// The affected-rows count of a CommandComplete tag ("INSERT 0 5", "UPDATE 3").
func affected(tag string) int {
    var t = tag
    var sp = strings.LastIndex(t, " ")
    if sp < 0 {
        return 0
    }
    return try strconv.Atoi(t[sp + 1..]) else 0
}

// A NUL-terminated payload as a string.
func cstrOf(p []byte) string {
    var r = reader{b: p}
    return r.cstr()
}

func parseRowDesc(p []byte) []column {
    var r = reader{b: p}
    var n = r.i16()
    var cols []column = []
    for _ in 0..n {
        var name = r.cstr()
        _ = r.i32()
        _ = r.i16()
        var oid = r.i32()
        _ = r.i16()
        _ = r.i32()
        var f = r.i16()
        cols = append(cols, column{name: name, oid: oid, format: f})
    }
    return cols
}

// COPY ... FROM STDIN through a pool: runs on one of db's connections.
async func CopyFrom(db *database.sql.DB, query string, data []byte) int! {
    var n = 0
    await db.Raw(async func(c database.sql.DriverConn) void! {
        switch c {
            case *conn pc:
                n = await pc.CopyFrom(query, data)?
            default:
                return error("postgres: CopyFrom needs a postgres connection")
        }
    })?
    return n
}

// ---- prepared statements ---------------------------------------------------------

struct stmt {
    c      *conn
    name   string
    query  string
    params []int
    cols   []column
    closed bool

    func NumInput() int {
        return len(this.params)
    }

    func Close() void! {
        if !this.closed {
            this.closed = true
            this.c.toClose = append(this.c.toClose, this.name)
        }
    }

    func Exec(args []any) Task<database.sql.Result!> {
        return this.execAsync(args)
    }

    async func execAsync(args []any) database.sql.Result! {
        await this.c.lock()?
        defer this.c.unlock()
        if this.closed {
            return error("postgres: statement is closed")
        }
        var r = await this.c.extended(this.name, this.query, this, args, false)?
        return await r.finishExec()?
    }

    func Query(args []any) Task<database.sql.DriverRows!> {
        return this.queryAsync(args)
    }

    async func queryAsync(args []any) database.sql.DriverRows! {
        await this.c.lock()?
        defer this.c.unlock()
        if this.closed {
            return error("postgres: statement is closed")
        }
        var r = await this.c.extended(this.name, this.query, this, args, true)?
        if !r.done {
            this.c.cur = r
        }
        return r
    }
}

// ---- transactions ----------------------------------------------------------------

struct tx {
    c *conn

    func Commit() Task<void!> {
        return this.end("COMMIT")
    }

    func Rollback() Task<void!> {
        return this.end("ROLLBACK")
    }

    async func end(sql string) void! {
        await this.c.lock()?
        defer this.c.unlock()
        var failed = this.c.tx == 69
        _ = await this.c.simpleExec(sql)?
        if failed && sql == "COMMIT" {
            return error("postgres: transaction was aborted (COMMIT rolled back)")
        }
    }
}

// ---- results ----------------------------------------------------------------------

struct rows {
    c           *conn
    cols        []column
    simple      bool
    described   bool
    done        bool
    tag         string
    err         error
    copyOut     bool
    pending     []byte
    havePending bool
    // The protocol exchange has been read up to ReadyForQuery.
    finished bool

    // Reads up to the row description (or the end of a row-less result).
    async func start() void! {
        for {
            var (t, p) = await this.c.recv()?
            if t == 49 || t == 50 || t == 51 {
                // ParseComplete, BindComplete, CloseComplete
                continue
            }
            if t == 110 {
                // NoData: rows end at CommandComplete
                continue
            }
            if t == 84 {
                this.cols = parseRowDesc(p)
                return
            }
            if t == 72 {
                // CopyOutResponse: rows of one text column
                this.copyOut = true
                this.cols = [column{name: "data", oid: 25}]
                return
            }
            if t == 68 {
                // DataRow for a prepared statement (no RowDescription)
                this.pending = p
                this.havePending = true
                return
            }
            if t == 67 || t == 73 {
                this.tag = cstrOf(p)
                await this.c.sync(nil)?
                this.done = true
                this.finished = true
                return
            }
            if t == 69 {
                this.done = true
                this.finished = true
                await this.c.sync(parseError(p))?
                return
            }
            if t == 71 {
                var f = writer{}
                f.begin(102)
                f.str("COPY FROM STDIN is not supported by Query (use postgres.CopyFrom)")
                f.end()
                await this.c.send(f)?
                continue
            }
            if t == 90 {
                this.c.tx = int(p[0])
                this.done = true
                this.finished = true
                return
            }
        }
    }

    func Columns() []string {
        var out []string = []
        for c in this.cols {
            out = append(out, c.name)
        }
        return out
    }

    func ColumnTypes() []string {
        var out []string = []
        for c in this.cols {
            out = append(out, typeName(c.oid))
        }
        return out
    }

    func Next(dest []any) Task<bool!> {
        return this.nextAsync(dest)
    }

    func decodeRow(p []byte, dest []any) void! {
        if this.copyOut {
            var line = strings.FromBytes(p)
            if strings.HasSuffix(line, "\n") {
                line = line[..len(line) - 1]
            }
            dest[0] = line
            return
        }
        var r = reader{b: p}
        var n = r.i16()
        if n != len(dest) {
            return error(
                "postgres: row has " +
                    fmt.Format("{0}", n) +
                    " columns, expected " +
                    fmt.Format("{0}", len(dest)),
            )
        }
        for i in 0..n {
            var l = r.i32()
            if l < 0 {
                dest[i] = nil
                continue
            }
            var b = r.bytes(l)
            var c = this.cols[i]
            if c.format == 1 {
                dest[i] = decodeBinary(c.oid, b)?
            } else {
                dest[i] = decodeText(c.oid, strings.FromBytes(b))?
            }
        }
    }

    async func nextAsync(dest []any) bool! {
        if this.done {
            return false
        }
        await this.c.mu.Lock()
        defer this.c.unlock()
        if this.c.cur != this {
            // drained by another operation
            this.done = true
            this.finished = true
            return false
        }
        if this.havePending {
            this.havePending = false
            this.decodeRow(this.pending, dest)?
            this.pending = []
            return true
        }
        for {
            var (t, p) = await this.c.recv()?
            if t == 68 || (t == 100 && this.copyOut) {
                var p2 = p
                if t == 68 || this.copyOut {
                    p2 = p
                }
                try this.decodeRow(p2, dest) catch err {
                    this.c.cur = nil
                    this.done = true
                    this.finished = true
                    try await this.skipToReady() catch e2 {
                        return e2
                    }
                    return err
                }
                return true
            }
            if t == 99 {
                // CopyDone
                continue
            }
            if t == 67 || t == 73 || t == 115 {
                this.tag = cstrOf(p)
                this.c.cur = nil
                this.done = true
                this.finished = true
                await this.skipToReady()?
                return false
            }
            if t == 69 {
                this.c.cur = nil
                this.done = true
                this.finished = true
                await this.c.sync(parseError(p))?
                return false
            }
            if t == 90 {
                this.c.tx = int(p[0])
                this.c.cur = nil
                this.done = true
                this.finished = true
                return false
            }
        }
    }

    // After the first result: discards the rest up to ReadyForQuery
    // (further results of a multi-statement simple query included); an
    // error in a later statement is returned.
    async func skipToReady() void! {
        this.finished = true
        await this.c.sync(nil)?
    }

    // Reads the rest of the exchange (another operation is about to run).
    async func drain() void! {
        this.done = true
        if this.finished {
            return
        }
        this.finished = true
        await this.c.sync(nil)?
    }

    // Stops the result; unread data is skipped by the connection's next
    // operation (conn.lock), so Close never blocks.
    func Close() void! {
        this.done = true
    }

    // Exec through the extended protocol: reads to the end.
    async func finishExec() database.sql.Result! {
        if !this.done {
            for {
                var (t, p) = await this.c.recv()?
                if t == 67 || t == 73 {
                    this.tag = cstrOf(p)
                    await this.c.sync(nil)?
                    break
                }
                if t == 69 {
                    this.done = true
                    this.finished = true
                    await this.c.sync(parseError(p))?
                    break
                }
                if t == 90 {
                    this.c.tx = int(p[0])
                    break
                }
            }
            this.done = true
            this.finished = true
        }
        return database.sql.Result{RowsAffected: affected(this.tag)}
    }
}

// ---- connecting and authentication ---------------------------------------------------

async func dial(cfg Config) net.Conn! {
    if strings.HasPrefix(cfg.Host, "/") || strings.HasPrefix(cfg.Host, "@") {
        var path = cfg.Host + "/.s.PGSQL." + fmt.Format("{0}", cfg.Port)
        return await net.DialUnix(path)?
    }
    var addr = net.JoinHostPort(cfg.Host, cfg.Port)
    if cfg.ConnectTimeout > 0 {
        return await net.DialTimeout(addr, cfg.ConnectTimeout)?
    }
    return await net.Dial(addr)?
}

// Negotiates TLS per cfg.SSLMode; nil stream means plain text.
async func upgrade(cfg Config, raw net.Conn) stream! {
    if cfg.SSLMode == "disable" || cfg.SSLMode == "allow" || strings.HasPrefix(cfg.Host, "/") {
        return raw
    }
    var w = writer{}
    w.begin(0)
    w.i32(80877103)
    w.end()
    _ = await raw.Write(w.b)?
    var ans = await raw.ReadExact(1)?
    if ans[0] != 83 {
        if cfg.SSLMode == "prefer" {
            return raw
        }
        raw.Close()
        return error("postgres: the server does not support SSL (sslmode=" + cfg.SSLMode + ")")
    }
    var tc = net.tls.Config{ServerName: cfg.Host}
    if cfg.SSLMode == "prefer" || cfg.SSLMode == "require" {
        tc.InsecureSkipVerify = cfg.SSLRootCert == "" || cfg.SSLMode == "prefer"
    }
    if cfg.SSLMode == "verify-ca" {
        tc.InsecureSkipVerify = true
    }
    var roots *crypto.x509.CertPool
    if cfg.SSLRootCert != "" {
        var pem = io.ReadFile(cfg.SSLRootCert)?("postgres: sslrootcert")
        roots = crypto.x509.NewCertPool()
        if roots.AppendPEM(pem) == 0 {
            return error("postgres: no certificates in " + cfg.SSLRootCert)
        }
        tc.RootCAs = roots
    }
    var tconn = await net.tls.Client(raw, tc)?
    await tconn.Handshake()?
    if cfg.SSLMode == "verify-ca" || (cfg.SSLMode == "require" && cfg.SSLRootCert != "") {
        var st = tconn.ConnectionState()
        if len(st.PeerCertificates) == 0 {
            return error("postgres: server sent no certificate")
        }
        var inter []*crypto.x509.Certificate = []
        for i, c in st.PeerCertificates {
            if i > 0 {
                inter = append(inter, c)
            }
        }
        _ = crypto.x509.Verify(st.PeerCertificates[0], crypto.x509.VerifyOptions{
            Roots: roots,
            Intermediates: inter,
        })?("postgres: server certificate")
    }
    return tconn
}

async func connect(
    dsn string,
    onNotice func(Error),
    onNotify func(Notification),
) database.sql.DriverConn! {
    var cfg = ParseDSN(dsn)?
    var raw = await dial(cfg)?
    var s = try await upgrade(cfg, raw) catch err {
        raw.Close()
        return err
    }
    var c = new conn{
        s: s,
        params: map[string]string{},
        onNotice: onNotice,
        onNotify: onNotify,
        cfg: cfg,
    }
    try await c.startup(cfg) catch err {
        c.bad = true
        _ = c.Close()
        return err
    }
    return c
}

func xorBytes(a []byte, b []byte) []byte {
    var out []byte = []
    for i, x in a {
        out = append(out, x ^ b[i])
    }
    return out
}

// The value of attribute k ("r", "s", "i", "v", "e") of a SCRAM message.
func scramAttr(msg string, k string) string {
    for part in strings.Split(msg, ",") {
        if strings.HasPrefix(part, k + "=") {
            return part[len(k) + 1..]
        }
    }
    return ""
}

// One client side of SCRAM-SHA-256 (RFC 5802, RFC 7677), without
// channel binding. Exported for tests and other protocols.
struct Scram {
    Password        string
    ClientNonce     string
    clientFirstBare string
    authMessage     string
    saltedPassword  []byte

    // The client-first-message ("n,,n=,r=<nonce>").
    func First() string {
        this.clientFirstBare = "n=,r=" + this.ClientNonce
        return "n,," + this.clientFirstBare
    }

    // The client-final-message for the server-first-message.
    func Final(serverFirst string) string! {
        var nonce = scramAttr(serverFirst, "r")
        var salt = encoding.base64.Decode(scramAttr(serverFirst, "s"))?("postgres: SCRAM salt")
        var iter = strconv.Atoi(scramAttr(serverFirst, "i"))?("postgres: SCRAM iteration count")
        if !strings.HasPrefix(nonce, this.ClientNonce) || len(nonce) <= len(this.ClientNonce) {
            return error("postgres: SCRAM server nonce does not extend the client nonce")
        }
        if iter < 1 {
            return error("postgres: SCRAM iteration count must be positive")
        }
        this.saltedPassword = crypto.kdf.Pbkdf2(
            strings.Bytes(this.Password),
            salt,
            iter,
            32,
            "sha256",
        )?
        var clientKey = crypto.hmac.Sum(
            "sha256",
            this.saltedPassword,
            strings.Bytes("Client Key"),
        )?
        var storedKey = crypto.hash.Sum("sha256", clientKey)?
        var withoutProof = "c=biws,r=" + nonce
        this.authMessage = this.clientFirstBare + "," + serverFirst + "," + withoutProof
        var sig = crypto.hmac.Sum("sha256", storedKey, strings.Bytes(this.authMessage))?
        return withoutProof + ",p=" + encoding.base64.Encode(xorBytes(clientKey, sig))
    }

    // Checks the server-final-message ("v=<signature>").
    func Verify(serverFinal string) void! {
        var e = scramAttr(serverFinal, "e")
        if e != "" {
            return error("postgres: SCRAM authentication failed: " + e)
        }
        var serverKey = crypto.hmac.Sum(
            "sha256",
            this.saltedPassword,
            strings.Bytes("Server Key"),
        )?
        var want = crypto.hmac.Sum("sha256", serverKey, strings.Bytes(this.authMessage))?
        var got = encoding.base64.Decode(
            scramAttr(serverFinal, "v"),
        )?("postgres: SCRAM server signature")
        if !crypto.hmac.Equal(want, got) {
            return error("postgres: SCRAM server signature mismatch")
        }
    }
}

func md5Password(user string, password string, salt []byte) string {
    var inner = crypto.hash.Md5Hex(password + user)
    return "md5" + crypto.hash.Md5Hex(inner + strings.FromBytes(salt))
}

// ---- LISTEN ----------------------------------------------------------------------

struct notifyQueue {
    items []Notification
}

// A dedicated connection receiving LISTEN/NOTIFY notifications.
struct Listener {
    c *conn
    q *notifyQueue

    // Waits for the next notification (fails once closed).
    async func Next() Notification! {
        for len(this.q.items) == 0 {
            if this.c.closed {
                return error("postgres: the listener is closed")
            }
            _ = await this.c.recv()?
        }
        var n = this.q.items[0]
        this.q.items = this.q.items[1..len(this.q.items)]
        return n
    }

    // Closes the connection (a waiting Next fails).
    func Close() {
        _ = this.c.Close()
    }
}

// Opens a connection to dsn that listens on the channels.
async func Listen(dsn string, channels []string) *Listener! {
    var q = new notifyQueue{items: []}
    var dc = await connect(dsn, nil, (n) => {
        q.items = append(q.items, n)
    })?
    switch dc {
    case *conn c:
        for ch in channels {
            _ = await c.simpleExec("LISTEN \"" + strings.ReplaceAll(ch, "\"", "\"\"") + "\"")?
        }
        c.listening = true
        return new Listener{c: c, q: q}
    }
    return error("postgres: unexpected connection type")
}
