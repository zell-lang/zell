// The Zell-source net (see sema/stdsrc.rs for the rules): TCP, UDP
// and Unix domain sockets, addresses and name resolution, over the
// runtime's socket handles (runtime/ABI.md section 16). Blocking points
// are awaits on readiness waits of the runtime's sharded I/O pollers
// (rtWaitReadable/rtWaitWritable), so a task waiting for the network
// never blocks a worker thread; name lookups run on the runtime's
// resolver pool.
//
// Errors: every failure of a socket operation is an OpError ("dial tcp
// 10.0.0.1:80: connection refused") wrapping the cause, which is one of
// the sentinels ErrClosed, ErrTimeout, ErrRefused, ErrReset,
// ErrUnreachable, ErrAddrInUse, ErrNotFound, ErrEOF (stdlib consts)
// when the cause is one of those, so errors.Is(err, net.ErrRefused) works
// through the wrap and errors.As(err, &op) finds the OpError.
namespace net

// ---- errors ----

// OpError describes a failed network operation: Op is "dial", "listen",
// "accept", "read", "write", "close", "set", "lookup"...; Net is "tcp",
// "udp" or "unix"; Addr the address involved ("" if none); Err the cause.
struct OpError {
    Op   string
    Net  string
    Addr string
    Err  error

    // Message returns "op net addr: cause".
    func Message() string {
        return opPrefix(this.Op, this.Net, this.Addr) + ": " + this.Err.Message()
    }

    // Unwrap returns the cause.
    func Unwrap() error {
        return this.Err
    }

    // Whether the cause is ErrTimeout.
    func Timeout() bool {
        return errors.Is(this.Err, ErrTimeout)
    }
}

func opPrefix(op string, nw string, addr string) string {
    var p = op
    if nw != "" {
        p += " " + nw
    }
    if addr != "" {
        p += " " + addr
    }
    return p
}

// An OpError for err (the cause): its message is "op net addr: cause".
func opError(op string, nw string, addr string, err error) error {
    var boxed error = OpError{Op: op, Net: nw, Addr: addr, Err: err}
    return rtOpError(boxed, opPrefix(op, nw, addr), err)
}

// IsTimeout reports whether err is (or wraps) ErrTimeout.
func IsTimeout(err error) bool {
    return errors.Is(err, ErrTimeout)
}

// ---- IP addresses ----

// IP is an IPv4 (4 bytes) or IPv6 (16 bytes) address; the zero value is
// invalid. IPv4-mapped IPv6 addresses (::ffff:a.b.c.d) stay 16 bytes;
// Is4() is true for them and To4() unmaps.
struct IP {
    b []byte

    // IsValid reports whether ip is an IPv4 or IPv6 address (not the zero IP).
    func IsValid() bool {
        return len(this.b) == 4 || len(this.b) == 16
    }

    // Is4 reports whether ip is an IPv4 (or IPv4-mapped IPv6) address.
    func Is4() bool {
        return len(this.b) == 4 || this.isMapped()
    }

    // Is6 reports whether ip is an IPv6 address that is not IPv4-mapped.
    func Is6() bool {
        return len(this.b) == 16 && !this.isMapped()
    }

    func isMapped() bool {
        if len(this.b) != 16 {
            return false
        }
        for i in 0..10 {
            if this.b[i] != 0 {
                return false
            }
        }
        return this.b[10] == 255 && this.b[11] == 255
    }

    // The 4-byte form of an IPv4 or IPv4-mapped address (else itself).
    func To4() IP {
        if this.isMapped() {
            return IP{b: bytes.Clone(this.b[12..16])}
        }
        return IP{b: this.b}
    }

    // A copy of the 4 or 16 bytes.
    func Bytes() []byte {
        return bytes.Clone(this.b)
    }

    // "192.0.2.1", "2001:db8::1"; "invalid IP" for the zero value.
    func String() string {
        if !this.IsValid() {
            return "invalid IP"
        }
        return rtFormatIP(this.b)
    }

    // Equal reports whether both are the same address (IPv4 equals its IPv4-mapped form).
    func Equal(o IP) bool {
        var a = this.To4()
        var c = o.To4()
        return a.IsValid() && bytes.Equal(a.b, c.b)
    }

    // 127.0.0.0/8 and ::1.
    func IsLoopback() bool {
        var a = this.To4()
        if len(a.b) == 4 {
            return a.b[0] == 127
        }
        if len(a.b) != 16 {
            return false
        }
        for i in 0..15 {
            if a.b[i] != 0 {
                return false
            }
        }
        return a.b[15] == 1
    }

    // 10/8, 172.16/12, 192.168/16 (RFC 1918) and fc00::/7 (RFC 4193).
    func IsPrivate() bool {
        var a = this.To4()
        if len(a.b) == 4 {
            return a.b[0] == 10 ||
                (a.b[0] == 172 && (a.b[1] & 240) == 16) ||
                (a.b[0] == 192 && a.b[1] == 168)
        }
        return len(a.b) == 16 && (a.b[0] & 254) == 252
    }

    // 224.0.0.0/4 and ff00::/8.
    func IsMulticast() bool {
        var a = this.To4()
        if len(a.b) == 4 {
            return (a.b[0] & 240) == 224
        }
        return len(a.b) == 16 && a.b[0] == 255
    }

    // 169.254/16 and fe80::/10.
    func IsLinkLocal() bool {
        var a = this.To4()
        if len(a.b) == 4 {
            return a.b[0] == 169 && a.b[1] == 254
        }
        return len(a.b) == 16 && a.b[0] == 254 && (a.b[1] & 192) == 128
    }

    // 0.0.0.0 and ::.
    func IsUnspecified() bool {
        if !this.IsValid() {
            return false
        }
        for c in this.b {
            if c != 0 {
                return false
            }
        }
        return true
    }
}

// ParseIP parses a numeric IPv4 ("192.0.2.1") or IPv6 ("2001:db8::1")
// address (no brackets, no zone: see ParseAddr).
func ParseIP(s string) IP! {
    var b = rtParseIP(s)
    if len(b) == 0 {
        return error("invalid IP address " + s)
    }
    return IP{b: b}
}

// IPv4 builds a.b.c.d.
func IPv4(a int, b int, c int, d int) IP {
    return IP{b: [byte(a), byte(b), byte(c), byte(d)]}
}

// IPv4zero (0.0.0.0) and IPv6 :: and ::1.
func IPv4Zero() IP {
    return IPv4(0, 0, 0, 0)
}

// IPv6Zero returns the unspecified IPv6 address ::.
func IPv6Zero() IP {
    var b = rtBytes(16)
    return IP{b: b}
}

// IPv6Loopback returns ::1.
func IPv6Loopback() IP {
    var b = rtBytes(16)
    b[15] = 1
    return IP{b: b}
}

// ---- socket addresses ----

// Addr is a socket address: IP, port and IPv6 zone, or the Path of a Unix
// domain socket ("@name" is the Linux abstract namespace).
struct Addr {
    IP   IP
    Port int
    Zone string
    Path string

    // "192.0.2.1:80", "[fe80::1%eth0]:80", or the Unix path.
    func String() string {
        if this.Path != "" || !this.IP.IsValid() {
            return this.Path
        }
        var host = this.IP.String()
        if this.Zone != "" {
            host += "%" + this.Zone
        }
        return JoinHostPort(host, this.Port)
    }

    // IsUnix reports whether the address is a Unix socket path.
    func IsUnix() bool {
        return this.Path != ""
    }

    func host() string {
        var h = this.IP.String()
        if this.Zone != "" {
            h += "%" + this.Zone
        }
        return h
    }
}

// ParseAddr parses a numeric "ip:port", "[ipv6]:port" or
// "[ipv6%zone]:port" (no host names: see ResolveAddr).
func ParseAddr(s string) Addr! {
    var hp = SplitHostPort(s)?
    var host = hp.Host
    var zone = ""
    var pct = strings.Index(host, "%")
    if pct >= 0 {
        zone = host[pct + 1..]
        host = host[..pct]
    }
    var ip = ParseIP(host)?
    if zone != "" && !ip.Is6() {
        return error("address " + s + ": a zone needs an IPv6 address")
    }
    return Addr{IP: ip, Port: hp.Port, Zone: zone}
}

// ParseAddr of the runtime's address text (never fails for its output).
func addrOf(s string) Addr {
    if s == "" ||
        strings.HasPrefix(s, "/") ||
        strings.HasPrefix(s, "@") ||
        !strings.Contains(s, ":") {
        return Addr{Path: s}
    }
    return try ParseAddr(s) else Addr{Path: s}
}

// Host and port of an address.
struct HostPort {
    Host string
    Port int
}

// SplitHostPort splits "host:port", "[ipv6]:port" or ":port".
func SplitHostPort(addr string) HostPort! {
    var i = strings.LastIndex(addr, ":")
    if i < 0 {
        return error("address " + addr + ": missing port")
    }
    var host = addr[..i]
    var ps = addr[i + 1..]
    if strings.HasPrefix(host, "[") && strings.HasSuffix(host, "]") {
        host = host[1..len(host) - 1]
    } else if strings.Contains(host, ":") {
        return error("address " + addr + ": too many colons (write IPv6 addresses as [ip]:port)")
    }
    var port = try strings.ToInt(ps) else -1
    if port < 0 && ps != "" && !strings.Contains(ps, " ") {
        port = rtLookupPort("tcp", ps)
    }
    if port < 0 || port > 65535 {
        return error("address " + addr + ": invalid port " + ps)
    }
    return HostPort{Host: host, Port: port}
}

// JoinHostPort is the inverse of SplitHostPort.
func JoinHostPort(host string, port int) string {
    if strings.Contains(host, ":") {
        return fmt.Format("[{0}]:{1}", host, port)
    }
    return fmt.Format("{0}:{1}", host, port)
}

// ---- name resolution ----

// ResolveIP looks up the IP addresses of host as strings, IPv4 first; an
// IP literal resolves to itself and "localhost" to 127.0.0.1. The lookup
// runs on the runtime's resolver pool.
async func ResolveIP(host string) []string! {
    if host == "" || host == "localhost" {
        return ["127.0.0.1"]
    }
    var h = await rtResolve(host, 1)
    return rtResolveTake(h)?
}

// Resolve looks up the addresses of host in the system's preference order
// (RFC 6724, getaddrinfo); fails with an error wrapping ErrNotFound when
// the name does not exist.
async func Resolve(host string) []IP! {
    var ss = await lookupOrdered(host)?
    var out []IP = []
    for s in ss {
        var pct = strings.Index(s, "%")
        var t = s
        if pct >= 0 {
            t = s[..pct]
        }
        out = append(out, ParseIP(t)?)
    }
    return out
}

// LookupHost is Resolve as strings (scoped IPv6 addresses carry "%zone").
async func LookupHost(host string) []string! {
    return await lookupOrdered(host)?
}

async func lookupOrdered(host string) []string! {
    if host == "" {
        return error("lookup: empty host name")
    }
    var h = await rtResolve(host, 0)
    return rtResolveTake(h)?
}

// LookupAddr returns the names of an IP address (reverse lookup).
async func LookupAddr(ip string) []string! {
    var h = await rtReverse(ip)
    return rtResolveTake(h)?
}

// LookupPort returns the port of a service name ("http") for network
// "tcp" or "udp"; numeric strings are parsed.
func LookupPort(network string, service string) int! {
    var p = rtLookupPort(network, service)
    if p < 0 {
        return opError("lookup", network, service, error("unknown port"))
    }
    return p
}

// ResolveAddr resolves "host:port" (host names and service names
// allowed) to its first address.
async func ResolveAddr(addr string) Addr! {
    var hp = SplitHostPort(addr)?
    if hp.Host == "" {
        return Addr{IP: IPv4Zero(), Port: hp.Port}
    }
    var ss = await lookupOrdered(hp.Host)?
    return ParseAddr(JoinHostPort(ss[0], hp.Port))?
}

// MakeBuffer returns a zeroed n-byte buffer for ReadInto/ReadFrom (one C
// allocation, unlike building it with append).
func MakeBuffer(n int) []byte {
    return rtBytes(n)
}

// ---- the socket object ----

// A socket owned by Conn/Listener/UDPConn: the runtime handle `h` owns the
// descriptor (closed by Close, or by Drop at the latest, which also frees
// the handle). Deadlines are time.Now() milliseconds (0: none).
struct sock {
    h       int
    nw      string
    laddr   string
    timeout int
    rdl     int
    wdl     int
    pend    []byte
    poff    int
    lbuf    []byte
    peerOK  bool
    // the last stream read returned fewer bytes than asked: the socket is
    // drained, so the next read waits for readiness before calling recv
    // (instead of a recv that would fail with EAGAIN)
    drained bool

    func Drop() {
        if this.h != 0 {
            rtFree(this.h)
        }
    }

    func close() {
        rtClose(this.h)
    }

    func isClosed() bool {
        return rtIsClosed(this.h)
    }

    // The address named in errors: the peer of a connection, else the local one.
    func errAddr() string {
        if this.peerOK {
            return rtRemoteAddr(this.h)
        }
        return this.laddr
    }

    func fail(op string, err error) error {
        return opError(op, this.nw, this.errAddr(), err)
    }

    // Milliseconds the next wait may take (0: unlimited); -1 if the deadline passed.
    func budget(deadline int) int {
        var ms = this.timeout
        if deadline > 0 {
            var left = deadline - time.Now()
            if left <= 0 {
                return -1
            }
            if ms <= 0 || left < ms {
                ms = left
            }
        }
        return ms
    }

    async func waitRead(op string) void! {
        var ms = this.budget(this.rdl)
        if ms < 0 {
            return this.fail(op, ErrTimeout)
        }
        var r = await rtWaitReadable(this.h, ms)
        if r == 1 {
            return this.fail(op, ErrTimeout)
        }
        if r == 2 {
            return this.fail(op, ErrClosed)
        }
        if r == 3 {
            return task.ErrCancelled
        }
    }

    async func waitWrite(op string) void! {
        var ms = this.budget(this.wdl)
        if ms < 0 {
            return this.fail(op, ErrTimeout)
        }
        var r = await rtWaitWritable(this.h, ms)
        if r == 1 {
            return this.fail(op, ErrTimeout)
        }
        if r == 2 {
            return this.fail(op, ErrClosed)
        }
        if r == 3 {
            return task.ErrCancelled
        }
    }

    func pending() int {
        return len(this.pend) - this.poff
    }

    // Takes up to n read-ahead bytes.
    func takePending(n int) []byte {
        var k = this.pending()
        if n < k {
            k = n
        }
        var out = bytes.Clone(this.pend[this.poff..this.poff + k])
        this.poff += k
        if this.poff == len(this.pend) {
            this.pend = []
            this.poff = 0
        }
        return out
    }

    func checkDeadline(dl int, op string) void! {
        if dl > 0 && time.Now() >= dl {
            return this.fail(op, ErrTimeout)
        }
    }

    async func read(n int) []byte! {
        if this.pending() > 0 && n > 0 {
            return this.takePending(n)
        }
        this.checkDeadline(this.rdl, "read")?
        if this.drained {
            this.drained = false
            await this.waitRead("read")?
        }
        for {
            var b = try rtRead(this.h, n) catch err {
                return this.fail("read", err)
            }
            if len(b) > 0 || !rtAgain() {
                this.drained = len(b) > 0 && len(b) < n && this.nw != "udp"
                return b
            }
            await this.waitRead("read")?
        }
    }

    async func readString(n int) string! {
        var b = await this.read(n)?
        return strings.FromBytes(b)
    }

    // Reads into buf[off..]: bytes read, 0 at end of stream.
    async func readInto(buf []byte, off int) int! {
        if off >= len(buf) {
            return 0
        }
        if this.pending() > 0 {
            var k = rtCopyBytes(buf, off, this.pend, this.poff, this.pending())
            this.poff += k
            if this.poff == len(this.pend) {
                this.pend = []
                this.poff = 0
            }
            return k
        }
        this.checkDeadline(this.rdl, "read")?
        if this.drained {
            this.drained = false
            await this.waitRead("read")?
        }
        for {
            var k = try rtReadInto(this.h, buf, off) catch err {
                return this.fail("read", err)
            }
            if k >= 0 {
                this.drained = k > 0 && k < len(buf) - off && this.nw != "udp"
                return k
            }
            await this.waitRead("read")?
        }
    }

    async func readExact(n int) []byte! {
        var buf = rtBytes(n)
        var off = 0
        for off < n {
            var k = await this.readInto(buf, off)?
            if k == 0 {
                return this.fail("read", ErrEOF)
            }
            off += k
        }
        return buf
    }

    async func readAll(limit int) []byte! {
        var out []byte = []
        if this.pending() > 0 {
            out = this.takePending(this.pending())
        }
        var buf = rtBytes(32768)
        for {
            var k = await this.readInto(buf, 0)?
            if k == 0 {
                return out
            }
            out = rtJoin(out, buf, k)
            if limit > 0 && len(out) > limit {
                return this.fail("read", error("more than the read limit"))
            }
        }
    }

    // A line without its "\n" (or "\r\n"); the last line may lack it;
    // ErrEOF at the end of the stream.
    async func readLine() string! {
        var scanned = this.poff
        for {
            var i = rtIndexByte(this.pend, scanned, 10)
            if i >= 0 {
                var end = i
                if end > this.poff && this.pend[end - 1] == 13 {
                    end -= 1
                }
                var line = strings.FromBytes(this.pend[this.poff..end])
                this.poff = i + 1
                if this.poff == len(this.pend) {
                    this.pend = []
                    this.poff = 0
                }
                return line
            }
            scanned = len(this.pend)
            if len(this.lbuf) == 0 {
                this.lbuf = rtBytes(4096)
            }
            var buf = this.lbuf
            var k = await this.readRaw(buf)?
            if k == 0 {
                if this.pending() == 0 {
                    return this.fail("read", ErrEOF)
                }
                var rest = strings.FromBytes(this.pend[this.poff..])
                this.pend = []
                this.poff = 0
                return rest
            }
            var keep = this.pend[this.poff..]
            scanned -= this.poff
            this.pend = rtJoin(keep, buf, k)
            this.poff = 0
        }
    }

    // readInto that ignores the read-ahead (for readLine).
    async func readRaw(buf []byte) int! {
        this.checkDeadline(this.rdl, "read")?
        for {
            var k = try rtReadInto(this.h, buf, 0) catch err {
                return this.fail("read", err)
            }
            if k >= 0 {
                return k
            }
            await this.waitRead("read")?
        }
    }

    async func write(data []byte) int! {
        var off = 0
        this.checkDeadline(this.wdl, "write")?
        for off < len(data) {
            var k = try rtWrite(this.h, data, off) catch err {
                return this.fail("write", err)
            }
            if k < 0 {
                await this.waitWrite("write")?
            } else {
                off += k
            }
        }
        return off
    }

    async func writeString(text string) int! {
        var off = 0
        this.checkDeadline(this.wdl, "write")?
        for off < len(text) {
            var k = try rtWriteStr(this.h, text, off) catch err {
                return this.fail("write", err)
            }
            if k < 0 {
                await this.waitWrite("write")?
            } else {
                off += k
            }
        }
        return off
    }

    async func writeV(bufs [][]byte) int! {
        var total = 0
        for b in bufs {
            total += len(b)
        }
        var off = 0
        this.checkDeadline(this.wdl, "write")?
        for off < total {
            var k = try rtWriteV(this.h, bufs, off) catch err {
                return this.fail("write", err)
            }
            if k < 0 {
                await this.waitWrite("write")?
            } else {
                off += k
            }
        }
        return total
    }

    async func sendFile(path string, off int, n int) int! {
        var f = try rtOpenFile(path) catch err {
            return this.fail("sendfile", err)
        }
        var size = rtFileSize(f)
        var end = size
        if n >= 0 && off + n < size {
            end = off + n
        }
        var pos = off
        for pos < end {
            var k = try rtSendFile(this.h, f, pos, end - pos) catch err {
                rtCloseFile(f)
                return this.fail("sendfile", err)
            }
            if k == 0 {
                break
            }
            if k < 0 {
                try await this.waitWrite("sendfile") catch err {
                    rtCloseFile(f)
                    return err
                }
            } else {
                pos += k
            }
        }
        rtCloseFile(f)
        return pos - off
    }

    func setOpt(opt int, v int) void! {
        try rtSetOpt(this.h, opt, v) catch err {
            return this.fail("set", err)
        }
    }

    func setFlag(opt int, on bool) void! {
        var v = 0
        if on {
            v = 1
        }
        this.setOpt(opt, v)?
    }

    func setKeepAlive(idle int, interval int, count int) void! {
        if idle <= 0 {
            this.setOpt(2, 0)?
            return
        }
        this.setOpt(2, 1)?
        this.setOpt(3, idle)?
        if interval > 0 {
            this.setOpt(4, interval)?
        }
        if count > 0 {
            this.setOpt(5, count)?
        }
    }

    func shutdown(how int) void! {
        try rtShutdown(this.h, how) catch err {
            return this.fail("shutdown", err)
        }
    }
}

// ---- TCP / Unix stream connections ----

// Conn is a TCP or Unix stream connection. Copies share the socket, which
// is closed by Close() (a second Close is a no-op) or when the last copy
// is gone. Operations on a closed Conn fail with ErrClosed; Close wakes
// operations waiting on the socket, which fail with ErrClosed too.
//
// Reading: Read(n) returns a new slice of up to n bytes, ReadInto(buf)
// fills a caller buffer (no allocation) and returns the count; both
// signal the end of the stream by an empty result / 0, never by an
// error. ReadExact(n) fails with ErrEOF if the stream ends first,
// ReadAll reads to the end, ReadLine returns one line (ErrEOF at the
// end). Writing: Write/WriteString/WriteV write everything (looping over
// short writes) or fail; a deadline or timeout fails with ErrTimeout.
struct Conn {
    s *sock

    // Reads up to n bytes; an empty result means the peer closed the
    // connection (end of stream).
    func Read(n int) Task<[]byte!> {
        return this.s.read(n)
    }

    // Read as a string.
    func ReadString(n int) Task<string!> {
        return this.s.readString(n)
    }

    // Reads into buf: the number of bytes read (>= 1), or 0 at the end of
    // the stream (or for an empty buf).
    func ReadInto(buf []byte) Task<int!> {
        return this.s.readInto(buf, 0)
    }

    // Reads exactly n bytes; fails (wrapping ErrEOF) if the stream ends first.
    func ReadExact(n int) Task<[]byte!> {
        return this.s.readExact(n)
    }

    // Reads until the end of the stream.
    func ReadAll() Task<[]byte!> {
        return this.s.readAll(0)
    }

    // Reads one line, without "\n" / "\r\n"; the last line may lack the
    // newline; fails with ErrEOF at the end. Bytes read past the line are
    // kept for the next read.
    func ReadLine() Task<string!> {
        return this.s.readLine()
    }

    // Writes all of data; yields the number of bytes written.
    func Write(data []byte) Task<int!> {
        return this.s.write(data)
    }

    // WriteString writes text.
    func WriteString(text string) Task<int!> {
        return this.s.writeString(text)
    }

    // Gathered write of all buffers (one sendmsg per readiness).
    func WriteV(bufs [][]byte) Task<int!> {
        return this.s.writeV(bufs)
    }

    // Sends n bytes of the file at path from offset off (n < 0: to the
    // end) with sendfile(2) where available; yields the bytes sent.
    func SendFile(path string, off int, n int) Task<int!> {
        return this.s.sendFile(path, off, n)
    }

    // Timeout in milliseconds for each later wait of Read/Write (0: none);
    // a timed-out operation fails with ErrTimeout ("i/o timeout").
    func SetTimeout(ms int) {
        this.s.timeout = ms
    }

    // Absolute deadlines in time.Now() milliseconds (0: none) for
    // reads, writes, or both; operations after it fail with ErrTimeout.
    func SetDeadline(t int) {
        this.s.rdl = t
        this.s.wdl = t
    }

    // SetReadDeadline sets the read deadline only (see SetDeadline).
    func SetReadDeadline(t int) {
        this.s.rdl = t
    }

    // SetWriteDeadline sets the write deadline only (see SetDeadline).
    func SetWriteDeadline(t int) {
        this.s.wdl = t
    }

    // Close closes the connection; pending operations fail with ErrClosed.
    func Close() {
        if this.s != nil {
            this.s.close()
        }
    }

    // Half-close: no more writes (the peer reads end of stream).
    func CloseWrite() void! {
        this.s.shutdown(2)?
    }

    // Half-close: no more reads.
    func CloseRead() void! {
        this.s.shutdown(1)?
    }

    // IsClosed reports whether Close was called.
    func IsClosed() bool {
        return this.s == nil || this.s.isClosed()
    }

    // LocalAddr returns the local "ip:port".
    func LocalAddr() string {
        return rtLocalAddr(this.s.h)
    }

    // RemoteAddr returns the peer's "ip:port".
    func RemoteAddr() string {
        return rtRemoteAddr(this.s.h)
    }

    // Local returns the local address.
    func Local() Addr {
        return addrOf(rtLocalAddr(this.s.h))
    }

    // Remote returns the peer's address.
    func Remote() Addr {
        return addrOf(rtRemoteAddr(this.s.h))
    }

    // The descriptor (-1 once closed); owned by the Conn.
    func Fd() int {
        return rtFd(this.s.h)
    }

    // TCP_NODELAY (on by default: writes are not delayed to coalesce).
    func SetNoDelay(on bool) void! {
        this.s.setFlag(1, on)?
    }

    // TCP_CORK (Linux) / TCP_NOPUSH (BSD): hold partial frames until
    // uncorked, e.g. around a header write followed by SendFile.
    func SetCork(on bool) void! {
        this.s.setFlag(12, on)?
    }

    // TCP keep-alive: probes after idle seconds, every interval seconds,
    // count times (0: the system default); idle <= 0 turns it off.
    func SetKeepAlive(idle int, interval int, count int) void! {
        this.s.setKeepAlive(idle, interval, count)?
    }

    // SO_RCVBUF / SO_SNDBUF in bytes.
    func SetReadBuffer(n int) void! {
        this.s.setOpt(6, n)?
    }

    // SetWriteBuffer sets SO_SNDBUF in bytes.
    func SetWriteBuffer(n int) void! {
        this.s.setOpt(7, n)?
    }

    // SO_LINGER: sec < 0 restores the default (close returns at once,
    // the system sends the rest); 0 resets the connection on Close.
    func SetLinger(sec int) void! {
        this.s.setOpt(8, sec)?
    }
}

func newConn(h int, nw string) Conn {
    return Conn{s: new sock{h: h, nw: nw, peerOK: true}}
}

// Dialer holds dial options; the zero value (and `net.Dialer{}`) uses the
// defaults below. Dial(addr) is Dialer{}.Dial(addr).
struct Dialer {
    // Milliseconds for the whole dial (every attempt), 0 = none.
    Timeout int
    // TCP keep-alive idle seconds for the connection (0: system default,
    // usually off; < 0: off).
    KeepAlive int
    // Local "ip:port" to bind before connecting ("" = any).
    LocalAddr string
    // Happy Eyeballs (RFC 8305): race IPv6 and IPv4 addresses, starting
    // the next attempt FallbackDelay ms after the previous one.
    DualStack     bool = true
    FallbackDelay int = 300
    // TCP_NODELAY (default on).
    NoDelay bool = true

    // Dial connects to addr ("host:port") over TCP with the dialer's options.
    func Dial(addr string) Task<Conn!> {
        return dialWith(*this, addr)
    }
}

// Dial connects to addr ("host:port") over TCP.
async func Dial(addr string) Conn! {
    var d Dialer
    return await dialWith(d, addr)?
}

// DialTimeout is Dial with a timeout in milliseconds (0: none).
async func DialTimeout(addr string, ms int) Conn! {
    var d Dialer
    d.Timeout = ms
    return await dialWith(d, addr)?
}

// Orders addresses for Happy Eyeballs: alternate families, starting with
// the family of the first (preferred) address.
func interleave(ips []string) []string {
    var a []string = []
    var b []string = []
    var first6 = strings.Contains(ips[0], ":")
    for ip in ips {
        if strings.Contains(ip, ":") == first6 {
            a = append(a, ip)
        } else {
            b = append(b, ip)
        }
    }
    var out []string = []
    var i = 0
    for i < len(a) || i < len(b) {
        if i < len(a) {
            out = append(out, a[i])
        }
        if i < len(b) {
            out = append(out, b[i])
        }
        i += 1
    }
    return out
}

async func dialWith(d Dialer, addr string) Conn! {
    var hp = try SplitHostPort(addr) catch err {
        return opError("dial", "tcp", addr, err)
    }
    var lip = ""
    var lport = 0
    if d.LocalAddr != "" {
        var la = try SplitHostPort(d.LocalAddr) catch err {
            return opError("dial", "tcp", addr, err)
        }
        lip = la.Host
        lport = la.Port
    }
    var ips []string = []
    if hp.Host == "" {
        ips = ["127.0.0.1"]
    } else {
        ips = try await lookupOrdered(hp.Host) catch err {
            return opError("dial", "tcp", addr, err)
        }
    }
    if len(ips) > 1 {
        if d.DualStack {
            ips = interleave(ips)
        } else {
            // sequential: IPv4 first, like ResolveIP
            var v4 []string = []
            var v6 []string = []
            for ip in ips {
                if strings.Contains(ip, ":") {
                    v6 = append(v6, ip)
                } else {
                    v4 = append(v4, ip)
                }
            }
            for ip in v6 {
                v4 = append(v4, ip)
            }
            ips = v4
        }
    }
    var deadline = 0
    if d.Timeout > 0 {
        deadline = time.Now() + d.Timeout
    }
    var delay = d.FallbackDelay
    if !d.DualStack || delay <= 0 {
        delay = 0
    }
    var hs []int = []
    var hips []string = []
    var next = 0
    var last error = ErrNotFound
    var lastIP = hp.Host
    for {
        // start the next attempt when none is running or the previous one
        // has had its head start
        if next < len(ips) {
            var ip = ips[next]
            next += 1
            var h = try rtDial(ip, hp.Port, lip, lport) catch err {
                last = err
                lastIP = ip
                continue
            }
            hs = append(hs, h)
            hips = append(hips, ip)
        }
        if len(hs) == 0 {
            if next < len(ips) {
                continue
            }
            return opError("dial", "tcp", JoinHostPort(lastIP, hp.Port), last)
        }
        var ms = 0
        if deadline > 0 {
            ms = deadline - time.Now()
            if ms <= 0 {
                closeAll(hs)
                return opError("dial", "tcp", addr, ErrTimeout)
            }
        }
        if delay > 0 && next < len(ips) && (ms == 0 || delay < ms) {
            ms = delay
        }
        _ = await rtWaitAnyWritable(hs, ms)
        if task.IsCancelled() {
            closeAll(hs)
            return task.ErrCancelled
        }
        // collect every attempt that finished (the winner first)
        var keep []int = []
        var keepIPs []string = []
        var winner = 0
        for i in 0..len(hs) {
            var st = try rtConnectCheck(hs[i]) catch err {
                last = err
                lastIP = hips[i]
                rtFree(hs[i])
                continue
            }
            if st == 1 && winner == 0 {
                winner = hs[i]
                continue
            }
            keep = append(keep, hs[i])
            keepIPs = append(keepIPs, hips[i])
        }
        hs = keep
        hips = keepIPs
        if winner != 0 {
            closeAll(hs)
            var c = newConn(winner, "tcp")
            if !d.NoDelay {
                c.SetNoDelay(false)?
            }
            if d.KeepAlive > 0 {
                c.SetKeepAlive(d.KeepAlive, d.KeepAlive, 0)?
            } else if d.KeepAlive < 0 {
                c.SetKeepAlive(0, 0, 0)?
            }
            return c
        }
    }
    return last
}

func closeAll(hs []int) {
    for h in hs {
        rtFree(h)
    }
}

// DialUnix connects to the Unix domain stream socket at path ("@name":
// Linux abstract namespace).
async func DialUnix(path string) Conn! {
    var h = try rtDialUnix(path) catch err {
        return opError("dial", "unix", path, err)
    }
    return newConn(h, "unix")
}

// ---- listeners ----

// Listener accepts TCP or Unix stream connections. Copies share the
// socket (closed by Close or when the last copy is gone; a Unix
// listener then removes its socket file).
struct Listener {
    s *sock

    // Waits for the next connection; fails with ErrClosed once the
    // listener is closed (also when it is closed while waiting).
    func Accept() Task<Conn!> {
        return acceptOn(this.s)
    }

    // Close stops listening; a waiting Accept fails with ErrClosed.
    func Close() {
        if this.s != nil {
            this.s.close()
        }
    }

    // IsClosed reports whether Close was called.
    func IsClosed() bool {
        return this.s == nil || this.s.isClosed()
    }

    // The bound address ("ip:port", or the Unix path).
    func Addr() string {
        return this.s.laddr
    }

    // Local returns the bound address.
    func Local() Addr {
        return addrOf(this.s.laddr)
    }

    // The bound port (useful after listening on port 0).
    func Port() int {
        return rtPort(this.s.h)
    }

    // Fd returns the OS socket handle.
    func Fd() int {
        return rtFd(this.s.h)
    }

    // Milliseconds each Accept may wait (0: none); then ErrTimeout.
    func SetTimeout(ms int) {
        this.s.timeout = ms
    }
}

async func acceptOn(s *sock) Conn! {
    for {
        var h = try rtAccept(s.h) catch err {
            return s.fail("accept", err)
        }
        if h != -1 {
            return newConn(h, s.nw)
        }
        await s.waitRead("accept")?
    }
}

// ListenConfig holds listen options; the zero value uses the defaults.
struct ListenConfig {
    // SO_REUSEADDR (default on: restart without waiting for TIME_WAIT).
    ReuseAddr bool = true
    // SO_REUSEPORT: several sockets share the port (kernel load balancing).
    ReusePort bool
    // Pending-connection queue length (0: 4096, capped by the system).
    Backlog int
    // IPv6 sockets accept only IPv6 (no IPv4-mapped peers).
    V6Only bool
    // TCP Fast Open on the listener (where supported).
    FastOpen bool

    func flags() int {
        var f = 0
        if !this.ReuseAddr {
            f += 1
        }
        if this.ReusePort {
            f += 2
        }
        if this.V6Only {
            f += 4
        }
        if this.FastOpen {
            f += 8
        }
        return f
    }

    // Listen on "host:port" (TCP). An empty host listens on every
    // interface, dual-stack (IPv6 and IPv4) where IPv6 exists; port 0
    // picks a free port; a host name is resolved (blocking lookup on the
    // calling thread) and the first address is used.
    func Listen(addr string) Listener! {
        var hp = try SplitHostPort(addr) catch err {
            return opError("listen", "tcp", addr, err)
        }
        var ip = listenHost(hp.Host)?
        var h = try rtListen(ip, hp.Port, this.Backlog, this.flags()) catch err {
            return opError("listen", "tcp", addr, err)
        }
        return Listener{s: new sock{h: h, nw: "tcp", laddr: rtLocalAddr(h)}}
    }

    // ListenUDP binds a UDP socket to "host:port" (empty host: every
    // interface, dual-stack).
    func ListenUDP(addr string) UDPConn! {
        var hp = try SplitHostPort(addr) catch err {
            return opError("listen", "udp", addr, err)
        }
        var ip = listenHost(hp.Host)?
        var h = try rtUdp(ip, hp.Port, this.flags()) catch err {
            return opError("listen", "udp", addr, err)
        }
        return UDPConn{s: new sock{h: h, nw: "udp", laddr: rtLocalAddr(h)}}
    }

    // ListenUnix listens on a Unix domain stream socket ("@name": Linux
    // abstract namespace). The socket file is removed when the listener
    // is closed; an existing file makes it fail with ErrAddrInUse.
    func ListenUnix(path string) Listener! {
        var h = try rtListenUnix(path, this.Backlog) catch err {
            return opError("listen", "unix", path, err)
        }
        return Listener{s: new sock{h: h, nw: "unix", laddr: path}}
    }
}

func listenHost(host string) string! {
    if host == "" || rtIsIP(host) || strings.Contains(host, "%") {
        return host
    }
    if host == "localhost" {
        return "127.0.0.1"
    }
    var ips = try rtResolveSync(host, 2) catch err {
        return opError("listen", "tcp", host, err)
    }
    return ips[0]
}

// Listen listens for TCP connections on addr ("host:port"); see
// ListenConfig.Listen.
func Listen(addr string) Listener! {
    var lc ListenConfig
    return lc.Listen(addr)?
}

// ListenUnix listens on a Unix domain stream socket; see ListenConfig.ListenUnix.
func ListenUnix(path string) Listener! {
    var lc ListenConfig
    return lc.ListenUnix(path)?
}
