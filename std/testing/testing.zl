// testing and the runtime half of `zell test`.
//
// Test functions are marked @test: `@test func TestAdd(t *testing.T)` or
// a plain `@test func Something()`; `@bench func BenchX(b *testing.B)`
// (or `@test` with a *testing.B) is a benchmark (run with `zell test
// --bench`). `zell test [path]` finds them, generates a driver calling
// Main with every Case and runs it.
//
// Isolation: Main runs every test in its own child process (the test
// binary re-executes itself with --run-one), so t.Fatal, t.Skip and even
// a panic end only that test. t.Run subtests run inside their parent's
// process; a Fatal in a subtest ends the whole top-level test.
//
// Parallel tests: a test whose body calls `t.Parallel()` (as a statement
// of the test function; `zell test` finds the call when it discovers the
// tests) runs concurrently with the other parallel tests, up to
// `--parallel N` (default 4) child processes at a time, after the
// sequential tests (each sequential test runs alone). Results are printed
// in that order: sequential tests, then parallel ones by declaration.
//
// testing.Panics(t, fn) checks that fn panics: fn runs on a thread of its
// own whose panic is caught (no defers run in fn); where that is not
// possible (Windows) the test binary re-runs the current test in a child
// process up to that Panics call, where the child calls fn.
//
// Assertions (testing.Equal(t, got, want) ...) report through t.Error and
// keep going; the ...Fatal variants stop the test (testing.EqualFatal).
//
// Fallible code: a test may return `void!` and use `?` (a returned error
// fails it with `error: <message>` and the trace); `t.Must(f())` gives the
// value of a `T!` call or ends the test with `file:line: <message>`, and
// `t.MustFail(f())` gives its error or ends the test with `file:line:
// expected an error`. Must and MustFail are compiler intrinsics (the only
// calls taking an unhandled `T!`), not methods declared here.
//
// Table tests are plain slices of structs:
//
//   @test func TestAbs(t *testing.T) {
//       var cases = [Case{In: -1, Want: 1}, Case{In: 2, Want: 2}]
//       for c in cases {
//           t.Run(fmt.Format("{0}", c.In), func(t *testing.T) {
//               testing.Equal(t, math.IAbs(c.In), c.Want)
//           })
//       }
//   }
namespace testing

// One discovered test (generated by `zell test`).
struct Case {
    Name  string
    Run   func(*T)
    Bench func(*B)
    // An `async @test` (func(t *testing.T) Task<void>): awaited by the
    // child process that runs the test.
    RunAsync func(*T) Task<void>
    // A test declared `void!` (`func TestX(t *testing.T) void!`, also
    // async): an error it returns fails the test, logged as
    // `error: <message>` with its error trace.
    RunErr      func(*T) void!
    RunAsyncErr func(*T) Task<void!>
    // The same for a `void!` test without parameters.
    PlainErr      func() void!
    PlainAsyncErr func() Task<void!>
    // The test calls t.Parallel() (found by `zell test`).
    Parallel bool
}

// Whether c is a test (not a benchmark).
func isTest(c Case) bool {
    return c.Run != nil || c.RunAsync != nil || c.RunErr != nil || c.RunAsyncErr != nil || c.PlainErr != nil || c.PlainAsyncErr != nil
}

// The handle of a running test.
struct T {
    name    string
    failed  bool
    skipped bool
    depth   int
    verbose bool
    noTime  bool
    // testing.Panics: calls seen so far in this test, and (in a probe
    // child) which call of which (sub)test to run.
    panicsSeen int
    probeName  string
    probe      int
    // In-process run (`zell test --debug`): FailNow and Skip end the
    // test's task (a task panic) instead of the process; ended marks it.
    inProcess bool
    ended     bool

    // Name returns the test name ("TestX/sub" for subtests).
    func Name() string {
        return this.name
    }

    // Failed reports whether the test has failed.
    func Failed() bool {
        return this.failed
    }

    // Skipped reports whether the test was skipped.
    func Skipped() bool {
        return this.skipped
    }

    func indent() string {
        return strings.Repeat("    ", this.depth + 1)
    }

    // Records a message (shown for failing tests and with -v).
    func Log(msg string) {
        io.println(this.indent() + strings.Replace(msg, "\n", "\n" + this.indent()))
    }

    // Marks the test failed and logs msg; the test continues.
    func Error(msg string) {
        this.failed = true
        this.Log(msg)
    }

    // Marks the test failed (without a message).
    func Fail() {
        this.failed = true
    }

    // Marks the test failed, logs msg and ends it.
    func Fatal(msg string) {
        this.failed = true
        this.Log(msg)
        this.FailNow()
    }

    // t.Must(x) when x failed (lowered by the compiler, sema/testing.rs):
    // logs `at: message` and the error trace, ends the test.
    func mustError(err error, at string) {
        this.failWith(at + ": ", err)
    }

    // Logs prefix + the message of err, then its error trace, and ends the
    // test as failed (a `void!` test that returned err: prefix "error: ",
    // as an uncaught error in main prints).
    func failWith(prefix string, err error) {
        this.failed = true
        this.Log(prefix + err.Message())
        var trace = errors.Trace(err)
        if trace != "" {
            this.Log(trace)
        }
        this.FailNow()
    }

    // Ends the test now (failed if it was marked failed).
    func FailNow() {
        if this.inProcess {
            this.ended = true
            panic("testing: " + this.name + " ended")
        }
        if this.failed {
            os.Exit(1)
        }
        os.Exit(0)
    }

    // Skips the rest of the test.
    func Skip(msg string) {
        this.skipped = true
        if msg != "" {
            this.Log(msg)
        }
        if this.inProcess {
            this.ended = true
            panic("testing: " + this.name + " skipped")
        }
        if this.failed {
            os.Exit(1)
        }
        os.Exit(3)
    }

    // Marks the test as safe to run in parallel with the other parallel
    // tests. `zell test` finds the call statically (it must be a
    // statement of the test function); at run time it does nothing.
    func Parallel() {}

    // Runs fn as subtest name; returns true if it passed.
    func Run(name string, fn func(*T)) bool {
        var sub = new T{
            name: this.name + "/" + strings.Replace(name, " ", "_"),
            depth: this.depth + 1,
            verbose: this.verbose,
            noTime: this.noTime,
            probeName: this.probeName,
            probe: this.probe,
        }
        var start = time.NowInstant()
        io.println(strings.Repeat("    ", this.depth + 1) + "=== RUN   " + sub.name)
        fn(sub)
        var status = "PASS"
        if sub.failed {
            status = "FAIL"
            this.failed = true
        } else if sub.skipped {
            status = "SKIP"
        }
        io.println(
            strings.Repeat("    ", this.depth + 1) +
                "--- " +
                status +
                ": " +
                sub.name +
                timeText(start.Elapsed(), this.noTime),
        )
        return !sub.failed
    }
}

// The handle of a running benchmark: run the measured code b.N times.
struct B {
    N          int
    name       string
    failed     bool
    start      time.Instant
    elapsed    time.Duration
    running    bool
    allocStart int
    allocs     int

    // Name returns the benchmark name.
    func Name() string {
        return this.name
    }

    // Restarts the measurement (excludes setup before it).
    func ResetTimer() {
        this.start = time.NowInstant()
        this.elapsed = time.Duration{}
        this.allocStart = diag.rtAllocations()
        this.allocs = 0
    }

    // StopTimer pauses the measurement (excludes the code until StartTimer).
    func StopTimer() {
        if this.running {
            this.elapsed = this.elapsed.Add(this.start.Elapsed())
            this.allocs += diag.rtAllocations() - this.allocStart
            this.running = false
        }
    }

    // StartTimer resumes the measurement.
    func StartTimer() {
        if !this.running {
            this.start = time.NowInstant()
            this.allocStart = diag.rtAllocations()
            this.running = true
        }
    }

    // Allocations are always reported (allocs/op); kept for Go parity.
    func ReportAllocs() {}

    // Log prints msg under the benchmark.
    func Log(msg string) {
        io.println("    " + msg)
    }

    // Error marks the benchmark failed and logs msg.
    func Error(msg string) {
        this.failed = true
        this.Log(msg)
    }

    // Fatal marks the benchmark failed, logs msg and ends it.
    func Fatal(msg string) {
        this.failed = true
        this.Log(msg)
        os.Exit(1)
    }
}

// " (0.01s)", or "" with --no-time (for golden outputs).
func timeText(d time.Duration, off bool) string {
    if off {
        return ""
    }
    return " (" + seconds(d) + ")"
}

func seconds(d time.Duration) string {
    return strconv.FormatFloat(d.Seconds(), 'f', 2) + "s"
}

// ---- assertions -------------------------------------------------------------------

func show<V>(v V) string {
    if reflect.TypeOf<V>().Kind == reflect.Kind.String {
        return strconv.Quote(v)
    } else {
        return fmt.Format("{0}", v)
    }
}

// Reports an error unless got == want.
func Equal<V: Comparable>(t *T, got V, want V) bool {
    if got != want {
        t.Error("got " + show(got) + ", want " + show(want))
        return false
    }
    return true
}

// EqualMsg is Equal with context: on failure it reports
// "msg: got X, want Y". Every assertion that takes a message puts it first
// in the report, like True and False.
func EqualMsg<V: Comparable>(t *T, got V, want V, msg string) bool {
    if got != want {
        t.Error(msg + ": got " + show(got) + ", want " + show(want))
        return false
    }
    return true
}

// Equal that ends the test on failure.
func EqualFatal<V: Comparable>(t *T, got V, want V) {
    if got != want {
        t.Fatal("got " + show(got) + ", want " + show(want))
    }
}

// Reports an error if got == other.
func NotEqual<V: Comparable>(t *T, got V, other V) bool {
    if got == other {
        t.Error("got " + show(got) + ", want anything else")
        return false
    }
    return true
}

// Compares slices element by element.
func EqualSlices<V: Comparable>(t *T, got []V, want []V) bool {
    if !slices.Equal(got, want) {
        t.Error("got " + fmt.Format("{0}", got) + ", want " + fmt.Format("{0}", want))
        return false
    }
    return true
}

// True reports an error with msg unless cond holds.
func True(t *T, cond bool, msg string) bool {
    if !cond {
        t.Error("expected true: " + msg)
        return false
    }
    return true
}

// False reports an error with msg if cond holds.
func False(t *T, cond bool, msg string) bool {
    if cond {
        t.Error("expected false: " + msg)
        return false
    }
    return true
}

// Reports an error unless p is nil.
func Nil<V>(t *T, p *V) bool {
    if p != nil {
        t.Error("expected nil")
        return false
    }
    return true
}

// NotNil reports an error if p is nil.
func NotNil<V>(t *T, p *V) bool {
    if p == nil {
        t.Error("expected a non-nil value")
        return false
    }
    return true
}

// Reports an error if err is nil.
func Error(t *T, err error) bool {
    if err == nil {
        t.Error("expected an error, got nil")
        return false
    }
    return true
}

// Reports an error unless err is nil.
func NoError(t *T, err error) bool {
    if err != nil {
        t.Error("unexpected error: " + err.Message())
        return false
    }
    return true
}

// t.MustFail(x) (lowered by the compiler, sema/testing.rs): the error of
// r; if r succeeded, logs `at: expected an error` and ends the test.
func mustFail<V>(t *T, r V!, at string) error {
    try r catch err {
        return err
    }
    t.Fatal(at + ": expected an error")
    return nil
}

// Reports an error unless errors.Is(err, target).
func ErrorIs(t *T, err error, target error) bool {
    if !errors.Is(err, target) {
        var got = "nil"
        if err != nil {
            got = strconv.Quote(err.Message())
        }
        t.Error("error " + got + " is not " + strconv.Quote(target.Message()))
        return false
    }
    return true
}

// Exit code of a probe child whose fn returned without panicking.
func noPanicCode() int {
    return 77
}

// Reports an error unless fn panics. fn runs on an OS thread of its own
// inside a panic capture scope (runtime/ABI.md 8): a panic there ends that
// thread only, without running defers or destructors of fn's frames (what
// they own is leaked, locks they hold stay held), and Panics returns true;
// the code of the test runs once. A panic on another thread (a task fn
// started) still ends the test. Where the runtime cannot capture panics
// (Windows), the test binary runs the current test again in a child
// process (`--run-one` with a probe of this call) up to this call, where
// the child calls fn and exits with the panic's status.
func Panics(t *T, fn func()) bool {
    t.panicsSeen += 1
    // ZELL_TEST_PANICS=process forces the child-process fallback.
    if t.probeName == "" && os.Getenv("ZELL_TEST_PANICS") != "process" {
        var r = rtCapture(fn)
        if r == 1 {
            return true
        }
        if r == 0 {
            t.Error("expected a panic, but the function returned")
            return false
        }
    }
    return panicsInChild(t, fn)
}

// Like Panics, and the panic message must contain want.
func PanicsWith(t *T, fn func(), want string) bool {
    if !Panics(t, fn) {
        return false
    }
    var msg = rtCaptureMessage()
    if msg != "" && !strings.Contains(msg, want) {
        t.Error("panic message " + strconv.Quote(msg) + " does not contain " + strconv.Quote(want))
        return false
    }
    return true
}

// The message of the last panic Panics caught on this thread ("" when it
// ran the function in a child process).
func PanicMessage() string {
    return rtCaptureMessage()
}

// testing.Panics where panics cannot be captured: re-runs the test in a
// child process up to the call.
func panicsInChild(t *T, fn func()) bool {
    var k = t.panicsSeen
    if t.probeName != "" {
        if t.probeName == t.name && t.probe == k {
            fn()
            os.Exit(noPanicCode())
        }
        return true
    }
    var top = t.name
    var slash = strings.Index(top, "/")
    if slash >= 0 {
        top = top[..slash]
    }
    var args = ["--run-one", top, "--probe-name", t.name, "--probe", strconv.Itoa(k)]
    var opts = process.Options{Stdin: 2, Stdout: 2, Stderr: 2}
    var p = try process.Start(os.Args()[0], args, opts) catch err {
        t.Error("testing.Panics: cannot start the probe process: " + err.Message())
        return false
    }
    var code = -1
    for code < 0 {
        code = try process.rtWaitPid(p.Pid()) catch err {
            t.Error("testing.Panics: " + err.Message())
            return false
        }
        if code < 0 {
            time.Sleep(1)
        }
    }
    if code == 2 {
        return true
    }
    if code == noPanicCode() {
        t.Error("expected a panic, but the function returned")
    } else {
        t.Error(
            "testing.Panics: the probe run of " +
                top +
                " ended with exit status " +
                strconv.Itoa(code) +
                " before calling the function",
        )
    }
    return false
}

// Reports an error unless s contains sub.
func Contains(t *T, s string, sub string) bool {
    if !strings.Contains(s, sub) {
        t.Error(strconv.Quote(s) + " does not contain " + strconv.Quote(sub))
        return false
    }
    return true
}

// ---- runner -----------------------------------------------------------------------

struct options {
    filter    string
    json      bool
    bench     bool
    verbose   bool
    runOne    string
    benchOne  string
    benchMs   int
    parallel  int
    noTime    bool
    probeName string
    probe     int
    inProcess bool
}

func parseArgs(args []string) options {
    var o = options{benchMs: 1000, parallel: 4}
    var i = 1
    for i < len(args) {
        var a = args[i]
        i += 1
        if a == "--json" {
            o.json = true
        } else if a == "--bench" {
            o.bench = true
        } else if a == "-v" || a == "--verbose" {
            o.verbose = true
        } else if a == "--no-time" {
            o.noTime = true
        } else if a == "--in-process" {
            o.inProcess = true
        } else if (a == "--filter" ||
            a == "--run-one" ||
            a == "--bench-one" ||
            a == "--benchtime" ||
            a == "--parallel" ||
            a == "--probe-name" ||
            a == "--probe") &&
            i < len(args) {
            var v = args[i]
            i += 1
            if a == "--probe-name" {
                o.probeName = v
            } else if a == "--probe" {
                o.probe = try strconv.Atoi(v) else 0
            } else if a == "--filter" {
                o.filter = v
            } else if a == "--run-one" {
                o.runOne = v
            } else if a == "--bench-one" {
                o.benchOne = v
            } else if a == "--benchtime" {
                o.benchMs = try strconv.Atoi(v) else 1000
            } else {
                o.parallel = try strconv.Atoi(v) else 1
            }
        }
    }
    return o
}

// The filter: alternatives separated by "|", each a substring, with
// optional ^ (prefix) and $ (suffix) anchors.
func matches(filter string, name string) bool {
    if filter == "" {
        return true
    }
    for alt in strings.Split(filter, "|") {
        var p = alt
        var pre = strings.HasPrefix(p, "^")
        var suf = strings.HasSuffix(p, "$")
        if pre {
            p = p[1..]
        }
        if suf {
            p = p[..len(p) - 1]
        }
        if pre && suf {
            if name == p {
                return true
            }
        } else if pre {
            if strings.HasPrefix(name, p) {
                return true
            }
        } else if suf {
            if strings.HasSuffix(name, p) {
                return true
            }
        } else if strings.Contains(name, p) {
            return true
        }
    }
    return false
}

async func runChild(c Case, o options) int {
    if !isTest(c) {
        io.Eprintln("testing: " + c.Name + " is not a test")
        return 1
    }
    var t = new T{
        name: c.Name,
        verbose: o.verbose,
        noTime: o.noTime,
        probeName: o.probeName,
        probe: o.probe,
    }
    await runCase(c, t)
    if t.failed {
        return 1
    }
    if t.skipped {
        return 3
    }
    return 0
}

func benchChild(c Case, o options) int {
    var fn = c.Bench
    var n = 1
    var target = o.benchMs * 1000000
    for {
        var b = new B{N: n, name: c.Name}
        b.ResetTimer()
        b.running = true
        fn(b)
        b.StopTimer()
        if b.failed {
            return 1
        }
        var ns = b.elapsed.Nanoseconds()
        if ns >= target || n >= 1000000000 {
            var perOp = ns / n
            var frac = ""
            if perOp < 100 {
                // two decimals for fast operations
                var hundredths = (ns * 100 / n) % 100
                frac = "." + strings.PadLeft(strconv.Itoa(hundredths), 2, "0")
            }
            io.println(
                "BENCH " +
                    strconv.Itoa(n) +
                    " " +
                    strconv.Itoa(perOp) +
                    frac +
                    " " +
                    strconv.Itoa(b.allocs / n),
            )
            return 0
        }
        // predict the N that reaches the target, grow at most 100x
        var next = n * 100
        if ns > 0 {
            var predicted = target / (ns / n + 1) * 6 / 5
            if predicted < next {
                next = predicted
            }
        }
        if next <= n {
            next = n + 1
        }
        n = next
    }
}

func jsonEvent(action string, test string, elapsed float, output string) string {
    var s = "{\"Action\":\"" + action + "\""
    if test != "" {
        s += ",\"Test\":" + encoding.json.Quote(test)
    }
    if action == "output" {
        s += ",\"Output\":" + encoding.json.Quote(output)
    }
    if action == "pass" || action == "fail" || action == "skip" {
        s += ",\"Elapsed\":" + strconv.FormatFloat(elapsed, 'f', 3)
    }
    return s + "}"
}

struct outcome {
    name    string
    code    int
    output  string
    elapsed time.Duration
}

async func runOne(self string, c Case, o options) outcome {
    var start = time.NowInstant()
    var args = ["--run-one", c.Name]
    if o.verbose {
        args = append(args, "-v")
    }
    if o.noTime {
        args = append(args, "--no-time")
    }
    var r = try await process.Run(self, args) catch err {
        return outcome{
            name: c.Name,
            code: 1,
            output: "    cannot run the test binary: " + err.Message() + "\n",
            elapsed: start.Elapsed(),
        }
    }
    return outcome{
        name: c.Name,
        code: r.ExitCode,
        output: r.Stdout + r.Stderr,
        elapsed: start.Elapsed(),
    }
}

// One test in a task of its own (the first await suspends, so the rest
// runs in this function's task, ABI.md 10.3): a panic, also the one
// FailNow and Skip raise in-process, ends only this test.
async func caseTask(c Case, t *T) void! {
    await task.Yield()
    await runCase(c, t)
}

// Runs the function of test case c; an error from a `void!` test fails it.
async func runCase(c Case, t *T) {
    if c.RunAsync != nil {
        var arun = c.RunAsync
        await arun(t)
    } else if c.Run != nil {
        var run = c.Run
        run(t)
    } else if c.RunAsyncErr != nil {
        var arun = c.RunAsyncErr
        try await arun(t) catch err {
            t.failWith("error: ", err)
        }
    } else if c.RunErr != nil {
        var run = c.RunErr
        try run(t) catch err {
            t.failWith("error: ", err)
        }
    } else if c.PlainAsyncErr != nil {
        var arun = c.PlainAsyncErr
        try await arun() catch err {
            t.failWith("error: ", err)
        }
    } else {
        var run = c.PlainErr
        try run() catch err {
            t.failWith("error: ", err)
        }
    }
}

// --in-process (`zell test --debug`): every selected test, one after the
// other, in this process (so one debug agent sees them all); a panic ends
// only its test. Output is not captured: it streams as the tests run.
async func runInProcess(tests []Case, o options) int {
    var start = time.NowInstant()
    var passed = 0
    var failed = 0
    var skipped = 0
    for c in tests {
        var t = new T{name: c.Name, verbose: o.verbose, noTime: o.noTime, inProcess: true}
        if o.json {
            io.println(jsonEvent("run", c.Name, 0.0, ""))
        } else {
            io.println("=== RUN   " + c.Name)
        }
        var t0 = time.NowInstant()
        try await caseTask(c, t) catch err {
            if !t.ended {
                t.failed = true
                io.println(t.indent() + "panic: " + task.PanicMessage(err))
            }
        }
        var status = "PASS"
        if t.failed {
            status = "FAIL"
            failed += 1
        } else if t.skipped {
            status = "SKIP"
            skipped += 1
        } else {
            passed += 1
        }
        if o.json {
            io.println(jsonEvent(strings.ToLower(status), c.Name, t0.Elapsed().Seconds(), ""))
        } else {
            io.println("--- " + status + ": " + c.Name + timeText(t0.Elapsed(), o.noTime))
        }
    }
    var summary = strconv.Itoa(passed) +
        " passed, " +
        strconv.Itoa(failed) +
        " failed, " +
        strconv.Itoa(skipped) +
        " skipped"
    if o.json {
        var act = "pass"
        if failed > 0 {
            act = "fail"
        }
        io.println(jsonEvent(act, "", start.Elapsed().Seconds(), ""))
    } else if failed > 0 {
        io.println("FAIL")
        io.println("FAIL\t" + summary + timeText(start.Elapsed(), o.noTime))
    } else {
        io.println("PASS")
        io.println("ok  \t" + summary + timeText(start.Elapsed(), o.noTime))
    }
    if failed > 0 {
        return 1
    }
    return 0
}

// Runs the cases (the entry point of the driver `zell test` generates);
// returns the exit code: 0 when everything passed, 1 otherwise.
async func Main(cases []Case) int {
    var args = os.Args()
    var o = parseArgs(args)
    if o.runOne != "" {
        for c in cases {
            if c.Name == o.runOne {
                return await runChild(c, o)
            }
        }
        io.Eprintln("testing: no test " + o.runOne)
        return 1
    }
    if o.benchOne != "" {
        for c in cases {
            if c.Name == o.benchOne && c.Bench != nil {
                return benchChild(c, o)
            }
        }
        io.Eprintln("testing: no benchmark " + o.benchOne)
        return 1
    }
    var self = args[0]
    var start = time.NowInstant()
    var passed = 0
    var failed = 0
    var skipped = 0
    var tests []Case = []
    var parallel []Case = []
    var benches []Case = []
    for c in cases {
        if !matches(o.filter, c.Name) {
            continue
        }
        var test = isTest(c)
        if test && !c.Parallel {
            tests = append(tests, c)
        } else if test {
            parallel = append(parallel, c)
        } else if c.Bench != nil {
            benches = append(benches, c)
        }
    }
    // the sequential tests one at a time, then the parallel ones in
    // batches of up to o.parallel
    var nseq = len(tests)
    for c in parallel {
        tests = append(tests, c)
    }
    if o.inProcess {
        return await runInProcess(tests, o)
    }
    var i = 0
    for i < len(tests) {
        var width = 1
        if i >= nseq && o.parallel > 1 {
            width = o.parallel
        }
        var batch []Task<outcome> = []
        var j = i
        for j < len(tests) && j - i < width {
            batch = append(batch, runOne(self, tests[j], o))
            j += 1
        }
        for task in batch {
            var r = await task
            var status = "PASS"
            var action = "pass"
            if r.code == 0 {
                passed += 1
            } else if r.code == 3 {
                status = "SKIP"
                action = "skip"
                skipped += 1
            } else {
                status = "FAIL"
                action = "fail"
                failed += 1
                if r.code != 1 {
                    r.output += "    (exit status " + strconv.Itoa(r.code) + ")\n"
                }
            }
            if o.json {
                io.println(jsonEvent("run", r.name, 0.0, ""))
                if r.output != "" {
                    io.println(jsonEvent("output", r.name, 0.0, r.output))
                }
                io.println(jsonEvent(action, r.name, r.elapsed.Seconds(), ""))
            } else if o.verbose || status == "FAIL" {
                if o.verbose {
                    io.println("=== RUN   " + r.name)
                }
                io.print(r.output)
                io.println("--- " + status + ": " + r.name + timeText(r.elapsed, o.noTime))
            }
        }
        i = j
    }
    if o.bench {
        for c in benches {
            var args2 = ["--bench-one", c.Name, "--benchtime", strconv.Itoa(o.benchMs)]
            var r = try await process.Run(self, args2) catch err {
                io.println("--- FAIL: " + c.Name + ": " + err.Message())
                failed += 1
                continue
            }
            var lines = strings.Split(strings.Trim(r.Stdout), "\n")
            var last = lines[len(lines) - 1]
            if r.ExitCode != 0 || !strings.HasPrefix(last, "BENCH ") {
                failed += 1
                io.print(r.Stdout + r.Stderr)
                io.println("--- FAIL: " + c.Name)
                continue
            }
            var f = strings.Fields(last)
            if o.json {
                io.println(
                    "{\"Action\":\"bench\",\"Test\":" +
                        encoding.json.Quote(c.Name) +
                        ",\"N\":" +
                        f[1] +
                        ",\"NsPerOp\":" +
                        f[2] +
                        ",\"AllocsPerOp\":" +
                        f[3] +
                        "}",
                )
            } else {
                io.println(
                    strings.PadRight(c.Name, 24, " ") +
                        " " +
                        strings.PadLeft(f[1], 10, " ") +
                        " " +
                        strings.PadLeft(f[2], 12, " ") +
                        " ns/op " +
                        strings.PadLeft(f[3], 8, " ") +
                        " allocs/op",
                )
            }
        }
    }
    var summary = strconv.Itoa(passed) +
        " passed, " +
        strconv.Itoa(failed) +
        " failed, " +
        strconv.Itoa(skipped) +
        " skipped"
    if o.json {
        var act = "pass"
        if failed > 0 {
            act = "fail"
        }
        io.println(jsonEvent(act, "", start.Elapsed().Seconds(), ""))
    } else if failed > 0 {
        io.println("FAIL")
        io.println("FAIL\t" + summary + timeText(start.Elapsed(), o.noTime))
    } else {
        io.println("PASS")
        io.println("ok  \t" + summary + timeText(start.Elapsed(), o.noTime))
    }
    if failed > 0 {
        return 1
    }
    return 0
}
